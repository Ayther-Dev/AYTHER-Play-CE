// ---------------------------------------------------------------------------
// appwindow.slint — la interfaz de AYTHER Play CE
// TRES secciones: 0 Inicio · 1 Biblioteca · 2 Ajustes.
// La edición propietaria agrega tres secciones dependientes de servicios entre
// Biblioteca y Ajustes. Acá no están: son dos componentes distintos (ADR-005)
// y en éste no hay ningún servicio del otro lado. Una pestaña apagada para
// siempre manda a buscar cómo encenderla.
// ---------------------------------------------------------------------------

import { ListView, ProgressIndicator } from "std-widgets.slint";
import { Tokens } from "tokens.slint";   // GENERADO desde docs/design/play-ce.pen
import { Icons }  from "icons.slint";    // GENERADO desde docs/design/play-ce.pen

/// Una fila del diálogo de controles del juego: la acción y lo vigente.
export struct ControlRow {
    action: string,
    key:  string,
    /// «—» en las direcciones: la cruceta no se remapea y la fila lo dice
    /// apagando la columna, no fallando al apretar X.
    button:  string,
    no-button: bool,
}

// una versión guardada, tal como la ve la lista de «03d · Guardados».
export struct SaveRow {
    when:  string,
    /// Revisión de ROM y tamaño: lo que distingue dos guardados de la misma
    /// tarde. Sin esto, tres filas con la misma fecha son tres filas iguales.
    detail: string,
}

export struct GameEntry {
    name:        string,
    path:        string,
    // La ruta del PACK, resuelta por la biblioteca (.ay actual, .ae legacy).
    // Va en el modelo y no se re-deriva en el callback: derivarla otra vez es
    // como se coló el bug de la extension fija.
    pack-path:   string,
    platform:    string,
    crc32:       string,
    region:      string,
    has-pack:    bool,
    pack-status: int,
    cover:       image,
    // en qué está el core de esta plataforma. La tarjeta lo necesita
    // para apagarse y decirlo ANTES de que el jugador apriete A y falle.
    // Es un ENTERO y no un `bool`: «no hay core», «lo comprobé y no
    // sirve» y «todavía no lo comprobé» son tres cosas distintas y sólo las dos
    // primeras impiden jugar. Lo calcula `cores::estado` a partir del SONDEO del
    // core —no de la mera existencia del archivo—, por lo
    // que un core de 32 bits daba «Compatible»—. La UI no lo interpreta: le
    // pregunta a `Semaforo.core-bloquea`.
    core-state: int,
    // lo que decidió el jugador.
    favorite:    bool,
    hidden:      bool,
    edited:     bool,
    /// por qué el pack tiene ese grado, en palabras del validador.
    compat-reason: string,
}

// una fila de la pantalla de configuracion previa.
// La pantalla es una LISTA de filas y no un formulario con casillas y
// sliders sueltos. La razon es el mando: en un formulario cada control toma
// botones distintos y el jugador tiene que saber cual es cual antes de
// tocarlo. Una lista uniforme —arriba/abajo mueve, izquierda/derecha
// cambia— se maneja sin mirar, que es como se usa un launcher desde el
// sillon.
export struct ConfigRowData {
    label:     string,
    value:     string,
    // El pack no lo trae. Se muestra igual, apagada: una fila que
    // desaparece se lee como «esta version no lo tiene»; una gris dice
    // «este pack no lo trae», que es la verdad.
    available: bool,
}

// una linea de la pantalla de CREDITOS. Los datos salen del
// `credits.toml` del pack: reconocer al autor no puede depender de estar
// conectado a un servicio.
export struct CreditLineData {
    author:       string,
    role:         string,
    contribution: string,
    licenses:     string,
}

// una dimensión del formulario de opinión. Son siete y fijas: «me gustó»
// no le dice al autor qué mejorar, y «el balance música/efectos está bajo» sí.
export struct FeedbackRowData {
    label: string,
    value: int,        // 0 = sin contestar · 1..5
}

// una fila de la ficha del pack. `level` separa lo DECLARADO de lo
// COMPROBADO y de los avisos, que es la distinción que la pantalla existe para
// no borrar: "" = dato · "error" · "advertencia" · "sugerencia" · "ok".
export struct DetailRow {
    label: string,
    value: string,
    level: string,
}

// una fila del wizard de primer arranque.
// Una sola forma para las cuatro listas que tiene el wizard —opciones, carpetas,
// resumen, explorador— porque con el mando las cuatro se manejan igual:
// arriba/abajo mueve, A actua. Un struct por lista tentaria a que cada una
// desarrollara su propia gramatica de botones; compartir el tipo evita esa
// divergencia.
export struct OnboardingRow {
    title:  string,
    detail: string,
    /// una fila de CARPETA en el explorador. Antes la carpeta se marcaba
    /// con una barra final en el nombre porque no había fuente de íconos; con
    /// Phosphor vendorizada la dice el `folder` y el nombre queda limpio.
    folder: bool,
}

// ---------------------------------------------------------------------------
// Colour palette
// ---------------------------------------------------------------------------
global GamePalette {
    pure public function platform-bg(platform: string) -> color {
        if platform == "Mega Drive" { return #162030; }
        if platform == "SNES"       { return #1e1630; }
        if platform == "NES"        { return #301618; }
        if platform == "GBA"        { return #162018; }
        if platform == "N64"        { return #201c16; }
        return #161820;
    }
    pure public function platform-fg(platform: string) -> color {
        if platform == "Mega Drive" { return #3a78b0; }
        if platform == "SNES"       { return #7850c0; }
        if platform == "NES"        { return #b03040; }
        if platform == "GBA"        { return #40a060; }
        if platform == "N64"        { return #c09030; }
        return #608098;
    }
    pure public function platform-abbr(platform: string) -> string {
        if platform == "Mega Drive"    { return "MD"; }
        if platform == "SNES"          { return "SN"; }
        if platform == "NES"           { return "NE"; }
        if platform == "GBA"           { return "GB"; }
        if platform == "N64"           { return "64"; }
        if platform == "Master System" { return "MS"; }
        return "??";
    }
    /// La carátula por defecto de la consola, para el juego que no tiene una.
    /// Va EMBEBIDA en el binario (`@image-url` la resuelve en el build) y no
    /// leída de una carpeta: un archivo suelto que hay que instalar al lado del
    /// ejecutable es un archivo que falta, y lo que falta acá deja a media
    /// biblioteca con un cuadro vacío.
    /// **Sólo se llama si `tiene-caratula` dijo que sí.** El `return` del final
    /// existe porque Slint exige que la función devuelva algo por todos los
    /// caminos, no porque haya un caso que llegue ahí — y hay un oráculo que
    /// compara las dos listas, porque una lista que se cae de sincronía con la
    /// otra pinta la carátula de una consola sobre el juego de otra.
    pure public function cover-art(platform: string) -> image {
        if platform == "Master System" { return @image-url("../resources/covers/master_system.png"); }
        return @image-url("../resources/covers/mega_drive.png");
    }
    /// Si esta consola trae carátula por defecto. Las que no, siguen mostrando
    /// su sigla: inventarles la carátula de otra consola sería peor que un
    /// marcador honesto.
    pure public function has-cover(platform: string) -> bool {
        return platform == "Mega Drive" || platform == "Master System";
    }
    pure public function pack-color(status: int) -> color {
        if status == 1 { return Tokens.success; }
        if status == 2 { return Tokens.warning; }
        if status == 3 { return Tokens.danger; }
        return Tokens.bg-elevated;
    }
}

// ---------------------------------------------------------------------------
// Radio de píldora
// ---------------------------------------------------------------------------
// `Tokens.radius-pill` es 999px: el valor con el que el diseño DICE «píldora»,
// no un radio dibujable. Puesto crudo en `border-radius`, femtovg lo recorta
// POR EJE (`rad.min(w/2)` para rx y `rad.min(h/2)` para ry), así que un chip
// de 120×40 sale con rx=60 y ry=20: una ELIPSE exacta — que es como se veían
// los chips de la FilterBar, las barras de progreso y el glifo `Start`.
// El radio de una píldora es la mitad del lado CORTO, y eso depende de la
// geometría de cada elemento: no puede vivir en el token (que además se genera
// desde play-ce.pen y no admite funciones escritas a mano).
global Shape {
    pure public function pill(w: length, h: length) -> length {
        return min(w, h) / 2;
    }
}

// ---------------------------------------------------------------------------
// Un icono
// ---------------------------------------------------------------------------
// TODA la iconografía de Play es Phosphor: el `.pen` declara cada icono con su
// nombre y su librería, `fonts/Phosphor.ttf` los dibuja y `icons.slint` —
// generado— traduce nombre a codepoint. Este componente es el único lugar donde
// se nombra la familia, así que un icono no se puede dibujar «casi bien»:
// o sale de `Icons.*`, o no sale.
// El tamaño es el del diseño (24 px la mayoría, 28 los de cabecera, 32 los de
// alerta) y va en `medida` porque en una fuente de iconos el CUERPO es el
// tamaño del dibujo: un icono de 24 se pide con font-size 24, no con un ancho.
component Icon inherits Text {
    in property <length> size: 24px;
    font-family: Tokens.font-icon;
    font-size: size;
    width: size;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// Las dos barras del chasis, en un solo lugar. Las necesitan las barras que las
// dibujan y los VELOS de los modales, que cubren el cuerpo y sólo el cuerpo: con
// los números copiados, mover una barra deja los velos tapando de más o de menos.
export global Shell {
    out property <length> topbar: 96px;
    out property <length> footer:    72px;
}

// ¿Hay un mando enchufado? Lo escribe Rust: el hilo de gilrs avisa al arrancar
// y en cada enchufe o desenchufe, así que el pie cambia EN CALIENTE.
// Cuando NO lo hay, las píldoras del pie muestran la TECLA equivalente en vez
// de un botón que no existe en el escritorio: la gramática es la misma que ya
// enseñan los `FocusScope` —Enter es A, Esc es B, X e Y son sus letras,
// Re Pág/Av Pág son los hombros— y dibujarla es lo que hace usable el launcher
// sin mando, sin inventar una segunda gramática que haya que aprender.
export global Gamepad {
    in-out property <bool> connected: false;
    /// La etiqueta de la píldora para la tecla `tecla` del pad. Con mando, el
    /// botón tal cual; sin mando, su tecla del teclado.
    /// **La barra espaciadora es A y Retroceso es B** — las dos teclas
    /// grandes, para las dos acciones de siempre. Enter queda para Start, y
    /// con eso A y Start ya no comparten tecla en ninguna pantalla: en la
    /// previa, Espacio cambia la fila y Enter juega, que es exactamente lo que
    /// hacen A y Start en el mando. Esc y Enter siguen funcionando como
    /// sinónimos donde ya funcionaban: esto dice qué se DIBUJA, no qué se
    /// deja de aceptar.
    pure public function glyph(key: string) -> string {
        if (self.connected || key == "") { return key; }
        return key == "A"     ? @tr("Espacio")
             : key == "B"     ? @tr("Retroceso")
             : key == "Start" ? @tr("Enter")
             : key == "LB"    ? @tr("Re Pág")
             : key == "RB"    ? @tr("Av Pág")
             : key;   // X e Y son sus propias letras
    }
}

// El velo de un modal.
// Cubre el CUERPO —de la TopBar al pie— y no la ventana entera: las dos barras
// siguen valiendo mientras el diálogo está abierto (la de arriba dice dónde
// estás y la de abajo con qué salís), y taparlas es lo que hacía que un diálogo
// se leyera como otra aplicación. Y traga los clics: un modal que deja tocar lo
// de atrás es la clase de cosa que se descubre borrando el juego equivocado.
// Más oscuro que `modal-dim` a secas: el velo tiene que APAGAR lo de atrás, no
// teñirlo. El token sigue siendo el del diseño; lo que sube es la opacidad.
// La geometría la pone quien lo usa —`parent` no existe dentro de un
// componente—, y es siempre la misma: `y: Chasis.topbar` y el alto de la ventana
// menos las dos barras.
component Scrim inherits Rectangle {
    background: Tokens.modal-dim.with-alpha(0.92);
    // el velo NO es un control: su `TouchArea` existe para COMERSE los
    // clics de lo que tapa. Anunciarlo sería ofrecerle a un lector de pantalla
    // un botón que no hace nada, que es peor que el silencio. `none` es la
    // respuesta correcta y está escrita para que no se lea como un olvido.
    accessible-role: none;
    TouchArea { }
    @children
}

// Centra verticalmente a su hijo dentro de una fila.
// Un layout de Slint NO centra en el eje corto a un hijo de alto FIJO: lo deja
// pegado al principio. En una barra donde conviven un campo de 48, chips de 40
// y botones de 40, eso se ve como controles a tres alturas distintas —y no hay
// una propiedad que lo arregle: el idioma es envolver, que es lo que ya hacen
// el pie de botones y la TopBar.
component Centered inherits VerticalLayout {
    alignment: center;
    @children
}

// El isologotipo, DIBUJADO. Es el mismo trazado que el `Logo` del .pen (su
// viewBox es de 1024) y no el `.png` de `resources/`: ése trae su propia
// baldosa oscura —es lo que Windows necesita para el icono del `.exe`— y sobre
// un fondo de pantalla se le ve el recuadro.
component Logo inherits Path {
    in property <length> size: 40px;
    width: size;
    height: size;
    viewbox-width: 1024;
    viewbox-height: 1024;
    fill: Tokens.brand;
    commands: "M761.56 111l-160 0 42.88 160-42.88 160-149.43 0 42.87-160 63.56 0 42.88-160-160 0-42.88 160-63.56 0-171.49 640 160 0 85.75-320 242.2 0 42.87-160 67.23 0 42.88-160-42.88-160z";
}

// ---------------------------------------------------------------------------
// El pie de botones (ButtonHints del .pen)
// ---------------------------------------------------------------------------
// un hint es un PAR: el botón del mando dibujado y lo que hace. Antes
// era una FRASE por pantalla —«↑↓ Elegir   A Jugar   Y Buscar   Start Menú»—,
// con las letras de los botones adentro del texto traducido: el traductor
// arrastraba «A» y «Start» a otro idioma, y a tres metros esa línea es un
// renglón gris donde no se distingue qué es botón y qué es palabra.
// SIN FLECHAS. Moverse con el stick o la cruceta es la gramática del chasis y
// el pie del diseño no la enumera en ninguna de sus pantallas. Lo que el pie
// anuncia es lo que NO se adivina; cuando la dirección sí es la acción —puntuar
// la encuesta, elegir en el conflicto— el hint lleva el ícono `arrows-left-right`
// en vez de una letra.
export struct PadHint {
    /// Lo que dice la píldora: A, B, X, Y, Start, LB, RB.
    key: string,
    /// O un glifo de `Icons.*`, cuando lo que se aprieta no es un botón con
    /// nombre. Manda sobre `tecla` si está.
    icon: string,
    label: string,
    /// La tecla del teclado que se dibuja SIN mando, cuando la general de
    /// `Mando.glifo` mentiría. Vacía = la general. La usa la pantalla previa:
    /// ahí A cambia y Start juega, y con las dos cayendo a «Enter» el pie
    /// prometería jugar con la tecla que cambia una opción.
    keyboard-key: string,
}

// PadGlyph del .pen: píldora CLARA con la letra oscura. En negativo es como se
// lee a tres metros. El ancho sale de la etiqueta —«Start» no entra en 32— y el
// alto es fijo: son todos el mismo botón.
component PadGlyph inherits Rectangle {
    in property <string> key;
    in property <string> icon;
    /// Ver `PadHint.keyboard-key`.
    in property <string> keyboard-key;
    height: 32px;
    width: max(32px, label-text.width + 20px);
    border-radius: Shape.pill(self.width, self.height);
    background: Tokens.text-bright;
    label-text := Text {
        text: icon != "" ? icon
            : !Gamepad.connected && keyboard-key != "" ? keyboard-key
            : Gamepad.glyph(key);
        color: Tokens.accent-fg;
        font-family: icon != "" ? Tokens.font-icon : Tokens.font-ui;
        font-size: Tokens.text-body-sm;
        font-weight: 700;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Un hint. Es clickeable: el wizard y los diálogos se pueden usar con mouse, y
// desde  el pie es el único lugar donde están sus salidas.
component Hint inherits Rectangle {
    in property <string> key;
    in property <string> icon;
    in property <string> label;
    in property <string> keyboard-key;
    callback clicked();
    // el pie de botones ES accionable con el mouse, así que se anuncia
    // como lo que hace y no como la tecla que lo dibuja: «B · Atrás», no «B».
    // La tecla va igual, porque para quien SÍ ve el mando es la mitad del dato.
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.key;
    accessible-action-default => { root.clicked(); }

    width: row.preferred-width;
    touch-area := TouchArea { clicked => { root.clicked(); } }
    row := HorizontalLayout {
        spacing: 12px;
        // La píldora, CENTRADA en el alto de la barra. Va envuelta porque un
        // layout no centra a un hijo de alto fijo: lo deja arriba, y la píldora
        // quedaba flotando por encima de su propia etiqueta.
        VerticalLayout {
            alignment: center;
            PadGlyph { key: root.key; icon: root.icon; keyboard-key: root.keyboard-key; }
        }
        Text {
            text: root.label;
            color: touch-area.has-hover ? Tokens.text-bright : Tokens.text-normal;
            font-family: Tokens.font-ui; font-size: Tokens.text-body;
            vertical-alignment: center;
        }
    }
}

// La barra: lo que PASA a la izquierda, lo que se puede HACER a la derecha.
component ButtonHints inherits Rectangle {
    in property <string> note;
    in property <[PadHint]> hints;
    callback pressed(string);

    height: 72px;
    background: Tokens.bg-panel;
    Rectangle { y: 0; height: 1px; width: parent.width; background: Tokens.border; }
    HorizontalLayout {
        // La misma safe area que la TopBar: en un televisor lo primero que se
        // corta es lo pegado al margen.
        padding-left: 96px; padding-right: 96px; spacing: 40px;
        alignment: space-between;
        Text {
            text: root.note;
            color: Tokens.text-dim;
            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
            vertical-alignment: center; overflow: elide;
        }
        HorizontalLayout {
            spacing: 40px; alignment: end;
            for h in root.hints: Hint {
                key: h.key; icon: h.icon; label: h.label; keyboard-key: h.keyboard-key;
                clicked => { root.pressed(h.key); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Library list row (M5b, unchanged)
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// La grilla de carátulas (play-ce.pen, «02 · Biblioteca» y «02e · Vista
// lista»). Medidas, colores y estados salen del diseño.
// LOS ÍCONOS SON PHOSPHOR, como manda el .pen. Hasta  no lo eran: Play no
// vendorizaba fuente de íconos —`play/fonts/` tenía Khand e IBM Plex y nada más
//y cada icono se dibujaba con el carácter Unicode más parecido que la
// cmap mapeara (`✓` por `check-circle`, `!` por `warning`, `↻` por
// `magnifying-glass`) o se reemplazaba por palabras cuando no había ninguno.
// Ahora la fuente está vendorizada y los glifos salen de `Icons.*`, generado
// desde el mismo `.pen` que nombra los íconos.
// EL SEMÁFORO SIGUE DISTINGUIENDO POR ÍCONO + PALABRA + COLOR, los tres a la
// vez: es el requisito de accesibilidad (§10) y no una consecuencia de que
// faltara el glifo.
// ---------------------------------------------------------------------------

/// EL TOOLTIP DE UN BADGE NO LO DIBUJA EL BADGE.
/// Slint pinta en orden de árbol y no tiene z-order: un hijo del badge queda
/// debajo de todo hermano posterior. En la ficha eso se veía de una: el
/// tooltip de la fila «ROM» salía hacia abajo y lo tapaba la fila «Core», que se
/// dibuja después. En la grilla pasaba lo mismo con la tarjeta de al lado.
/// Un `PopupWindow` —que sí se dibuja arriba de todo— NO sirve para un tooltip
/// de hover: mientras hay uno abierto, el puntero fuera de su rectángulo deja de
/// llegar a los items de abajo (`send_exit_events` de `i-slint-core`), así que el
/// badge pierde el hover, el tooltip se cierra, el hover vuelve… y parpadea sin
/// fin.
/// Entonces el badge PUBLICA acá lo que quiere decir y dónde está, y lo pinta
/// `CapaTip`, el último hijo de la ventana —que por ser el último va encima de
/// todo—.
global Tip {
    /// El texto. Vacío = no hay tooltip.
    in-out property <string> reason;
    /// El ancla en coordenadas de la VENTANA: el badge que lo pidió.
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-height;
    /// Quién lo abrió. Dos badges pueden tener el mismo `motivo` —la grilla
    /// repite el mismo motivo en cada tarjeta— y el «me fui» de uno no puede
    /// apagar el tooltip que otro acaba de abrir: cada apertura toma un turno y
    /// sólo el dueño del turno vigente apaga.
    in-out property <int> series;
    in-out property <int> owner;
}

// LA MATRIZ DEL SEMÁFORO VIVE ACÁ Y NO ADENTRO DEL BADGE.
// Son DOS superficies las que la pintan: el `SemaphoreBadge` —la fila de la
// lista y los tres ejes de la ficha— y la `SemaBanda` sobre la carátula de la
// tarjeta. Con la tabla escrita dos veces, el día que se agregue un
// grado o se corrija una palabra la grilla dice «Compatible» donde la ficha
// dice «Con advertencias», sobre el MISMO pack — y la contradicción no falla
// en ningún lado: sólo hace que el semáforo deje de ser creíble.
// Los tres canales son tres a propósito (icono + palabra + color): es el
// requisito de accesibilidad (§10), no una decoración. Quien no distingue
// verde de rojo lee «Compatible» o ve el aspa del `x-circle`.
global StatusLight {
    /// el GRADO del validador del core: 0=sin pack · 1=exacto ·
    /// 2=advertencias · 3=no verificado · 4=incompatible. Espeja
    /// `library::PackStatus`, que a su vez espeja `CompatGrade` — una sola
    /// matriz de cuatro grados en toda la casa.
    /// — el eje del CORE, que ya no es un `bool`: espeja `cores::EjeCore`.
    /// 0=falta · 1=no sirve · 2=todavía no se comprobó · 3=no se pudo comprobar ·
    /// 4=no declara qué corre · 5=sirve.
    /// El core no es un grado: un juego que no puede correr no se corre, diga lo
    /// que diga su pack, así que los dos primeros PISAN al grado en los tres
    /// canales. Los demás no: «todavía no lo comprobé» no puede pintar la
    /// biblioteca de rojo durante el segundo que tarda el sondeo del arranque.
    /// La pregunta se hace UNA vez y acá, y no con un `==` suelto en cada
    /// superficie: el oráculo `la_ui_usa_los_mismos_numeros_que_este_enum` ata
    /// este `<= 1` al enum de Rust, y son las dos únicas listas que existen.
    /// El valor que dice «esta superficie no habla del core». Existe porque un
    /// `int` sin asignar vale 0, y 0 es «Falta el core»: el PEOR default
    /// posible. Los badges que sólo gradúan un pack —la sección PACK de la
    /// ficha, el sondeo del onboarding— no tienen nada que decir del core, y
    /// tienen que poder callarse sin mentir. Fuera del rango
    /// del enum a propósito: no es «sirve», es «no viene al caso».
    out property <int> core-not-applicable: -1;
    pure public function core-blocks(core: int) -> bool {
        core >= 0 && core <= 1
    }
    pure public function tone(state: int, core: int) -> color {
        core-blocks(core) ? Tokens.danger
        : state == 1 ? Tokens.success
        : state == 2 ? Tokens.warning
        : state == 4 ? Tokens.danger
                      : Tokens.text-dim
    }
    pure public function icon(state: int, core: int) -> string {
        core-blocks(core) ? Icons.x-circle
        : state == 1 ? Icons.check-circle
        : state == 2 ? Icons.warning
        : state == 4 ? Icons.x-circle
                      : Icons.question
    }
    /// Las dos palabras del core son DOS y no una: «Falta el core» manda a
    /// elegir uno y «El core no sirve» manda a cambiarlo. El motivo —qué tiene
    /// de malo— lo trae el sondeo y se lee en la ficha.
    pure public function word(state: int, core: int) -> string {
        core == 0 ? @tr("Falta el core")
        : core == 1 ? @tr("El core no sirve")
        : state == 1 ? @tr("Compatible")
        : state == 2 ? @tr("Con advertencias")
        : state == 4 ? @tr("Incompatible")
                      : @tr("No verificado")
    }
}

// El semáforo del pack como BADGE: un chip sobre `bg-elevated`, para la fila de
// la lista y para los tres ejes de la ficha. Sobre la carátula de la tarjeta no
// va éste sino la `SemaBanda`, que no puede apoyarse en un fondo de la paleta
// porque lo que tiene debajo es una imagen cualquiera.
component SemaphoreBadge inherits Rectangle {
    /// el GRADO del validador del core: 0=sin pack · 1=exacto ·
    /// 2=advertencias · 3=no verificado · 4=incompatible. Espeja
    /// `library::PackStatus`, que a su vez espeja `CompatGrade` — una sola
    /// matriz de cuatro grados en toda la casa.
    in property <int> state;
    // en qué está el core, espejando `cores::EjeCore`. Un juego que no
    // puede correr no se corre, sin importar qué diga su pack: pisa al grado y
    // es el motivo por el que la tarjeta se ve apagada.
    // El default CALLA: hay badges que sólo gradúan un pack y no saben del core.
    in property <int> core: StatusLight.core-not-applicable;
    /// POR QUÉ, en palabras del validador. Es lo que hace accionable al
    /// semáforo: «incompatible» no ayuda, «el pack se horneó para otra ROM» sí.
    in property <string> reason;

    // el semáforo NO es interactivo, y aun así tiene que decirse: es el
    // dato que decide si el juego arranca. Con rol `text` y su palabra como
    // etiqueta, un lector de pantalla lo lee igual que alguien que ve el color.
    // Complementa la banda enfocada para que el estado no dependa sólo del tono.
    accessible-role: text;
    accessible-label: StatusLight.word(root.state, root.core);
    accessible-description: root.reason;

    property <color> tone: StatusLight.tone(state, core);

    background: Tokens.bg-elevated;
    border-radius: Tokens.radius-md;
    height: badge-row.preferred-height;
    width:  badge-row.preferred-width;

    // El motivo va en el tooltip y no en la tarjeta: en la grilla no hay lugar
    // para una frase, y el estado de un vistazo ya lo dan el glifo y la palabra.
    // La ficha lo va a mostrar entero.
    // Se PUBLICA en `Tip` y lo pinta `CapaTip`: dibujarlo acá lo dejaba debajo
    // de los hermanos posteriores —ver el comentario de `Tip`—.
    property <int> turn;
    touch-area := TouchArea {
        mouse-cursor: reason == "" ? default : help;
        changed has-hover => {
            if (self.has-hover && root.reason != "") {
                Tip.series = Tip.series + 1;
                root.turn = Tip.series;
                Tip.owner = root.turn;
                Tip.reason = root.reason;
                Tip.anchor-x = root.absolute-position.x;
                Tip.anchor-y = root.absolute-position.y;
                Tip.anchor-height = root.height;
            } else if (Tip.owner == root.turn) {
                Tip.reason = "";
            }
        }
    }

    badge-row := HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        padding-top: 6px;   padding-bottom: 6px;
        spacing: 8px;

        Icon {
            text: StatusLight.icon(state, core);
            color: tone;
        }
        Text {
            text: StatusLight.word(state, core);
            color: tone;
            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
            font-weight: 500; vertical-alignment: center;
        }
    }
}

// EL SEMÁFORO DE LA TARJETA, SOBRE LA CARÁTULA Y SÓLO CON EL FOCO.
// Antes era una fila más de la tarjeta, debajo del título y la consola: 36 px
// de alto que TODA tarjeta pagaba para contestar una pregunta que sólo se hace
// sobre el juego que uno está mirando. Seis por fila, la grilla entera repetía
// «Compatible» en verde y el ojo dejaba de verlo — un semáforo que está siempre
// encendido no informa, decora.
// Ahora aparece sobre la carátula del juego CON FOCO, que es el único del que
// alguien quiere saber si va a correr, y se va con el foco. Es el mismo gesto
// que ya hace el resto del chasis: el detalle acompaña al cursor.
// La banda es negra al 75% y no un color de la paleta porque lo que tiene
// debajo es una carátula CUALQUIERA —un cielo claro, un fondo blanco, un logo
// amarillo—; sobre `bg-elevated` el texto quedaría legible en unas y no en
// otras. El negro traslúcido oscurece lo que haya y deja pasar la imagen, que
// es para lo que existe un scrim. No es un token de marca (no está en el .pen y
// no debe estarlo): es un velo de legibilidad, la misma clase de literal que la
// paleta por plataforma.
component StatusBand inherits Rectangle {
    /// Los mismos dos de `SemaphoreBadge`: el grado del pack y el estado del
    /// core. La tabla es la de `Semaforo`, no una copia.
    in property <int> state;
    in property <int> core: StatusLight.core-not-applicable;

    height: row.preferred-height;
    background: Colors.black.with-alpha(0.75);

    row := HorizontalLayout {
        alignment: start;
        padding-left: 12px; padding-right: 12px;
        padding-top: 8px;   padding-bottom: 8px;
        spacing: 8px;

        Icon {
            text: StatusLight.icon(state, core);
            color: StatusLight.tone(state, core);
        }
        // El texto va en `text-bright` y NO en el tono del estado: el color ya
        // lo pone el ícono, y una frase de color sobre un velo negro pierde el
        // contraste que la banda vino a garantizar —«Con advertencias» en
        // naranja sobre negro es el peor par de los cinco—. Los tres canales
        // siguen estando: ícono, palabra y color.
        Text {
            text: StatusLight.word(state, core);
            color: Tokens.text-bright;
            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
            font-weight: 500; vertical-alignment: center;
            overflow: elide;
        }
    }
}

// La carátula, compartida por la tarjeta y por la fila.
// Sin arte local se cae a un marcador: el fondo de la plataforma y un glifo de
// mando. Que sea el COLOR de la plataforma y no un gris uniforme es lo que hace
// la grilla legible de un vistazo a distancia de TV — un muro de rectángulos
// idénticos no se lee, aunque cada uno tenga su título abajo.
component Cover inherits Rectangle {
    in property <string> platform;
    in property <image>  art;
    in property <bool>   dimmed;

    /// La del jugador, si la puso. `art.width == 0` es «no hay archivo».
    property <bool> own-art: art.width > 0;
    /// Y si no, la de la consola — cuando la consola trae una.
    property <bool> console-art: !own-art && GamePalette.has-cover(platform);

    clip: true;
    background: dimmed ? Tokens.bg-elevated : GamePalette.platform-bg(platform);
    border-width: 1px;
    border-color: Tokens.border-soft;

    // UNA sola `Image` para los dos casos: dos imágenes con las mismas
    // propiedades se separan a la tercera vez que alguien toca una.
    // LA OPACIDAD ES DE ESTA VERSIÓN Y NO UN ADORNO. «Apagada» es «no hay core
    // para esta consola», y hasta ahora ese estado se veía porque la mayoría de
    // las tarjetas no tenía carátula y la sigla se pintaba en gris. Con una
    // carátula por defecto en TODAS, ese aviso se habría perdido justo el día
    // que la biblioteca se ve mejor: la tarjeta de un juego que no puede
    // arrancar quedaría idéntica a la de uno que sí.
    // EL RECORTE VA POR ABAJO, NUNCA POR ARRIBA. `image-fit: cover` centra lo
    // que sobra y se come la banda superior, que es donde vive el logotipo de la
    // consola: la carátula que dice de qué máquina es quedaba cortada al medio,
    // justo en lo único que la hace reconocible de un vistazo.
    // Slint no tiene un «object-position», así que la caja se calcula a mano:
    // se escala para cubrir y se ancla en y=0. Si la proporción hace que sobre
    // a lo ancho en vez de a lo alto —una miniatura muy angosta— entonces sobra
    // por los costados y se recorta parejo, que ahí no tapa nada.
    if own-art || console-art: Image {
        source: own-art ? art : GamePalette.cover-art(platform);
        opacity: dimmed ? 0.35 : 1.0;

        /// Qué alto tendría la imagen si la estiráramos al ancho de la caja.
        property <length> height-to-width:
            parent.width * self.source.height / self.source.width;
        /// Con ese alto ya cubre: entonces manda el ancho y sobra por abajo.
        property <bool> drives-width: self.height-to-width >= parent.height;

        x: self.drives-width ? 0px : (parent.width - self.width) / 2;
        y: 0;
        width:  self.drives-width ? parent.width
                                    : parent.height * self.source.width / self.source.height;
        height: self.drives-width ? self.height-to-width : parent.height;
        // `fill` y no `cover`: la caja YA tiene la proporción de la imagen, así
        // que no hay nada que ajustar — y `cover` volvería a centrar el recorte.
        image-fit: fill;
    }
    // Sin arte de ninguna clase, la SIGLA de la plataforma y no un ícono
    // genérico: reusa `platform-abbr`, que ya existía, y a diferencia de un
    // mando dibujado distingue una consola de otra de un vistazo — que es lo
    // único que un marcador puede aportar.
    // El cuerpo de la sigla sale del ALTO de la carátula, no de un número fijo:
    // la misma `Cover` sirve a la tarjeta (336) y a la fila de la lista (48), y
    // con un tamaño fijo la miniatura recortaba las letras.
    if !own-art && !console-art: Text {
        text: GamePalette.platform-abbr(platform);
        font-family: Tokens.font-display; font-size: parent.height * 0.19;
        color: dimmed ? Tokens.text-dim : GamePalette.platform-fg(platform);
        horizontal-alignment: center; vertical-alignment: center;
        width: parent.width; height: parent.height;
    }
}

// La tarjeta, y el foco como anillo de 3 px + tint — nunca sólo un cambio de
// color de fondo, que a distancia de TV no se ve (§6 10-foot).
// EL ANCHO ES 268 Y NO LOS 240 QUE DECÍA EL .pen. Es la única medida de la
// grilla que se apartó del diseño, y a propósito: seis tarjetas de 240 con sus
// cinco gaps ocupan 1560 de los 1728 útiles del chasis (1920 menos la safe
// area), y esos 168 px sobrantes quedaban como una franja muerta contra el
// borde derecho. Con 268 la fila entra JUSTA —6×268 + 5×24 = 1728—, que es lo
// que el diseño quiere decir con «seis columnas». La carátula crece con ella
// (252 de ancho) y conserva su alto: lo que cambia es cuánto recorta
// `image-fit: cover`, no la maqueta.
// y ésta es la razón por la que acá manda el código y el .pen se corrige:
// es una cuenta que la medida del diseño contradice, no una preferencia. El
// .pen dice 268×428, y `tokens_drift` ata ambas representaciones para que no
// vuelvan a divergir entre el código y el diseño.
// El alto es una CONSTANTE y no `preferred-height` porque la grilla necesita
// saber dónde empieza cada fila para poder desplazarse hasta la que tiene el
// foco — y un alto que depende del contenido convierte esa cuenta en una que
// sólo se conoce después de dibujar.
// SIN la fila del badge: el semáforo pasó a ser una banda SOBRE la
// carátula y sólo con el foco, así que ya no ocupa alto propio.
// 8 (padding) + 336 (carátula) + 10 + 30 (título) + 10 + 26 (meta)
// + 8 (padding) = 428
export global CardMetrics {
    out property <length> height: 428px;
    out property <length> width: 268px;
    out property <length> gap: 24px;
    /// Lo que la tarjeta respira por dentro. Vive acá y no suelto en el
    /// `VerticalLayout` porque entra en la cuenta del alto de arriba.
    out property <length> padding: 8px;
}

component GameCard inherits Rectangle {
    in property <GameEntry> game;
    in property <bool> focused;
    callback clicked();
    callback activated();

    // la tarjeta es un ITEM de una lista, y lo que hay que oír de ella
    // es lo mismo que se ve: el juego, su plataforma y su semáforo. El semáforo
    // va en la descripción y no en la etiqueta porque no es parte del nombre —
    // y va en PALABRAS, que es lo que `Semaforo.palabra()` ya devuelve para que
    // el estado no dependa sólo del color.
    accessible-role: list-item;
    accessible-label: root.game.name;
    accessible-description: root.game.platform + " · "
        + StatusLight.word(root.game.pack-status, root.game.core-state);
    accessible-item-selectable: true;
    accessible-item-selected: root.focused;
    accessible-action-default => { root.activated(); }

    width: CardMetrics.width;
    height: CardMetrics.height;
    border-radius: Tokens.radius-lg;
    background: focused ? Tokens.accent-tint : transparent;
    border-width: focused ? Tokens.focus-width : 0px;
    border-color: Tokens.accent;

    touch-area := TouchArea {
        clicked          => { root.clicked(); }
        double-clicked   => { root.activated(); }
    }

    card := VerticalLayout {
        padding: CardMetrics.padding; spacing: 10px;

        // La carátula y su banda comparten caja: un `Rectangle` de alto fijo
        // con la carátula llenándolo y la banda apoyada en su borde inferior.
        // No es un layout —los dos hijos se SUPERPONEN, que es justamente lo
        // que un layout no hace— y por eso la banda se posiciona a mano.
        Rectangle {
            height: 336px;
            clip: true;

            Cover {
                width: parent.width; height: parent.height;
                platform: game.platform;
                art: game.cover;
                dimmed: StatusLight.core-blocks(game.core-state);
            }
            // Con el foco y no siempre: ver el comentario de `SemaBanda`.
            if root.focused: StatusBand {
                state: game.pack-status;
                core: game.core-state;
                width: parent.width;
                y: parent.height - self.height;
            }
        }
        Text {
            text: game.name;
            color: Tokens.text-bright;
            font-family: Tokens.font-ui; font-size: Tokens.text-body;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: game.region == "" ? game.platform
                                    : game.platform + " · " + game.region;
            color: Tokens.text-dim;
            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
            overflow: elide;
        }
    }
}

// un chip de la FilterBar (play-ce.pen «02 · Biblioteca» → FilterBar).
// Activo = fondo acento con texto oscuro; inactivo = `bg-elevated` con texto
// normal. La diferencia es de FONDO y no de borde a propósito: a distancia de TV
// un borde de un píxel no se ve, y el chip activo tiene que reconocerse sin
// leerlo — es lo único que explica por qué faltan juegos en la lista.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool>   active;
    callback clicked();


    // LO QUE UN LECTOR DE PANTALLA OYE. Sin `accessible-role` el resto de
    // las propiedades no se expone, así que el rol va primero y literal (Slint
    // lo exige constexpr). La etiqueta dice la ACCIÓN y no el ícono: «Jugar», no
    // «triángulo».
    // Checkbox y no botón: un chip de filtro tiene ESTADO, y anunciarlo como
    // botón deja al que no ve sin saber si el filtro está puesto — que es la
    // única información que el chip existe para dar.
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }

    height: 40px;
    width: label.width + 36px;
    border-radius: Shape.pill(self.width, self.height);
    background: active ? Tokens.accent
              : touch-area.has-hover ? Tokens.overlay-strong : Tokens.bg-elevated;

    touch-area := TouchArea { clicked => { root.clicked(); } }
    label := Text {
        text: root.label;
        color: active ? Tokens.accent-fg : Tokens.text-normal;
        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
        font-weight: 500;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// el menú de juego (play-ce.pen «02d»). 480 de ancho, `bg-elevated`,
// radio 6, borde, padding 16, gap 6.
// «Elegir pack» y «Elegir core» aparecen DESHABILITADOS y no ausentes: los trae
// el diseño, y una fila que desaparece se lee como «esta versión no lo tiene»
// mientras que una gris dice «todavía no» — que es la verdad, llegan con la
// ficha de juego y los ajustes.
// CON SU COLUMNA DE ÍCONOS, los seis que el diseño le pone («02d · Menú de
// juego»): play, star, package, cpu, pencil-simple, eye-slash. Estuvieron
// ausentes porque ninguna fuente de Play los tenía y los reemplazos
// que la cmap ofrecía eran ASCII arbitrarios —`#` para «pack», `@` para
// «core»—, que es ruido disfrazado de iconografía. El icono es opcional: una
// fila sin `icono` alinea igual que las demás.
component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool>   enabled: true;
    callback clicked();

    // una entrada de menú se anuncia por lo que HACE. El ícono no se
    // nombra: quien no ve la pantalla no gana nada oyendo «engranaje».
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    height: Tokens.control-md;
    border-radius: Tokens.radius-md;
    background: enabled && touch-area.has-hover ? Tokens.overlay-hi : transparent;

    touch-area := TouchArea {
        enabled: enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 12px;
        Icon {
            text: icon;
            color: enabled ? Tokens.text-normal : Tokens.text-dim;
        }
        Text {
            text: root.label;
            color: enabled ? Tokens.text-normal : Tokens.text-dim;
            font-family: Tokens.font-ui; font-size: Tokens.text-body;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------------------
// la ficha de JUEGO (play-ce.pen «03»).
// El sujeto es el JUEGO y el pack es una fila. Antes había una ficha de PACK
// (`pack_details.rs`) que se abría con D desde la configuración previa: una
// pantalla sobre el pack, escondida detrás de otra pantalla, a la que sólo
// llegaba quien ya sabía que existía. Acá A abre la ficha desde la grilla, y de
// ahí se juega.
// Subsume  (configuración previa, que pasa a ser un botón),  (ficha de
// pack, que pasa a ser la PackRow) y  (créditos).
// ---------------------------------------------------------------------------

/// Un botón de la fila de acciones de la ficha (play-ce.pen «03»: Button/Primary/lg
/// · Button/Default · Button/Ghost).
/// El ancho sale del CONTENIDO —ícono + etiqueta + el padding del diseño— y no
/// de un número fijo: con 220 para todos, «Configuración» quedaba apretada y
/// «HD» nadaba en el medio.
/// SIN la letra de la tecla al lado del nombre. La llevaba, y el diseño no: los
/// botones dicen QUÉ hacen y el pie dice CON QUÉ, que es la división que el
/// chasis usa en todas las demás pantallas.
component ActionButton inherits Rectangle {
    in property <string> label;
    /// Vacío = sin ícono. El botón queda con su etiqueta sola, que es como los
    /// dibuja el diseño donde no hay un verbo que ilustrar.
    in property <string> icon;
    /// El PESO: el acento de la acción que manda.
    in property <bool>   primary;
    /// Sin borde: el tercero de la fila, el que sólo se toca a propósito.
    in property <bool>   ghost;
    /// El TAMAÑO. `Button/Primary/lg` del .pen: el hero de una pantalla. En el
    /// pie de un diálogo todos miden 48, y ahí nadie es grande.
    in property <bool>   big;
    in property <bool>   enabled: true;
    callback clicked();


    // LO QUE UN LECTOR DE PANTALLA OYE. Sin `accessible-role` el resto de
    // las propiedades no se expone, así que el rol va primero y literal (Slint
    // lo exige constexpr). La etiqueta dice la ACCIÓN y no el ícono: «Jugar», no
    // «triángulo».
    // `accessible-action-default` es lo que deja ACTUAR desde el lector: sin
    // ella el botón se anuncia y no se puede apretar.
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    height: big ? 56px : Tokens.control-md;
    width: row.preferred-width + (big ? 64px : 48px);
    border-radius: Tokens.radius-lg;
    background: !enabled ? Tokens.bg-panel
              : primary    ? (touch-area.has-hover ? Tokens.accent-hi : Tokens.accent)
              : touch-area.has-hover ? Tokens.overlay-hi : transparent;
    // El Ghost no lleva borde y el Default sí: es lo que los separa cuando están
    // uno al lado del otro.
    border-width: primary || ghost ? 0px : 1px;
    border-color: enabled ? Tokens.text-bright : Tokens.border;

    touch-area := TouchArea {
        enabled: enabled;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        spacing: 10px; alignment: center;
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        height: parent.height;
        if root.icon != "": Icon {
            text: root.icon;
            size: big ? 28px : 24px;
            color: !enabled ? Tokens.text-dim
                 : primary    ? Tokens.accent-fg : Tokens.text-normal;
        }
        Text {
            text: root.label;
            color: !enabled ? Tokens.text-dim
                 : primary    ? Tokens.accent-fg : Tokens.text-normal;
            font-family: Tokens.font-ui;
            font-size: big ? Tokens.text-body-lg : Tokens.text-body;
            font-weight: 500; vertical-alignment: center;
        }
    }
}

// EL FOCO NUNCA SE TOMA DURANTE LA CONSTRUCCIÓN DEL SUBÁRBOL.
// `init => scope.focus()` parece lo natural y es una bomba de espoleta larga.
// Slint está construyendo el árbol de ítems; al notificar el cambio de foco, el
// adaptador de winit hace `borrow_mut()` sobre el RefCell de AccessKit que esa
// construcción ya tiene prestado —`winitwindowadapter.rs:1584`, y la función de
// al lado (`register_item_tree`) usa `try_borrow_mut` comentando exactamente
// este caso—. La ventana muere con «RefCell already borrowed».
// No es determinista: depende de qué esté haciendo AccessKit en ese frame. Por
// eso no aparecía al entrar y salir de una sección, sino «de la nada» después
// de veinte cambios seguidos con LB/RB. El wizard ya lo había sufrido y
// resuelto con este mismo Timer, y la lección no había llegado al resto del
// chasis: las secciones y los modales seguían pidiéndolo en `init`.
// Un tick después el árbol ya existe y tomar el foco es seguro.
// `pedir` se escribe como «me corresponde el foco y no lo tengo», así que esto
// cubre además el REGRESO —cerrar un modal, volver del wizard— sin un `changed`
// por pantalla. Quién manda es `pad-surface`, la misma precedencia que enruta
// el mando: el foco del teclado y el del mando no pueden discrepar porque miran
// el mismo dato.
component DeferredFocus {
    in property <bool> request-focus: false;
    callback take-focus();
    Timer {
        interval: 16ms;
        running: root.request-focus;
        triggered => { root.take-focus(); }
    }
}

// ---------------------------------------------------------------------------
// LA LISTA DEL EXPLORADOR, COMPARTIDA.
// La usan el wizard (elegir carpeta de ROMs y core) y el diálogo de packs
// (elegir un `.ay` o la carpeta de packs). Es UN componente a propósito: dos
// listas de archivos serían dos maneras de navegar el disco, y esa lección ya
// está pagada — «dos selectores de carpeta distintos serían dos comportamientos
// distintos para la misma decisión».
// ---------------------------------------------------------------------------
component ExplorerList inherits Rectangle {
    in property <string>   location: "";
    in property <[OnboardingRow]> rows: [];
    in property <int>      focus-index: 0;
    /// Click en una fila: el dueño decide qué significa (navegar o elegir).
    callback choose(int);

    // lo que un lector de pantalla oye: una lista, con dónde está
    // parada, y activar es elegir la fila con foco. Las filas no llevan rol
    // propio: el foco lo mueve el mando/teclado, no el recorrido del lector,
    // y anunciar N filas mudas encima de la lista sería leerla dos veces.
    accessible-role: list;
    accessible-label: root.location;
    accessible-action-default => { root.choose(root.focus-index); }

    VerticalLayout {
        spacing: 12px;
        Text {
            text: root.location; color: Tokens.text-dim;
            font-family: Tokens.font-mono; font-size: Tokens.text-body-sm;
            overflow: elide;
        }
        // La lista SIGUE al foco. Sin esto, bajar con el mando más allá de la
        // última fila visible mueve una selección que no se ve: el jugador
        // aprieta abajo, la lista se queda quieta y parece colgada — y en una
        // carpeta de sistema, las primeras diez entradas nunca son la que
        // busca.
        // Se escribe `viewport-y` a mano y no con un binding a propósito: un
        // binding lo pisaría en cada rueda del mouse, y este diálogo también se
        // usa con mouse. Es el mismo movimiento MÍNIMO que hace el
        // `bring-into-view` del StandardListView de Slint: si la fila quedó
        // arriba se la pega al techo, si quedó abajo al piso, y si ya se veía
        // no se mueve nada.
        list-view := ListView {
            property <length> step: 44px;
            property <int>    focus-index: root.focus-index;
            property <string> location: root.location;

            // Otra carpeta empieza arriba: heredar el desplazamiento de la
            // anterior deja la lista nueva abierta por el medio, sin que nada
            // lo explique.
            changed location => { self.viewport-y = 0; }
            changed focus-index => {
                if (self.viewport-y + self.focus-index * self.step) < 0 {
                    self.viewport-y = -self.focus-index * self.step;
                }
                if (self.viewport-y + (self.focus-index + 1) * self.step) > self.visible-height {
                    self.viewport-y = self.visible-height - (self.focus-index + 1) * self.step;
                }
            }

            for row[fi] in root.rows: Rectangle {
                height: list-view.step; border-radius: Tokens.radius-md;
                background: root.focus-index == fi ? Tokens.accent-tint : transparent;
                HorizontalLayout {
                    padding-left: 12px; spacing: 12px;
                    Icon {
                        text: row.folder ? Icons.folder : "";
                        color: root.focus-index == fi ? Tokens.accent : Tokens.text-dim;
                        size: 20px;
                    }
                    Text {
                        text: row.title;
                        color: root.focus-index == fi ? Tokens.accent : Tokens.text-normal;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        vertical-alignment: center;
                        horizontal-alignment: left; overflow: elide;
                    }
                    // Empuja el nombre a la izquierda: sin esto el layout
                    // reparte el sobrante y la lista se lee centrada, que en
                    // una columna de rutas es ilegible.
                    Rectangle { horizontal-stretch: 1; }
                }
                TouchArea { clicked => { root.choose(fi); } }
            }
        }
    }
}

// una fila de Ajustes (play-ce.pen «05»): alto 88, línea abajo, la etiqueta
// y su explicación a la izquierda y el control a la derecha.
// `origen` es el CA: todo valor dice de dónde sale. Un ajuste con cuatro lugares
// posibles donde definirse es un ajuste que el jugador cambia y no pasa nada
// otro más específico lo estaba pisando— y sin la procedencia la única manera
// de entenderlo es probar hasta que funcione.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <string> value;
    in property <string> origin;
    in property <string> action;
    in property <bool>   enabled: true;
    /// La fila que tiene el foco del mando, con el mismo anillo que las
    /// tarjetas de la biblioteca. Sin esto, moverse con ↑↓ no cambia nada en
    /// pantalla y la sección se lee como que no responde — que era la mitad de
    /// por qué Ajustes parecía roto.
    in property <bool>   focused: false;
    callback clicked();

    // la fila de Ajustes se anuncia con su etiqueta, su VALOR actual y
    // de dónde sale ese valor. El origen («global», «por juego») es la mitad de
    // la información, por lo mismo que está en la pantalla: un ajuste que dice
    // «CRT» sin decir quién lo puso no se puede corregir a ciegas.
    accessible-role: button;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-description: root.detail
        + (root.origin == "" ? "" : " · " + root.origin)
        + (root.action == "" ? "" : " · " + root.action);
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    height: 88px;
    background: focused ? Tokens.accent-tint
              : touch-area.has-hover && enabled ? Tokens.overlay-hi
              : transparent;
    border-width: focused ? Tokens.focus-width : 0px;
    border-color: Tokens.accent;

    touch-area := TouchArea { enabled: enabled; clicked => { root.clicked(); } }
    // La línea de abajo separa filas sin encerrarlas en tarjetas: una lista de
    // siete cajas a distancia de TV se lee como siete cosas distintas, y son
    // siete ajustes de lo mismo.
    Rectangle {
        y: parent.height - 1px; height: 1px;
        background: Tokens.border-soft;
    }

    HorizontalLayout {
        padding-left: 24px; padding-right: 24px; spacing: 24px;
        VerticalLayout {
            alignment: center; spacing: 4px; horizontal-stretch: 1;
            Text {
                text: root.label;
                color: enabled ? Tokens.text-bright : Tokens.text-dim;
                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                font-weight: 500;
            }
            Text {
                text: detail;
                color: Tokens.text-dim;
                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                overflow: elide;
            }
        }
        // La procedencia, cuando la hay. Va ANTES del valor y no después: se lee
        // «global · Español», que es el orden en que la pregunta aparece.
        if origin != "": Text {
            text: origin;
            color: Tokens.text-dim;
            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
            vertical-alignment: center;
        }
        if value != "": Rectangle {
            width: 320px; height: 48px; y: (parent.height - self.height) / 2;
            background: Tokens.bg-input;
            border-radius: Tokens.radius-md;
            border-width: 1px; border-color: Tokens.border;
            Text {
                text: value; color: Tokens.text-normal;
                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                x: 16px; vertical-alignment: center; height: parent.height;
            }
        }
        if action != "": Rectangle {
            width: 180px; height: Tokens.control-sm; y: (parent.height - self.height) / 2;
            border-radius: Tokens.radius-lg;
            border-width: 1px; border-color: Tokens.border;
            background: touch-area.has-hover ? Tokens.overlay-hi : transparent;
            Text {
                text: action; color: Tokens.text-normal;
                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                font-weight: 500;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
        }
    }
}

// ---- Dialog/10ft, el diálogo de dos salidas --------------------------
// `Dialog/10ft` es UN componente en play-ce.pen y hasta ahora era una forma que
// cada diálogo volvía a escribir. El crash y la sesión sin cerrar dicen cosas
// distintas con la misma estructura: título, cuerpo y
// dos salidas nombradas por lo que hacen. Con una sola pieza no pueden
// terminar con botones de distinto tamaño ni con el foco en lugares distintos.
// Las dos salidas se nombran por su efecto («Descartar» / «Recuperar»), nunca
// «Sí» y «No»: a distancia de TV el jugador lee el botón, no la pregunta.
component TenFootDialog inherits Rectangle {
    in property <string> title;
    in property <string> left-button-label;
    /// La salida izquierda pinta de rojo cuando destruye algo. El color NO es
    /// la única señal —la palabra ya dice qué hace— pero ayuda a no apretarla
    /// de paso.
    in property <bool>   left-danger: false;
    in property <string> right-button-label;
    in property <length> panel-width: 760px;
    callback left-clicked();
    callback right-clicked();

    // Slint no tiene rol de diálogo, y `groupbox` es lo más cerca: da un
    // nombre al conjunto, que es lo que hace falta para que las dos acciones de
    // abajo se oigan como opciones DE ALGO y no sueltas. Los botones traen su
    // propio rol, que es donde de verdad se actúa.
    accessible-role: groupbox;
    accessible-label: root.title;

    width: root.panel-width;
    height: dialog-column.preferred-height;
    background: Tokens.bg-elevated;
    border-radius: Tokens.radius-lg;
    border-width: 1px; border-color: Tokens.border;

    dialog-column := VerticalLayout {
        padding: 28px; spacing: 20px;
        Text {
            text: root.title;
            color: Tokens.text-bright;
            font-family: Tokens.font-display; font-size: Tokens.text-display-md;
            font-weight: 600; letter-spacing: 0.8px;
            wrap: word-wrap; width: root.panel-width - 56px;
        }
        VerticalLayout { spacing: 16px; @children }
        HorizontalLayout {
            spacing: 12px; alignment: end;
            left-area := TouchArea {
                width: 220px; height: Tokens.control-md;
                clicked => { root.left-clicked(); }
                Rectangle {
                    border-radius: Tokens.radius-md;
                    border-width: 1px;
                    border-color: root.left-danger ? Tokens.danger : Tokens.border;
                    background: left-area.has-hover
                        ? (root.left-danger ? Tokens.danger : Tokens.overlay-hi)
                        : transparent;
                    Text {
                        text: root.left-button-label;
                        color: left-area.has-hover && root.left-danger
                            ? Tokens.accent-fg
                            : (root.left-danger ? Tokens.danger : Tokens.text-normal);
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        font-weight: 500;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                }
            }
            right-area := TouchArea {
                width: 300px; height: Tokens.control-md;
                clicked => { root.right-clicked(); }
                Rectangle {
                    border-radius: Tokens.radius-md;
                    background: right-area.has-hover ? Tokens.accent-hi : Tokens.accent;
                    Text {
                        text: root.right-button-label; color: Tokens.accent-fg;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                }
            }
        }
    }
}

// ---- Alert/10ft ------------------------------------------------------
// Lo que la acción promete, dentro del diálogo que la ofrece. «Modo seguro» sin
// la promesa de qué se conserva suena a que algo se va a perder, y quien tiene
// veinte horas en ese guardado no lo aprieta.
component TenFootAlert inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <length> panel-width: 704px;
    // El .pen dibuja esta tarjeta con cuatro íconos según lo que trae:
    // `warning`, `x-circle`, `info`, `shield-warning`. El default es la
    // advertencia porque es el caso más común; el que la usa para dar una BUENA
    // noticia tiene que decirlo, o queda un triángulo ámbar al lado de «Core
    // válido» — que es lo que se leía en el paso del core.
    in property <string> icon: Icons.warning;
    in property <color>  tone:  Tokens.warning;
    width: root.panel-width;
    height: alert-column.preferred-height;
    background: Tokens.overlay-hi;
    border-radius: Tokens.radius-md;
    alert-column := HorizontalLayout {
        padding: 24px; spacing: 16px;
        Icon {
            // Alert/10ft del .pen: el ícono de 32, del color de lo que dice.
            text: root.icon;
            color: root.tone;
            size: 32px;
        }
        VerticalLayout {
            spacing: 8px;
            Text {
                text: root.title; color: Tokens.text-bright;
                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                font-weight: 600;
                wrap: word-wrap; width: root.panel-width - 88px;
            }
            Text {
                text: root.detail; color: Tokens.text-dim;
                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                wrap: word-wrap; width: root.panel-width - 88px;
            }
        }
    }
}

// ---- StatTile --------------------------------------------------------
// Una cifra con su nombre. El nombre va ARRIBA y chico, la cifra abajo y
// grande: a distancia de TV lo que se lee primero es el número, y ponerlo
// segundo obliga a leer la etiqueta para saber qué se está mirando.
/// Un dato del juego, en grande (StatTile del .pen: 260 de ancho, 16/20 de
/// padding, la etiqueta en 18 y el valor en 32). El número va en la mono porque
/// son cifras que se comparan de un vistazo entre tarjetas, y una proporcional
/// las desalinea.
component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;

    // TODOS LOS TILES DE UNA FILA MIDEN LO MISMO Y ESCRIBEN IGUAL.
    // El alto salía del contenido y el cuerpo del valor bajaba a 22 px cuando
    // el texto pasaba de diez caracteres, así que en la ficha convivían
    // «recién empezado» —chico, en una caja más baja— con «Nunca» y «Mega
    // Drive» en 32. Tres cajas distintas para tres datos del mismo rango se
    // leen como tres cosas de distinta importancia, y no lo son: es la misma
    // ficha diciendo tres hechos del juego.
    // El alto es una CONSTANTE y no `preferred-height`: con el cuerpo fijo los
    // tres darían lo mismo igual, pero entonces la igualdad dependería de que
    // ningún idioma traiga una etiqueta de dos renglones — y el día que llegue,
    // un tile más alto que sus vecinos vuelve sin que nadie lo haya decidido.
    // 16 (padding) + 22 (etiqueta 18) + 6 + 40 (valor 32) + 16 = 100
    out property <length> tile-height: 100px;

    // Y el ANCHO crece con el valor en vez de encogerle la letra. Los 260 del
    // .pen son un mínimo, no un límite: es la medida con la que el diseño dibuja
    // «12 h 40 m», y estirar la caja para que entre un valor más largo conserva
    // lo único que no puede variar entre tiles hermanos —el cuerpo del número—.
    // Elidir sería peor que las dos cosas: un dato cortado se lee como un error
    // de la aplicación.
    width: max(260px, stat-column.preferred-width);
    height: root.tile-height;
    background: Tokens.bg-panel;
    border-radius: Tokens.radius-sm;
    stat-column := VerticalLayout {
        padding-left: 20px; padding-right: 20px;
        padding-top: 16px;  padding-bottom: 16px;
        spacing: 6px;
        Text {
            text: root.label; color: Tokens.text-dim;
            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
        }
        // El número va en la mono porque son cifras que se comparan de un
        // vistazo entre tiles, y una proporcional las desalinea.
        Text {
            text: root.value; color: Tokens.text-bright;
            font-family: Tokens.font-mono;
            font-size: Tokens.text-display-md;
            font-weight: 600;
        }
    }
}

// la fila de la vista lista, según play-ce.pen «02e · Vista lista».
// La anterior venía de antes de la escala 10-foot: textos de 10, 12 y
// 14 px, o sea por debajo del mínimo legible a distancia de TV, que es
// `body-sm` = 18. Y marcaba el estado del pack con UN PUNTO DE COLOR, que es
// exactamente lo que el §10 prohíbe: quien no distingue verde de rojo no tiene
// cómo saber qué le pasa a ese juego. Ahora comparte el `SemaphoreBadge` con la
// tarjeta, así que las dos vistas dicen lo mismo de la misma manera.
// La columna de tiempo de juego que el diseño muestra a la derecha es : sin
// el dato, una columna vacía sería ruido.
component GameRow inherits Rectangle {
    in property <GameEntry> game;
    in property <bool>      selected: false;
    callback clicked();
    callback double-clicked();

    // la vista lista dice lo mismo que la grilla: es la misma entrada
    // con otra forma, y anunciarlas distinto sería dos productos.
    accessible-role: list-item;
    accessible-label: root.game.name;
    accessible-description: root.game.platform + " · "
        + StatusLight.word(root.game.pack-status, root.game.core-state);
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.double-clicked(); }

    height: 64px;
    background: selected ? Tokens.accent-tint : transparent;
    border-width: selected ? Tokens.focus-width : 0px;
    border-color: Tokens.accent;

    touch-area := TouchArea { clicked => { root.clicked(); } double-clicked => { root.double-clicked(); } }
    if !selected && touch-area.has-hover: Rectangle { background: Tokens.overlay-hi; }

    // Sin `alignment: start`: el default es `stretch`, que es lo que deja al
    // separador empujar el badge al margen. Con `start` los hijos se empaquetan
    // a la izquierda y el estirado se ignora en silencio.
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; spacing: 24px;

        Rectangle {
            width: 48px; height: parent.height;
            Cover {
                width: 48px; height: 48px; y: (parent.height - self.height) / 2;
                platform: game.platform; art: game.cover;
                dimmed: StatusLight.core-blocks(game.core-state);
            }
        }
        Text {
            text: game.name;
            color: Tokens.text-bright;
            font-family: Tokens.font-ui; font-size: Tokens.text-body;
            font-weight: 600; vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
        }
        Text {
            text: game.region == "" || game.region == "UNK"
                ? game.platform
                : game.platform + " · " + game.region;
            color: Tokens.text-dim;
            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        // El separador que manda el badge al margen derecho, como en el diseño.
        // Sin él la fila se lee como una oración —nombre, consola, estado— y el
        // ojo tiene que recorrerla entera para encontrar el semáforo.
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: badge.width; height: parent.height;
            badge := SemaphoreBadge {
                y: (parent.height - self.height) / 2;
                state: game.pack-status; core: game.core-state;
                reason: game.compat-reason;
            }
        }
    }
}

// ---------------------------------------------------------------------------
/// el banner del escaneo (play-ce.pen, «02 · Biblioteca» → Page →
/// ScanBanner). Medidas y colores salen del diseño: alto 56, gap 20, padding
/// lateral 24, barra de 360×8 con esquinas de píldora.
/// Existe porque el escaneo dejó de ser una operación que se espera: quitar el
/// tope de 64 MiB hizo que hashear una biblioteca grande tarde de verdad, y sin
/// una salida a la vista la única forma de cortar sería cerrar Play — que es
/// justamente lo que dejaba la caché a medias.
component ScanBanner inherits Rectangle {
    in property <int> done;
    in property <int> total;
    in property <int> found;
    callback cancel();

    // un progreso que sólo se ve como barra no existe para quien no la
    // ve. Con rol y valor, el avance del escaneo se puede consultar en vez de
    // esperar a que la pantalla cambie sola.
    accessible-role: progress-indicator;
    accessible-label: @tr("Escaneando la biblioteca");
    accessible-value: root.done + " / " + root.total;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.total;

    height: 56px;
    background: Tokens.bg-panel;

    HorizontalLayout {
        padding-left: 24px; padding-right: 24px; spacing: 20px;
        alignment: start;

        Icon {
            // ScanBanner del .pen: `magnifying-glass` del acento. El escaneo es
            // una BÚSQUEDA de ROMs, no un refresco — el `↻` de antes era el
            // glifo que había, no el que el diseño pide.
            text: Icons.magnifying-glass; color: Tokens.accent;
        }
        Text {
            text: found == 1
                ? @tr("Escaneando… {} juego encontrado", found)
                : @tr("Escaneando… {} juegos encontrados", found);
            color: Tokens.text-normal;
            font-family: Tokens.font-ui; font-size: Tokens.text-body;
            vertical-alignment: center;
        }
        // La barra: el relleno es una fracción del ancho fijo del riel. Con
        // `total` en 0 queda en cero — no se inventa un progreso que no se sabe.
        Rectangle {
            width: 360px; height: 8px; y: (parent.height - self.height) / 2;
            background: Tokens.bg-well;
            border-radius: Shape.pill(self.width, self.height);
            clip: true;
            Rectangle {
                x: 0;
                width: total > 0 ? parent.width * (done / total) : 0px;
                height: parent.height;
                background: Tokens.accent;
                border-radius: Shape.pill(self.width, self.height);
            }
        }
        Rectangle { horizontal-stretch: 1; }
        cancel-area := TouchArea {
            width: cancel-label.width + 32px; height: Tokens.control-sm;
            clicked => { root.cancel(); }
            Rectangle {
                border-radius: Tokens.radius-lg;
                background: cancel-area.has-hover ? Tokens.overlay-hi : transparent;
                cancel-label := Text {
                    text: @tr("Cancelar");
                    color: Tokens.text-normal;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                    font-weight: 500;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title:            "Ayther Play";
    // Icono de VENTANA (barra de tareas mientras corre, Alt-Tab, encabezado del
    // gestor de ventanas). El del EJECUTABLE es otro y es Win32: sale del
    // recurso ICON que compila build.rs desde resources/AYTHER-Play.ico. Los
    // dos son la MISMA marca y se actualizan juntos.
    icon:             @image-url("../resources/AYTHER-Play.png");
    // el chasis es 1920×1080. No es un capricho de resolución: la escala
    // 10-foot del diseño (tipos 18–64, controles 40/48/56, safe area 96/54,
    // grilla de 6×240+24) está medida sobre ese lienzo, y a 1280×720 los mismos
    // números dejan de caber — la grilla se recorta y los textos se apilan.
    preferred-width:  1920px;
    preferred-height: 1080px;
    // El tamaño de la VENTANA no se declara acá aunque parezca el lugar: Slint
    // se lo pide al contenido (`layout_constraints()` recorre el árbol), y un
    // `min-width`/`max-width` en el `Window` no le gana a lo que digan los
    // hijos. Por eso el tamaño se cuida donde se rompe: en las secciones que
    // traen medidas fijas (ver «MODO LOCAL» más abajo).
    // Las familias y el cuerpo base salen del design system (tokens.slint,
    // generado desde play-ce.pen). La escala 10-foot completa —tipos 18–64,
    // controles 40/48/56— llega con el chasis 1920×1080; acá se fija
    // la identidad tipográfica para que deje de depender de la fuente del
    // sistema, que cambia entre máquinas.
    default-font-family: Tokens.font-ui;
    background:       Tokens.bg-well;

    // ---- Library state -------------------------------------------------------
    in     property <[GameEntry]>    games:        [];
    in-out property <int>            current-game: 0;
    in     property <string>         status:       @tr("No hay ROMs — apretá F5 para escanear");
    in     property <bool>           scanning:     false;
    // el escaneo NO bloquea (play-ce.pen, nota «02 · Biblioteca»): la
    // biblioteca se usa mientras escanea, así que hace falta decir cuánto falta
    // y ofrecer salida. `scan-total` en 0 significa «todavía no sé cuántos
    // son»: la barra queda vacía en vez de mentir un progreso.
    in     property <int>            scan-done:  0;
    in     property <int>            scan-total:   0;
    in     property <int>            scan-found: 0;
    callback scan-cancel();
    // grilla (default) o lista. Se persiste en la config para que el
    // jugador no tenga que volver a elegirla cada vez que abre Play.
    in-out property <bool>           list-view:  false;
    callback view-changed(bool);
    // Columnas de la grilla. Salen del ANCHO real y no de una constante: el
    // diseño fija la tarjeta en 240 y el gap en 24, así que cuántas entran
    // depende de la pantalla. Con un número fijo, una ventana angosta recorta
    // la última columna y una ancha desperdicia el espacio.
    in-out property <length>         library-width: 1280px;

    // ---- filtros, orden y menú de juego --------------------------------
    // Todos los controles avisan por UN callback: los cinco terminan haciendo lo
    // mismo —re-proyectar la lista— y con uno solo es imposible que a alguno se
    // le olvide.
    in-out property <string>         search:      "";
    in     property <[string]>       platforms:   [];
    in-out property <string>         filter-platform: "";
    in-out property <bool>           filter-compatible: false;
    in-out property <bool>           filter-favorites:   false;
    in-out property <bool>           show-hidden:    false;
    in-out property <int>            order:         0;
    /// Cuántos hay en total (sin contar ocultos), para poder decir «3 de 120».
    in     property <int>            total-games:  0;
    in     property <bool>           filter-active: false;
    callback filter-changed();
    callback game-favorite(int);
    callback game-hide(int);
    callback game-edit(int, string);
    callback game-restore(int);

    // ---- Inicio ---------------------------------------------------------
    // El hero se arma con campos sueltos y no con un `GameEntry`: sus textos son
    // COMPUESTOS por Rust («Último guardado: … · 12 h 40 m jugadas»), y armarlos
    // en Slint obligaría a formatear tiempo y fecha en el `.slint`, donde no se
    // pueden probar.
    in property <bool>       has-continue: false;
    /// El juego del hero, entero. Se lanza pasando la ENTRADA y no un índice
    /// porque los índices son de un modelo: el de la biblioteca está filtrado y
    /// el de recientes es otro, así que un `int` significaría cosas distintas
    /// según de dónde salió — que es como se cuelan los «lanzó el juego
    /// equivocado». La entrada trae su ruta y no depende de ninguna lista.
    in property <GameEntry>  continue-game;
    /// Texto compuesto por Rust: mezcla tiempo formateado con el pack.
    in property <string>     continue-meta: "";
    in property <[GameEntry]> recent: [];
    callback launch-entry(GameEntry);

    // ---- la ficha de juego ---------------------------------------------
    // Los textos compuestos —la línea técnica, el tiempo— los arma Rust: mezclan
    // formato de fecha y de duración con datos del pack, y en el `.slint` esa
    // lógica no se puede probar.
    in-out property <bool>       details-open: false;
    in property <GameEntry>      details-game;
    in property <string>         details-tech: "";
    in property <string>         details-time: "";
    in property <string>         details-last-played: "";
    in property <bool>           details-played: false;
    // `ficha-jugable` lo decide el CORE y nada más. Un pack roto no
    // apaga este botón: apaga el suyo.
    in property <bool>           details-playable: true;
    in property <bool>           details-hd: true;
    /// ¿el pack se puede activar? Sin pack es `false` y no hay nada que
    /// explicar; con un pack que no sirve es `false` y `ficha-pack-motivo` dice
    /// por qué, al lado del conmutador. Un control deshabilitado sin razón manda
    /// a probar de nuevo en vez de a arreglar lo que falta.
    in property <bool>           details-pack-usable: false;
    in property <string>         details-pack-warning: "";
    // en qué situación está el pack y qué se puede hacer con él:
    // 0 no hay · 1 activo · 2 apagado · 3 no sirve. Espeja `ficha::EstadoPack`,
    // que es donde vive la tabla entera de estado → acción.
    in property <int>            details-pack-usage-status: 0;
    /// En qué está el pack, y el verbo de lo que se puede hacer. Las palabras
    /// viven acá y no en Rust porque acá está el resto de los textos y por acá
    /// pasa el catálogo de traducción; del otro lado vive la máquina —qué estado
    /// hay y qué acción ofrece—, que es lo que se prueba sin abrir una ventana.
    out property <string>        details-pack-usage:
        details-pack-usage-status == 1 ? @tr("Activo")
      : details-pack-usage-status == 2 ? @tr("Apagado")
      : details-pack-usage-status == 3 ? @tr("No se puede usar")
                                   : "";
    /// el estado 0 —sin pack— ofrece INSTALAR DESDE EL DISCO: el
    /// «Conseguir un pack» en la edición propietaria abre el catálogo remoto;
    /// en CE abre el diálogo que audita un `.ay` que el jugador ya tiene.
    out property <string>        details-pack-action:
        details-pack-usage-status == 0 ? @tr("Instalar un pack desde el disco")
      : details-pack-usage-status == 1 ? @tr("Desactivar")
      : details-pack-usage-status == 2 ? @tr("Activar")
                                   : "";
    callback details-pack-act();
    /// Este juego no tiene pack puesto. En AYTHER Play CE eso es el final de la
    /// frase: no hay a quién preguntarle qué packs existen para esta ROM
    /// (ADR-005), así que la sección dice lo que sí sabe en vez de dejar el
    /// hueco de una consulta que nunca va a pasar.
    in property <bool>           details-no-pack: false;
    // DOS PREGUNTAS, NO TRES EJES.
    // Eran `eje-rom`, `eje-core` y `eje-pack`, tres badges hermanos de los que
    // salía un veredicto. Pero el de la ROM nunca habló de la ROM del jugador
    // `eje_rom` sólo lee códigos del validador DEL PACK y sin pack no dice
    // nada—, y al lado del core se leía como «tu ROM está mal»: otra cosa, y que
    // manda a arreglar lo que no está roto.
    // Ahora `ficha-estado` contesta «¿esto corre?» (lo dice el core) y la
    // sección del pack contesta «¿esto está mejorado?», con la razón de la ROM
    // adentro, que es de lo que hablaba.
    in property <int>            details-status: 0;
    /// el eje del core con SU vocabulario: «Falta el core» manda a elegir
    /// uno y «El core no sirve» manda a cambiarlo, que es más de lo que dice un
    /// «Incompatible» genérico.
    in property <int>            details-core: StatusLight.core-not-applicable;
    in property <string>         details-status-reason: "";
    in property <int>            details-pack-status: 0;
    in property <string>         details-pack-reason: "";
    in property <string>         pack-name: "";
    in property <string>         pack-author: "";
    /// Lo que se pudo AUDITAR del archivo, en palabras (`verifier::Auditoria`).
    /// No dice de quién es el pack: CE no puede saberlo y no lo insinúa.
    in property <string>         pack-audit: "";
    /// Sólo `Integro` lo pone en verde. «Sin índice» no es un problema —es un
    /// pack viejo— y pintarlo como tal enseñaría a desconfiar de packs que
    /// andan perfecto.
    in property <bool>           pack-audit-ok: false;
    callback details-play();
    callback details-toggle-hd();
    callback details-configure();
    callback open-details(GameEntry);

    // ---- Settings --------------------------------------------------------
    in-out property <int>    setting-row: 0;
    in property <string>     setting-language: "";
    in property <string>     setting-folders: "";
    in property <string>     setting-cores: "";
    in property <string>     setting-output: "";
    /// De dónde sale el valor. **Es el CA**: un ajuste con cuatro lugares donde
    /// definirse es uno que el jugador cambia y no pasa nada.
    in property <string>     setting-output-origin: "";
    in property <string>     setting-data: "";
    /// Los controles del juego, como estado: de fábrica o personalizados.
    in property <string>     setting-controls: "";
    /// la carpeta de packs, dicha como estado («D:\packs · 3 packs» o
    /// que no hay ninguna designada).
    in property <string>     setting-packs: "";
    callback setting-activate(int);
    /// la acción SECUNDARIA de la fila (Y del mando): hoy, quitar la
    /// carpeta de packs. Qué fila tiene una lo decide `ajustes::secundaria`.
    callback setting-secondary(int);
    // La confirmación destructiva. El texto de «qué se conserva» lo escribe
    // Rust (`ajustes::Destructiva`) para que los tres diálogos no puedan decir
    // cosas distintas sobre lo mismo.
    // ---- Controles del juego ------------------------------------------------
    // Qué tecla y qué botón hace cada acción del RetroPad DENTRO de la
    // partida. La máquina vive en `controles.rs`; el contrato con el runtime
    // es `--input-map` y lo escribe el lanzamiento.
    in property <bool>         controls-open: false;
    in-out property <int>      controls-row: 0;
    /// 0 nada · 1 esperando una tecla · 2 esperando un botón del mando.
    in property <int>          controls-capture: 0;
    in property <[ControlRow]> controls-rows: [];
    callback controls-move(int);
    callback controls-capture-key();
    callback controls-capture-button();
    /// Una tecla del teclado, ya con nombre («K», «Space», «Up»…): la manda el
    /// FocusScope del diálogo cuando está capturando.
    callback controls-key(string);
    /// Un botón crudo del mando (nombre SDL): lo manda el hilo de gilrs.
    callback controls-button(string);
    callback controls-restore();
    callback controls-close();

    // ---- un pack entra desde el disco ---------------------------------
    // El diálogo de la máquina `instalar.rs`: elegir un `.ay` e instalarlo, o
    // designar la carpeta de packs. Propio y no el del sistema, por lo mismo
    // que el wizard: `GetOpenFileName` es una ventana de escritorio,
    // sin foco visible a tres metros y sin mando.
    in     property <bool>     install-open: false;
    /// 0 explorando · 1 trabajando (auditando e instalando) · 2 resultado.
    in     property <int>      install-phase: 0;
    in     property <bool>     install-folder-mode: false;
    in     property <string>   install-path: "";
    in     property <[OnboardingRow]> install-rows: [];
    in-out property <int>      install-row: 0;
    /// Lo que pasó, en palabras (`instalar::Resultado`): el título, el detalle
    /// y si hay una versión anterior a la que volver.
    in     property <string>   install-title: "";
    in     property <string>   install-detail: "";
    in     property <bool>     install-can-revert: false;
    /// El paso de la cruceta va a Rust y vuelve como `instalar-fila`: UNA
    /// implementación del tope, en `instalar.rs`, para el mando y el teclado.
    callback install-move(int);
    callback install-activate(int);
    callback install-action();     // X: usar esta carpeta (modo carpeta)
    callback install-revert();   // Y: volver a la versión anterior
    callback install-close();

    // ---- crash, sesión huérfana y doble lanzamiento -------------------
    in-out property <bool>   crash-open: false;
    in property <string>     crash-detail: "";
    callback crash-safe-mode();

    in-out property <bool>   orphan-open: false;
    in property <string>     orphan-text: "";
    in property <string>     orphan-save: "";
    callback orphan-recover();
    callback orphan-discard();

    /// El banner, mientras dure. No es un ajuste: es el estado de ESTA sesión.
    in-out property <bool>   safe-mode: false;
    callback exit-safe-mode();

    /// Vacío = no hay aviso. Un string y no un bool más un texto, para que no
    /// puedan contradecirse.
    in-out property <string> toast-text: "";

    // ---- el overlay de sesión ------------------------------------------
    in-out property <bool>   session-preparing: false;
    in property <string>     session-game: "";
    /// Hasta dónde llegó el lanzamiento: 0 manifest · 1 proceso · 2 esperando
    /// `ready`. Es un índice y no tres banderas para que los pasos no puedan
    /// contradecirse entre sí.
    in property <int>        session-step: 0;
    in property <string>     session-manifest: "";
    in property <string>     session-process: "";
    in property <string>     session-wait: "";
    in property <string>     session-warning: "";

    in-out property <bool>   confirm-open: false;
    in property <string>     confirm-title: "";
    in property <string>     confirm-keeps: "";
    in property <string>     confirm-action: "";
    callback confirm-accept();
    // lo que se puede hacer en la superficie que TIENE el foco, en
    // pares (tecla, qué hace). Con un modal abierto, unos hints que siguen
    // hablando de la lista mandan a probar teclas que no hacen nada.
    // El vocabulario es el del `.pen`: cada pantalla del diseño trae su
    // ButtonHints y de ahí salen las etiquetas —«Seleccionar», «Atrás»,
    // «Filtrar», «Menú»—, que es lo que hace que dos pantallas no le llamen
    // distinto al mismo botón.
    // Una propiedad por superficie y no un ternario con las listas adentro:
    // Slint no convierte un literal de array anónimo a `[PadHint]`, y además
    // así cada pie se lee solo, al lado del nombre de su pantalla.
    property <[PadHint]> hints-config: [
        { key: "A",     icon: "", label: @tr("Cambiar") },
        { key: "Start", icon: "", label: @tr("Jugar") },
        { key: "B",     icon: "", label: @tr("Atrás") },
    ];
    property <[PadHint]> hints-settings: [
        { key: "A",  icon: "", label: @tr("Cambiar") },
        { key: "B",  icon: "", label: @tr("Atrás") },
        { key: "LB", icon: "", label: @tr("Sección") },
        { key: "RB", icon: "", label: @tr("Sección") },
    ];
    // el pie del diálogo de packs cambia con la fase, porque lo que se
    // puede hacer cambia: explorando se elige, trabajando no hay nada que
    // apretar, y en el resultado lo único vivo es cerrar — y revertir, sólo
    // cuando de verdad hay una versión anterior guardada.
    // Una propiedad por lista y no literales en el ternario: Slint no convierte
    // un array anónimo a `[PadHint]` (misma nota que en los pies del chasis).
    property <[PadHint]> hints-install-choose: [
        { key: "A", icon: "", label: @tr("Elegir") },
        { key: "B", icon: "", label: @tr("Cancelar") },
    ];
    property <[PadHint]> hints-install-folder: [
        { key: "A", icon: "", label: @tr("Entrar") },
        { key: "X", icon: "", label: @tr("Usar esta carpeta") },
        { key: "B", icon: "", label: @tr("Cancelar") },
    ];
    property <[PadHint]> hints-install-idle: [];
    property <[PadHint]> hints-install-close: [
        { key: "B", icon: "", label: @tr("Cerrar") },
    ];
    property <[PadHint]> hints-install-revert: [
        { key: "Y", icon: "", label: @tr("Revertir") },
        { key: "B", icon: "", label: @tr("Cerrar") },
    ];
    property <[PadHint]> hints-install:
        root.install-phase == 1 ? root.hints-install-idle
      : root.install-phase == 2 ?
            (root.install-can-revert ? root.hints-install-revert
                                          : root.hints-install-close)
      : root.install-folder-mode ? root.hints-install-folder
                                   : root.hints-install-choose;
    // El pie del diálogo de controles. Capturando no hay nada que anunciar:
    // la próxima tecla o el próximo botón ES la respuesta, no un gesto.
    property <[PadHint]> hints-controls-normal: [
        { key: "A", icon: "", label: @tr("Tecla") },
        { key: "X", icon: "", label: @tr("Botón") },
        { key: "Y", icon: "", label: @tr("Restaurar todo") },
        { key: "B", icon: "", label: @tr("Cerrar") },
    ];
    property <[PadHint]> hints-controls-capturing: [];
    property <[PadHint]> hints-controls:
        root.controls-capture == 0 ? root.hints-controls-normal
                                    : root.hints-controls-capturing;
    property <[PadHint]> hints-saves: [
        { key: "A", icon: "", label: @tr("Restaurar") },
        { key: "B", icon: "", label: @tr("Cerrar") },
    ];
    // El pie de la ficha, como el del .pen (A · X · Y · B). «Start Partida
    // nueva» era MENTIRA: Start hace lo mismo que A —jugar— y quien empezaba de
    // nuevo con él se encontraba con su partida guardada.
    property <[PadHint]> hints-details: [
        { key: "A", icon: "", label: @tr("Jugar") },
        // X hace lo mismo que el botón de la sección PACK, y lo dice con
        // sus palabras. «Original / HD» nombraba un perfil de sesión; lo que se
        // elige es si el pack está puesto.
        { key: "X", icon: "", label: @tr("Activar/Desactivar pack") },
        { key: "Y", icon: "", label: @tr("Partida nueva") },
        { key: "B", icon: "", label: @tr("Atrás") },
    ];
    property <[PadHint]> hints-credits: [
        { key: "B", icon: "", label: @tr("Cerrar") },
    ];
    property <[PadHint]> hints-crash: [
        { key: "A", icon: "", label: @tr("Modo seguro") },
        { key: "B", icon: "", label: @tr("Cerrar") },
    ];
    property <[PadHint]> hints-orphan: [
        { key: "A",     icon: "", label: @tr("Recuperar") },
        // Y, no Start: el router manda Descartar a Menu (Y) A PROPÓSITO —
        // descartar borra y no puede compartir gesto con «salir de acá»—, y el
        // pie decía Start. Con el pie ahora clickeable la mentira dejó de ser
        // cosmética: el click en «Descartar» habría RECUPERADO.
        { key: "Y",     icon: "", label: @tr("Descartar") },
    ];
    // Acá la DIRECCIÓN es la acción —puntuar de 1 a 5, elegir entre dos
    // guardados—, así que el hint la dibuja con su ícono en vez de una letra.
    // Es la única excepción a «el pie no enumera las flechas».
    property <[PadHint]> hints-survey: [
        { key: "",      icon: Icons.arrows-left-right, label: @tr("Puntuar") },
        { key: "Start", icon: "", label: @tr("Guardar") },
        { key: "B",     icon: "", label: @tr("Ahora no") },
    ];
    property <[PadHint]> hints-home: [
        { key: "A",     icon: "", label: @tr("Continuar") },
        { key: "Y",     icon: "", label: @tr("Ficha") },
        { key: "Start", icon: "", label: @tr("Menú") },
    ];
    property <[PadHint]> hints-library: [
        { key: "A",     icon: "", label: @tr("Seleccionar") },
        { key: "B",     icon: "", label: @tr("Atrás") },
        { key: "Y",     icon: "", label: @tr("Filtrar") },
        { key: "Start", icon: "", label: @tr("Menú") },
    ];
    // El juego tiene la pantalla y el mando: Play no ofrece NINGÚN botón, y la
    // nota de la izquierda lo dice con todas las letras. Una lista vacía y no un
    // hint apagado: un botón anunciado que no responde es peor que ninguno.
    property <[PadHint]> hints-playing: [];

    // lo que se puede hacer en la superficie que TIENE el foco. Con un
    // modal abierto, unos hints que siguen hablando de la lista mandan a probar
    // teclas que no hacen nada.
    // El vocabulario es el del `.pen`: cada pantalla del diseño trae su
    // ButtonHints y de ahí salen las etiquetas —«Seleccionar», «Atrás»,
    // «Filtrar», «Menú»—, que es lo que hace que dos pantallas no le llamen
    // distinto al mismo botón.
    property <[PadHint]> shell-hints:
        root.pad-surface == "onboarding" || root.pad-surface == "explorador" ? root.onboarding-hints
      : root.pad-surface == "config"       ? root.hints-config
      : root.pad-surface == "ajustes"      ? root.hints-settings
      : root.pad-surface == "guardados"    ? root.hints-saves
      : root.pad-surface == "instalar"     ? root.hints-install
      : root.pad-surface == "controles"    ? root.hints-controls
      : root.pad-surface == "ficha"        ? root.hints-details
      : root.pad-surface == "creditos"     ? root.hints-credits
      : root.pad-surface == "crash"        ? root.hints-crash
      : root.pad-surface == "huerfana"     ? root.hints-orphan
      : root.pad-surface == "encuesta"     ? root.hints-survey
      : root.pad-surface == "jugando"      ? root.hints-playing
      : root.pad-surface == "inicio"       ? root.hints-home
      :                                      root.hints-library;

    in-out property <bool>           menu-open:  false;
    in-out property <bool>           edit-open: false;
    property <string>                order-label:
        order == 1 ? @tr("Orden: Z → A")
      : order == 2 ? @tr("Orden: por consola")
      : order == 3 ? @tr("Orden: recientes")
                   : @tr("Orden: A → Z");
    // cuántas tarjetas entran a lo ancho.
    // Se descuenta la safe area (96 px por lado) porque la grilla vive DENTRO
    // de ella: sin descontarla, la cuenta daba una columna de más y la última
    // quedaba a medias contra el borde, que es exactamente lo que el margen de
    // televisor viene a evitar. Con 1920 la cuenta da las 6 columnas que fija el
    // diseño, y con el ancho de `CardMetrics.width` esas seis ocupan los 1728
    // útiles enteros.
    // La cuenta sale de `CardMetrics` y no de números escritos acá: son las
    // mismas medidas con las que se dibuja cada tarjeta, y dos copias de un
    // ancho es una grilla que cuenta una cosa y dibuja otra.
    // `out` y no privada: el mando la necesita. `pad_router` decide el paso de
    // arriba/abajo con ella y no puede recalcularla —no conoce el ancho
    // de la ventana—, y una segunda cuenta en Rust sería la grilla contando una
    // cosa y el mando otra.
    out property <int>               columns:
        max(1, floor((library-width - 192px + CardMetrics.gap)
                     / (CardMetrics.width + CardMetrics.gap)));
    in-out property <bool>           playing:      false;

    // ---- Navigation ----------------------------------------------------------
    // Las TRES secciones de CE: 0=Inicio · 1=Biblioteca · 2=Ajustes.
    in-out property <int>            active-tab:   0;

    // EL RECORRIDO DE PESTAÑAS, EN UN SOLO LUGAR.
    // El mando ya recorría las secciones con LB/RB porque el paso vive en
    // `pad_router` y es un `match` exhaustivo. El teclado no: cada
    // sección declaraba sus propias transiciones con las flechas, y como las
    // flechas ADEMÁS recorren el contenido, la biblioteca se las quedaba para
    // su grilla y no le dejaba ninguna al chasis. El resultado era un grafo con
    // Ajustes de sumidero —tenía salida y no tenía entrada—: a la sección donde
    // se configuran carpetas, cores e idioma sólo se llegaba clickeando su
    // pestaña.
    // Re-Pág y Av-Pág son el LB/RB del teclado: un par dedicado al recorrido de
    // secciones, separado de las flechas que recorren el contenido. Es la misma
    // separación establecida para el mando, y por eso vale en todas las
    // secciones: una regla con excepciones vuelve a dejar agujeros como el
    // que esto cierra.
    // El paso se acota y no da la vuelta, igual que el router (`Inicio` ignora
    // TabAnterior y `Ajustes` ignora TabSiguiente): en una tira de pestañas
    // visible, envolver del final al principio se ve como un salto y no como un
    // paso. `pad_focus.rs` ata este recorrido al del router.
    // Salir de la ficha es parte del gesto, por lo mismo que el click en la
    // pestaña ya lo hacía y que `IrATab` hace del lado del mando: sin esto la
    // barra marcaría una sección y el cuerpo seguiría mostrando el juego. La
    // del PACK no se toca porque es `in` —la abre y la cierra Rust— y además no
    // hace falta: con ella abierta ninguna de las secciones existe, así
    // que no hay quién reciba la tecla.
    /// Un click en un hint del pie. Lo maneja Rust, que lo convierte a la
    /// MISMA acción del mando (`gamepad::accion_de_hint` → `enrutar`): el pie
    /// es la botonera de los diálogos para quien usa mouse, y un camino de
    /// click propio es como mouse y mando empiezan a hacer cosas distintas.
    callback hint-pressed(string);
    callback go-to-section(int);
    go-to-section(step) => {
        root.active-tab = Math.max(0, Math.min(2, root.active-tab + step));
        root.details-open = false;
    }

    // qué superficie tiene el foco. DERIVADA, no seteada desde Rust:
    // un modal se puede abrir con el mouse, y unos hints que sólo se
    // actualizan cuando alguien mueve el mando mienten justo cuando más
    // importa. El orden de esta cadena es la misma precedencia que
    // `pad_router::superficie()` — `play-ce/tests/pad_focus.rs` los ata para que
    // no puedan divergir.
    out    property <string>         pad-surface:
          playing        ? "jugando"
        : onboarding-open && onboarding-browsing ? "explorador"
        : onboarding-open ? "onboarding"
        : crash-open  ? "crash"
        : orphan-open ? "huerfana"
        : feedback-open  ? "encuesta"
        : credits-open   ? "creditos"
        : saves-open ? "guardados"
        : install-open ? "instalar"
        : controls-open ? "controles"
        : details-open  ? "ficha"
        : detail-open    ? "ficha"
        : config-open    ? "config"
        : active-tab == 2 ? "ajustes"
        : active-tab == 1 ? "biblioteca"
        : "inicio";

    // ---- Continuar vs Jugar ------------------------------------------
    // Una bandera y no dos callbacks de lanzamiento: el camino de lanzar es
    // UNO —el mismo manifest, el mismo lock, el mismo spawn— y lo único que
    // cambia es si se reanuda. Dos caminos serían dos lugares donde arreglar
    // lo que se rompa en uno.
    in-out property <bool>           clean-run: false;

    // ---- «03d · Guardados» -------------------------------------------
    in-out property <bool>           saves-open: false;
    in-out property <int>            saves-row: 0;
    in property <[SaveRow]>      saves-list: [];
    callback saves-restore(int);
    /// Cuándo fue el guardado que «Continuar» va a cargar. Vacío = no hay.
    in     property <string>         details-save: "";
    callback details-play-clean();

    // ---- configuracion previa al lanzamiento ---------------------------
    in     property <bool>              config-open:  false;
    in     property <string>            config-game:  "";
    in     property <[ConfigRowData]>   config-rows:  [];
    in-out property <int>               config-row:   0;
    // Lo que dice el pack: sin el, la pantalla ofreceria opciones que no
    // hacen nada.
    in     property <string>            config-pack:  "";
    // la FICHA del pack — qué es, quién lo hizo y si sirve.
    in     property <[DetailRow]> detail-rows: [];
    in     property <string>      detail-pack: "";
    in     property <string>      detail-compat: "";
    in     property <bool>        detail-playable: true;
    in-out property <bool>        detail-open: false;

    // la opinión, DESPUÉS de jugar. Nunca durante la partida: esta
    // pantalla sólo puede abrirse cuando el runtime ya cerró.
    // ---- el balance de «04b · Sesión terminada» ----------------------
    // Lo que la sesión dejó, contado del disco: tiempo, guardados y capturas.
    // `bal-hubo` decide si las baldosas se muestran — tres ceros son ruido, y
    // se juega sin guardar todo el tiempo.
    in     property <string>            summary-time: "";
    in     property <string>            summary-saves: "";
    in     property <string>            summary-captures: "";
    in     property <bool>              summary-has-activity: false;

    in     property <bool>               feedback-open: false;
    in     property <string>             feedback-pack: "";
    in     property <string>             feedback-played: "";
    in-out property <[FeedbackRowData]>  feedback-rows: [];
    in-out property <int>                feedback-row: 0;
    callback feedback-rate(int, int);    // fila, delta
    callback feedback-send();            // guardar local
    callback feedback-later();           // ahora no
    callback feedback-never();           // no preguntar mas
    // los creditos del pack, sobre la misma pantalla previa.
    in     property <[CreditLineData]> credit-lines: [];
    in-out property <bool>             credits-open: false;
    callback config-adjust(int, int);   // fila, delta (-1 / +1)
    callback config-accept();           // guardar y jugar
    callback config-cancel();
    /// volver a lo que el pack recomienda. Era una fila de la lista.
    callback config-restore();

    // ---- el wizard de primer arranque ---------------------------------
    // Todo lo que decide vive en `onboarding.rs`; estas propiedades son lo que
    // se dibuja y los callbacks son lo que se le pide.
    in     property <bool>     onboarding-open:  false;
    in     property <int>      onboarding-step:         0;    // 0..5
    /// el wizard se abrió desde Ajustes para editar UN paso: no hay
    /// recorrido del que informar avance.
    in     property <bool>     onboarding-single-step:    false;
    in     property <string>   onboarding-heading:      "";
    /// Por que no se puede seguir. Vacio = se puede. Se MUESTRA: un button
    /// apagado sin explicacion es la forma mas comun de dejar a alguien trabado.
    in     property <string>   onboarding-blocker:      "";
    in     property <[OnboardingRow]> onboarding-rows:         [];
    in-out property <int>      onboarding-row:          0;
    /// Los idiomas del paso 1, tal como los nombra `onboarding.rs`, en el orden
    /// en que rota `ciclar_idioma`. Son CHIPS y no una fila que cicla a ciegas:
    /// tres valores excluyentes que se ven todos a la vez (play-ce.pen «00»). El
    /// clic sobre uno manda el delta hasta él, así el mando y el mouse pasan
    /// por la misma función.
    in     property <[string]> onboarding-languages:        [];
    in     property <int>      onboarding-language:         0;
    /// Los botones que este paso usa, tal como los arma `onboarding.rs`: PARES
    /// (tecla, qué hace). Uno por paso y no un texto fijo — el pie genérico era
    /// falso en cuatro de los seis pasos, y un pie que miente manda a probar
    /// teclas muertas.
    in     property <[PadHint]> onboarding-hints:       [];
    in     property <string>   onboarding-gamepad:          "";
    in     property <string>   onboarding-core:         "";
    in     property <string>   onboarding-core-detail:  "";
    /// Qué pasó con el core, en un renglón. Sale del veredicto (`titulo()`), y
    /// por eso no está escrito acá: el mismo texto que el resto de la app.
    in     property <string>   onboarding-core-title:   "";
    /// "ok" | "bad" | "" (todavia no se eligio).
    in     property <string>   onboarding-core-state:   "";
    in     property <string>   onboarding-core-remedy:  "";
    in     property <bool>     onboarding-accept:       false;
    in     property <string>   onboarding-terms-version: "1.0";
    /// los párrafos de los términos, tal como los escribe
    /// `onboarding.rs`. No se escriben acá: el texto que se acepta, el que se
    /// traduce y el que un test revisa por enlaces tienen que ser el mismo.
    in     property <[string]> onboarding-terms:        [];
    /// El día en que se aceptaron, si ya estaban aceptados. Vacío si no.
    in     property <string>   onboarding-accept-date:  "";
    // El explorador, encima del paso.
    in     property <bool>     onboarding-browsing:     false;
    /// Privada: si el wizard ya tomo el foco (ver el Timer de abajo).
    in     property <string>   onboarding-browse-path:  "";
    in     property <[OnboardingRow]> onboarding-browse-rows:  [];
    /// true = se esta eligiendo una CARPETA (aparece «Esta carpeta»).
    in     property <bool>     onboarding-browse-dirs:  true;

    callback onboarding-next();            // Continuar / Empezar (Start)
    callback onboarding-back();            // Atras: paso anterior o cerrar el explorador
    callback onboarding-activate();        // A: actua sobre la fila
    callback onboarding-secondary(int);    // izquierda/derecha sobre la fila
    callback onboarding-activate-secondary();  // Y: quitar la carpeta enfocada
    callback onboarding-step-action();     // X: la accion del paso (agregar carpeta, elegir core)
    callback onboarding-move(int);         // mover el foco (lo acota Rust: sabe cuantas filas hay)

    // ---- Callbacks -----------------------------------------------------------
    callback launch(int);
    callback rescan();

    VerticalLayout {
        spacing: 0px;

        // ---- TopBar h96 (play-ce.pen «chasis 10-foot») --------------------
        // La única barra: logo, las secciones y el estado a la derecha.
        // Medía 64 px con textos de 17 y 13 — el chasis del diseño la lleva a 96
        // con tipos de 28 y 22, que es lo que se lee desde un sillón.
        // Las secciones disponibles permanecen visibles; cuando una acción no
        // está lista, se muestra atenuada con su estado en lugar de ocultarse.
        Rectangle {
            height: 96px;
            background: Tokens.bg-panel;
            // La línea de abajo separa la barra del contenido sin una sombra:
            // a distancia de TV una sombra se pierde y un borde no.
            Rectangle {
                y: parent.height - 1px; height: 1px;
                width: parent.width; background: Tokens.border;
            }

            HorizontalLayout {
                // Safe area horizontal: 96 px (5 % de 1920). En un televisor el
                // borde de la imagen puede quedar fuera de la pantalla, y lo
                // primero que se corta es justo lo que está pegado al margen.
                padding-left: 96px; padding-right: 96px;
                alignment: space-between; spacing: 24px;

                // Left del .pen: el logo de 40 y la marca al lado. La marca va en
                // `text-bright` y no en el acento: el amarillo es del elemento
                // ACTIVO —la pestaña, el chip elegido, el botón primario— y una
                // marca amarilla compite con ellos en cada pantalla. Quien pone
                // el color de la casa acá es el logo.
                // El logo va envuelto en un layout que centra: un hijo de alto
                // fijo dentro de una fila queda pegado ARRIBA, y el isologotipo
                // flotaba por encima de su propia marca.
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        Logo { }
                    }
                    Text {
                        text: "AYTHER PLAY";
                        color: Tokens.text-bright;
                        font-family: Tokens.font-display; font-size: 32px;
                        font-weight: 600; letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }

                // Y las pestañas, por lo mismo: miden 56 en una barra de 96, y
                // sin envolverlas quedaban 20 px más arriba que la marca y que
                // el estado — tres cosas en la misma barra a tres alturas.
                VerticalLayout {
                    alignment: center;
                HorizontalLayout {
                    // la tira es una `tab-list` y cada pestaña una `tab`,
                    // que es lo que hace que se anuncien como «2 de 6» y no como
                    // seis botones sueltos. La atenuada dice que NO está
                    // habilitada, en vez de dejar que el 45 % de opacidad sea
                    // toda la información.
                    accessible-role: tab-list;
                    accessible-label: @tr("Secciones de Play");
                    accessible-item-count: 3;
                    spacing: 8px; alignment: center;
                    // TRES Y NO SEIS. La edición propietaria muestra además
                    // tres secciones dependientes de servicios. Acá NO van a
                    // llegar nunca (ADR-005), y una pestaña atenuada para
                    // siempre es una promesa que la edición no puede cumplir —
                    // peor que no mostrarla, porque manda a buscar cómo activarla.
                    for tab[i] in [
                        { label: @tr("INICIO"),     enabled: true },
                        { label: @tr("BIBLIOTECA"), enabled: true },
                        { label: @tr("AJUSTES"),    enabled: true },
                    ]: Rectangle {
                        // Cualificado: la variable del `for` se llama `tab` y
                        // le gana al nombre del enum.
                        accessible-role: AccessibleRole.tab;
                        accessible-label: tab.label;
                        accessible-enabled: tab.enabled;
                        accessible-item-index: i;
                        accessible-item-selected: root.active-tab == i;
                        accessible-action-default => {
                            root.active-tab = i; root.details-open = false;
                        }
                        height: 56px;
                        // La activa se marca con una BARRA abajo y no con un
                        // fondo: el fondo compite con el acento de la tarjeta
                        // enfocada, y a diez pies dos acentos a la vez no dicen
                        // cuál manda.
                        Rectangle {
                            y: parent.height - 3px; height: 3px;
                            width: parent.width;
                            background: root.active-tab == i ? Tokens.accent : transparent;
                        }
                        // Elegir una sección SALE de la ficha. Sin esto, la
                        // pestaña se marcaba pero el cuerpo seguía mostrando el
                        // juego: la barra decía una cosa y la pantalla otra.
                        tab-touch-area := TouchArea {
                            clicked => { root.active-tab = i; root.details-open = false; }
                        }
                        HorizontalLayout {
                            padding-left: 20px; padding-right: 20px;
                            Text {
                                text: tab.label;
                                // Lo no disponible se atenúa, no se oculta. Y se
                                // distingue por opacidad Y por su pantalla, no
                                // sólo por color.
                                opacity: tab.enabled ? 1.0 : 0.45;
                                color: root.active-tab == i ? Tokens.text-bright
                                     : (tab-touch-area.has-hover ? Tokens.text-normal : Tokens.text-dim);
                                font-family: Tokens.font-display; font-size: 28px;
                                font-weight: 600; letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: end;
                    if playing: HorizontalLayout {
                        spacing: 8px;
                        Icon { text: Icons.game-controller; color: Tokens.success; size: 20px; }
                        Text {
                            text: @tr("En juego"); color: Tokens.success;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            vertical-alignment: center;
                        }
                    }
                    if scanning: HorizontalLayout {
                        spacing: 8px;
                        Icon { text: Icons.magnifying-glass; color: Tokens.accent; size: 20px; }
                        Text {
                            text: @tr("Escaneando…"); color: Tokens.accent;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: status;
                        color: Tokens.text-dim;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // ---- Inicio (play-ce.pen «01» y «01b») ---------------------------
        // Dos bloques, en el orden del diseño: el hero «Continuar» y la fila
        // de recientes.
        // El diseño trae un tercero —«Novedades compatibles»— que anuncia lo
        // que va a haber para descargar. Acá no hay de dónde descargar
        // (ADR-005), así que la tarjeta no está: mostrarla vacía sería ocupar
        // el tercio de abajo de la pantalla de entrada con una promesa que esta
        // edición no puede cumplir.
        if active-tab == 0 && !root.details-open: home-scope := FocusScope {
            key-pressed(event) => {
                // Re-Pág / Av-Pág son el LB/RB del teclado. Van en las
                // TRES secciones: la regla del recorrido no tiene excepciones.
                if event.text == Key.PageUp   { root.go-to-section(-1); return EventResult.accept; }
                if event.text == Key.PageDown { root.go-to-section(1);  return EventResult.accept; }
                if event.text == Key.Return || event.text == " " {
                    if root.has-continue { root.launch-entry(root.continue-game); }
                    return EventResult.accept;
                }
                // Desde la raíz, derecha entra a la biblioteca; izquierda no va
                // a ninguna parte —el paso se acota— y Atrás NUNCA cierra Play (§9).
                if event.text == Key.RightArrow { root.go-to-section(1); return EventResult.accept; }
                if event.text == Key.F5 { rescan(); return EventResult.accept; }
                // Inicio no entra en una pantalla: el hero mide 392 y abajo van
                // recientes y novedades. Arriba/abajo DESPLAZAN, que es lo único
                // que pueden hacer acá —no hay una lista que recorrer— y sin
                // ellas «Novedades» sería inalcanzable sin mouse, que es lo
                // contrario de mostrarla siempre.
                if event.text == Key.DownArrow {
                    home-scope.scroll = Math.min(home-scope.limit,
                                                   home-scope.scroll + 200px);
                    return EventResult.accept;
                }
                if event.text == Key.UpArrow {
                    home-scope.scroll = Math.max(0px, home-scope.scroll - 200px);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            DeferredFocus {
                request-focus: root.pad-surface == "inicio" && !home-scope.has-focus;
                take-focus => { home-scope.focus(); }
            }

            property <length> scroll: 0px;
            property <length> limit:
                Math.max(0px, home-column.preferred-height - self.height);
            property <length> desired: Math.min(self.scroll, self.limit);
            // EL DESPLAZAMIENTO SE ASIGNA, NO SE ATA.
            // Evita el mismo defecto corregido en la grilla, y por el mismo
            // motivo: un Flickable ASIGNA su `viewport-y` en cuanto el puntero
            // lo toca —un clic cuenta, aunque no arrastre un píxel— y en Slint
            // una asignación descarta el binding para siempre. Desde ese
            // momento Inicio dejaba de seguir al foco por el resto de la
            // sesión: bajar con el mando movía un scroll que no se veía.
            // No falla, no avisa, y no aparece probando con el teclado desde el
            // arranque —ahí el binding todavía vive—: hace falta haber tocado
            // la sección con el mouse.
            // El disparador es `scroll` y NO `deseado`: un `changed x` corre
            // mientras Slint evalúa `x`, y leer `deseado` adentro de su propio
            // `changed` re-entra en la propiedad que se está calculando — la
            // ventana muere con «Recursion detected» al primer movimiento del
            // cursor. Por la misma razón no hay `init` que lo aplique de
            // entrada: `tope` mira la altura del contenedor y leerlo con el
            // layout a medio construir es la misma re-entrada. No hace falta,
            // además: Inicio abre arriba de todo, que es donde ya está.
            changed scroll => { home-scroll.viewport-y = -self.desired; }

            home-scroll := Flickable {
                viewport-height: home-column.preferred-height;
                home-column := VerticalLayout {
                    // safe area: 96 h · 54 v (5 % de 1920×1080).
                    padding-left: 96px; padding-right: 96px;
                    padding-top: 54px; padding-bottom: 54px;
                    // 32 y no 40, que es el `gap` del `Page` del .pen.
                    // El 40 no tenía razón escrita en ninguna parte y el .pen sí
                    // es el documento del diseño: donde el código no puede
                    // mostrar que la medida del .pen rompe algo, manda el .pen.
                    // (Con la tarjeta pasa al revés, y ahí la razón está en
                    // `CardMetrics`.)
                    spacing: 32px; alignment: start;

                    // -- El hero, o el estado de biblioteca vacía (01b) --------
                    if root.has-continue: HorizontalLayout {
                        spacing: 40px;
                        Cover {
                            width: 280px; height: 392px;
                            platform: root.continue-game.platform;
                            art: root.continue-game.cover;
                            // Inicio era la única superficie que ofrecía
                            // seguir jugando sin mirar el core: la carátula
                            // brillaba y «Continuar» invitaba, y el juego no
                            // arrancaba. Lo que pinta la grilla tiene que pintar
                            // acá, o el semáforo depende de por dónde entraste.
                            dimmed: StatusLight.core-blocks(root.continue-game.core-state);
                        }
                        VerticalLayout {
                            alignment: center; spacing: 16px;
                            Text {
                                text: @tr("CONTINUAR");
                                color: Tokens.accent;
                                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                                font-weight: 600; letter-spacing: 1px;
                            }
                            Text {
                                text: root.continue-game.name;
                                color: Tokens.text-bright;
                                font-family: Tokens.font-display;
                                font-size: Tokens.text-display-xl;
                                font-weight: 600; letter-spacing: 1.9px;
                                overflow: elide;
                            }
                            Text {
                                text: root.continue-meta;
                                color: Tokens.text-dim;
                                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                overflow: elide;
                            }
                            // Los dos del MISMO alto y centrados: son la misma
                            // decisión —seguir jugando o ir a elegir— y uno 8 px
                            // más bajo que el otro se lee como dos jerarquías
                            // que no existen. El peso lo dice el color.
                            HorizontalLayout {
                                spacing: 16px; alignment: start;
                                Centered {
                                    ActionButton {
                                        label: @tr("Continuar");
                                        icon: Icons.play;
                                        primary: true; big: true;
                                        enabled: !StatusLight.core-blocks(root.continue-game.core-state);
                                        clicked => { root.launch-entry(root.continue-game); }
                                    }
                                }
                                Centered {
                                    ActionButton {
                                        label: @tr("Ver biblioteca");
                                        icon: Icons.squares-four;
                                        big: true;
                                        clicked => { root.active-tab = 1; }
                                    }
                                }
                            }
                        }
                    }

                    // 01b — todavía no hay juegos. Es un estado distinto de «hay
                    // juegos pero ninguno jugado»: aquél manda a agregar ROMs,
                    // éste sólo no tiene qué continuar.
                    if !root.has-continue: VerticalLayout {
                        spacing: 16px; alignment: start;
                        Text {
                            text: root.total-games == 0
                                ? @tr("TODAVÍA NO HAY JUEGOS")
                                : @tr("EMPEZÁ POR DONDE QUIERAS");
                            color: Tokens.text-bright;
                            font-family: Tokens.font-display;
                            font-size: Tokens.text-display-lg;
                            font-weight: 600; letter-spacing: 1.3px;
                        }
                        Text {
                            text: root.total-games == 0
                                ? @tr("Agregá una carpeta con tus ROMs desde Biblioteca o Ajustes › Rutas.")
                                : @tr("Cuando juegues algo, va a aparecer acá para seguir de una.");
                            color: Tokens.text-dim;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body;
                        }
                        HorizontalLayout {
                            alignment: start;
                            go-to-library-area := TouchArea {
                                accessible-role: button;
                                accessible-label: @tr("Ir a Biblioteca");
                                accessible-action-default => { root.active-tab = 1; }

                                width: go-to-library-button.width; height: 56px;
                                clicked => { root.active-tab = 1; }
                                go-to-library-button := ActionButton {
                                    label: @tr("Ir a Biblioteca");
                                    icon: Icons.squares-four;
                                    primary: true; big: true;
                                    clicked => { root.active-tab = 1; }
                                }
                            }
                        }
                    }

                    // -- Recientes --------------------------------------------
                    if root.recent.length > 0: VerticalLayout {
                        spacing: 16px;
                        Text {
                            text: @tr("RECIENTES");
                            color: Tokens.text-bright;
                            font-family: Tokens.font-display;
                            font-size: Tokens.text-display-lg;
                            font-weight: 600; letter-spacing: 1.3px;
                        }
                        HorizontalLayout {
                            spacing: CardMetrics.gap; alignment: start;
                            for g in root.recent: GameCard {
                                game: g;
                                focused: false;
                                activated => { root.launch-entry(g); }
                            }
                        }
                    }

                }
            }
        }

        // ---- Library tab -------------------------------------------------------
        if active-tab == 1 && !root.details-open: fs := FocusScope {
            key-pressed(event) => {
                // Re-Pág / Av-Pág son el LB/RB del teclado. Van en las
                // TRES secciones: la regla del recorrido no tiene excepciones.
                if event.text == Key.PageUp   { root.go-to-section(-1); return EventResult.accept; }
                if event.text == Key.PageDown { root.go-to-section(1);  return EventResult.accept; }
                // A abre la FICHA, no lanza. Antes A iba directo a la
                // configuración previa: una pantalla de ajustes como respuesta a
                // «quiero ver este juego». Ahora el juego tiene su pantalla, y
                // jugar es la primera acción de ahí adentro.
                if event.text == Key.Return || event.text == " " {
                    if games.length > 0 { open-details(games[current-game]); }
                    return EventResult.accept;
                }
                // en grilla, arriba/abajo saltan una FILA entera; en
                // lista siguen siendo de a uno, que es lo que una lista
                // significa. El paso lo decide la VISTA y no la tecla: con un
                // paso fijo de 1, subir en una grilla de seis columnas movía al
                // vecino de al lado y se sentía roto.
                if event.text == Key.UpArrow {
                    if list-view {
                        if current-game > 0 { current-game -= 1; }
                    } else if current-game >= columns {
                        current-game -= columns;
                    }
                    return EventResult.accept;
                }
                if event.text == Key.DownArrow {
                    if list-view {
                        if current-game + 1 < games.length { current-game += 1; }
                    } else if current-game + columns < games.length {
                        current-game += columns;
                    }
                    return EventResult.accept;
                }
                // ←→ RECORREN LA BIBLIOTECA ENTERA Y NUNCA CAMBIAN DE
                // SECCIÓN. De secciones se cambia con LB/RB, que es lo que el
                // chasis anuncia y lo único que hace falta para llegar a todas.
                // Antes ←→ se quedaban dentro de la fila y en el borde saltaban
                // de sección. Eran dos defectos en un solo gesto: la última
                // tarjeta de la fila era un callejón —para seguir había que
                // bajar y volver seis veces a la izquierda— y quien insistía
                // hacia la derecha se encontraba en otra sección sin haberlo
                // pedido, que es la peor manera de descubrir que una tecla hace
                // dos cosas según dónde estés.
                // Ahora la grilla se recorre como lo que es: una sola secuencia
                // de juegos dibujada en filas. La derecha de la última columna
                // es la PRIMERA de la fila de abajo, y en el último juego no
                // pasa nada — un borde que no se mueve dice «no hay más» sin
                // sacar a nadie de donde estaba. Lo mismo a la izquierda.
                // Es además la misma cuenta en las dos vistas: en lista ←→ ya
                // eran ±1, y ahora en grilla también. La VISTA sólo decide el
                // paso de arriba/abajo, que es donde una grilla y una lista de
                // verdad difieren.
                if event.text == Key.LeftArrow {
                    if current-game > 0 { current-game -= 1; }
                    return EventResult.accept;
                }
                if event.text == Key.RightArrow {
                    if current-game + 1 < games.length { current-game += 1; }
                    return EventResult.accept;
                }
                if event.text == Key.F5 { rescan(); return EventResult.accept; }
                // los atajos que el .pen anuncia en ButtonHints:
                // «Y Filtrar» lleva el foco a la búsqueda, «Start Menú» abre el
                // menú del juego. Son los mismos que usa el mando:
                // si el teclado hiciera otra cosa, cada entrada tendría su
                // semántica y sólo se notaría probando las dos.
                if event.text == "y" || event.text == "Y" {
                    search-input.focus(); return EventResult.accept;
                }
                if event.text == "f" || event.text == "F" {
                    if games.length > 0 { game-favorite(current-game); }
                    return EventResult.accept;
                }
                if event.text == "m" || event.text == "M" {
                    if games.length > 0 { menu-open = true; }
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            // al cerrarse el menú o el diálogo, el foco VUELVE acá.
            // Sin esto se queda en el campo de texto del modal que ya no existe,
            // y las flechas dejan de responder: el jugador cierra el diálogo, la
            // pantalla se ve normal y el mando no hace nada. Es exactamente el
            // síntoma que el encabezado de `pad_focus.rs` describe —«se lee como
            // que la aplicación se colgó»— y sólo aparece cerrando un modal, que
            // es lo último que uno prueba.
            // Ya no hace falta un `changed` para eso: la condición de abajo dice
            // «me toca y no lo tengo», y cerrar el modal la vuelve verdadera.
            property <bool> modal-open: root.menu-open || root.edit-open;
            // La BÚSQUEDA es la excepción: mientras se escribe en ella, el foco
            // es suyo. Sin esta condición el timer se lo robaría cada 16 ms y no
            // se podría teclear una palabra entera.
            DeferredFocus {
                request-focus: root.pad-surface == "biblioteca" && !modal-open
                       && !fs.has-focus && !search-input.has-focus;
                take-focus => { fs.focus(); }
            }

            VerticalLayout {
                // El banner se apila ARRIBA de la lista y no la tapa: la nota
                // del diseño pide que la biblioteca se use mientras escanea, y
                // un overlay modal sería lo contrario.
                if root.scanning: ScanBanner {
                    done:      root.scan-done;
                    total:       root.scan-total;
                    found: root.scan-found;
                    cancel       => { root.scan-cancel(); }
                }
                // La FilterBar del diseño (play-ce.pen «02 · Biblioteca»):
                // búsqueda, chips, orden y el conmutador de vista.
                // La nota del .pen habla de un diálogo «02b» para los filtros,
                // pero ese frame no existe en el documento y los cuatro
                // controles que nombra —plataforma, estado, orden, favoritos—
                // están todos acá. Se implementa la superficie que el diseño SÍ
                // tiene, en vez de inventar una pantalla que nadie dibujó.
                HorizontalLayout {
                    // la misma safe area que la grilla de abajo: la
                    // barra de filtros y las tarjetas tienen que arrancar en la
                    // misma línea o el margen se lee como un error.
                    padding-left: 96px; padding-right: 96px;
                    padding-top: 32px; padding-bottom: 8px;
                    spacing: 16px;

                    // Buscar. El foco se pide con Y (ver ButtonHints del .pen).
                    Centered { buscador := Rectangle {
                        width: 420px; height: 48px;
                        background: Tokens.bg-input;
                        border-radius: Tokens.radius-md;
                        border-width: 1px;
                        border-color: search-input.has-focus ? Tokens.accent : Tokens.border;
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 12px;
                            // La lupa del .pen (Input: `magnifying-glass` 24
                            // en text-dim). Se atenúa con el campo vacío y se
                            // enciende con el foco: el campo dice qué es sin
                            // leerlo, que es todo lo que un icono tiene que
                            // hacer a distancia de TV.
                            Icon {
                                text: Icons.magnifying-glass;
                                color: search-input.has-focus ? Tokens.accent : Tokens.text-dim;
                            }
                            // El placeholder va en un Rectangle y no suelto en
                            // el layout: dentro de un layout no se puede
                            // posicionar, y tiene que quedar EXACTAMENTE encima
                            // del cursor de texto.
                            Rectangle {
                                horizontal-stretch: 1;
                                search-input := TextInput {
                                    text <=> root.search;
                                    color: Tokens.text-bright;
                                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                    vertical-alignment: center;
                                    single-line: true;
                                    width: parent.width; height: parent.height;
                                    edited => { root.filter-changed(); }
                                    // Escape limpia la búsqueda ANTES de que
                                    // Atrás cambie de sección: buscar y no
                                    // encontrar nada es el momento donde más se
                                    // quiere volver, y salirse de la biblioteca
                                    // no es volver.
                                    key-pressed(e) => {
                                        if e.text == Key.Escape {
                                            root.search = "";
                                            root.filter-changed();
                                            return EventResult.accept;
                                        }
                                        return EventResult.reject;
                                    }
                                }
                                if root.search == "": Text {
                                    text: @tr("Buscar juego…");
                                    color: Tokens.text-dim;
                                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                            }
                        }
                    } }

                    // Los chips. «Todas» apaga el filtro de plataforma; las
                    // consolas salen de las que HAY en la biblioteca.
                    Centered { Chip {
                        label: @tr("Todas"); active: root.filter-platform == "";
                        clicked => { root.filter-platform = ""; root.filter-changed(); }
                    } }
                    for p in root.platforms: Centered { Chip {
                        label: p; active: root.filter-platform == p;
                        clicked => {
                            root.filter-platform = root.filter-platform == p ? "" : p;
                            root.filter-changed();
                        }
                    } }
                    Centered { Chip {
                        label: @tr("Compatibles"); active: root.filter-compatible;
                        clicked => {
                            root.filter-compatible = !root.filter-compatible;
                            root.filter-changed();
                        }
                    } }
                    Centered { Chip {
                        label: @tr("Favoritos"); active: root.filter-favorites;
                        clicked => {
                            root.filter-favorites = !root.filter-favorites;
                            root.filter-changed();
                        }
                    } }

                    Rectangle { horizontal-stretch: 1; }

                    // Orden. Un botón que CICLA y no un desplegable: son cuatro
                    // opciones y un desplegable con mando cuesta abrir, mover y
                    // confirmar. Ciclar es un botón.
                    Centered { order-button := TouchArea {
                        accessible-role: button;
                        accessible-label: root.order-label;
                        accessible-description: @tr("Ordenar la biblioteca");
                        accessible-action-default => { root.order = Math.mod(root.order + 1, 4);
                            root.filter-changed(); }

                        width: 240px; height: 48px;
                        clicked => {
                            root.order = Math.mod(root.order + 1, 4);
                            root.filter-changed();
                        }
                        Rectangle {
                            background: Tokens.bg-input;
                            border-radius: Tokens.radius-md;
                            border-width: 1px;
                            border-color: order-button.has-hover ? Tokens.accent : Tokens.border;
                            Text {
                                text: root.order-label;
                                color: Tokens.text-normal;
                                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                        }
                    } }

                    // FilterBar > view del .pen: DOS ICONOS de 28, el activo
                    // en el acento. Eran las palabras «Grilla» y «Lista»
                    // porque ninguna fuente de Play traía un glifo de grilla ni
                    // de lista; con Phosphor vendorizada el diseño se cumple
                    // como está escrito. El estado se lee igual sin color: el
                    // dibujo del icono ES la vista que elige.
                    Centered { grid-btn := TouchArea {
                        accessible-role: button;
                        accessible-label: @tr("Vista de grilla");
                        accessible-action-default => { root.list-view = false; root.view-changed(false); }

                        width: 56px; height: Tokens.control-sm;
                        clicked => { root.list-view = false; root.view-changed(false); }
                        Icon {
                            text: Icons.squares-four;
                            size: 28px;
                            color: root.list-view ? Tokens.text-dim : Tokens.accent;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    } }
                    Centered { list-btn := TouchArea {
                        accessible-role: button;
                        accessible-label: @tr("Vista de lista");
                        accessible-action-default => { root.list-view = true; root.view-changed(true); }

                        width: 56px; height: Tokens.control-sm;
                        clicked => { root.list-view = true; root.view-changed(true); }
                        Icon {
                            text: Icons.list;
                            size: 28px;
                            color: root.list-view ? Tokens.accent : Tokens.text-dim;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    } }
                }

                // «0 de 120» y no «no hay juegos»: un filtro olvidado y una
                // biblioteca vacía se ven igual, y sólo uno de los dos tiene
                // arreglo a un clic. Sin esta línea el jugador cree que perdió
                // su biblioteca.
                if root.filter-active: HorizontalLayout {
                    padding-left: 24px; padding-bottom: 8px; spacing: 16px;
                    alignment: start;
                    Text {
                        text: @tr("{} de {} juegos", root.games.length, root.total-games);
                        color: Tokens.text-dim;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        vertical-alignment: center;
                    }
                    clear-filter-area := TouchArea {
                        accessible-role: button;
                        accessible-label: @tr("Quitar filtros");
                        accessible-action-default => { root.search = ""; root.filter-platform = "";
                            root.filter-compatible = false; root.filter-favorites = false;
                            root.filter-changed(); }

                        width: 140px; height: Tokens.control-sm;
                        clicked => {
                            root.search = ""; root.filter-platform = "";
                            root.filter-compatible = false; root.filter-favorites = false;
                            root.filter-changed();
                        }
                        Text {
                            text: @tr("Quitar filtros");
                            color: Tokens.accent;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            font-weight: 500;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }

                if !root.list-view: grid-container := Rectangle {
                    // La grilla se arma por FILAS: el layout de Slint es de un
                    // solo eje y no envuelve, igual que el del .pen —ahí también
                    // hay un frame por fila—. El índice de cada celda se calcula
                    // acá en vez de partir el modelo en Rust, así el reflow al
                    // cambiar el ancho no cuesta un viaje al backend.
                    // EL DEFECTO: sólo `changed width`. Si la ventana ya nace
                    // con su tamaño final —que es lo normal— el ancho nunca
                    // «cambia», el callback no corre y `biblioteca-ancho` se
                    // queda en su valor por defecto. La grilla mostraba cuatro
                    // columnas en una ventana donde entran seis, y nada fallaba:
                    // simplemente sobraba media pantalla.
                    init => { root.library-width = self.width; }
                    changed width => { root.library-width = self.width; }
                    property <int> rows: Math.ceil(root.games.length / root.columns);
                    property <length> step: CardMetrics.height + CardMetrics.gap;
                    property <int> row-focus: Math.floor(root.current-game / root.columns);
                    // La grilla se desplaza SOLA hasta la fila con foco. Sin
                    // esto, bajar con el mando más allá del pliegue mueve una
                    // selección que no se ve: el jugador aprieta abajo y no pasa
                    // nada en pantalla. Se desplaza lo MÍNIMO —sólo si la fila
                    // quedó fuera— para que la vista no salte en cada paso.
                    property <length> limit: Math.max(0px, self.rows * self.step - CardMetrics.gap - self.height + 48px);
                    property <length> desired: Math.min(self.limit, self.row-focus * self.step);
                    // EL DESPLAZAMIENTO SE ASIGNA, NO SE ATA.
                    // El desplazamiento era un BINDING, y un Flickable
                    // ASIGNA su `viewport-y` en cuanto el puntero lo toca —un
                    // clic cuenta, aunque no arrastre un píxel—. En Slint una
                    // asignación descarta el binding para siempre: a partir del
                    // primer clic en cualquier tarjeta, la grilla dejaba de
                    // seguir al foco por el resto de la sesión. Bajar hasta la
                    // última fila movía una selección invisible, que es
                    // exactamente lo que este scroll vino a evitar.
                    // No falla ni avisa, y no se nota probando con el teclado
                    // desde el arranque —ahí el binding todavía está vivo—:
                    // aparece recién cuando alguien tocó la grilla con el mouse.
                    // Es el mismo patrón que ya usa el explorador de carpetas,
                    // por la misma razón.
                    // El disparador es `fila-foco` y NO `deseado`: un
                    // `changed x` corre mientras Slint evalúa `x`, y leer
                    // `deseado` adentro de su propio `changed` re-entra en la
                    // propiedad que se está calculando — la ventana muere con
                    // «Recursion detected» al primer movimiento del cursor.
                    changed row-focus => { game-grid-scroll.viewport-y = -self.desired; }
                    game-grid-scroll := Flickable {
                        viewport-height: grid-rows.preferred-height;
                        // SIN un `init` que lo aplique de entrada, y no por
                        // olvido: leer `deseado` mientras Slint construye el
                        // subárbol entra en el cálculo del layout que todavía no
                        // terminó —`tope` mira la altura del contenedor— y la
                        // ventana muere con «Recursion detected» antes de
                        // dibujar. No hace falta: la grilla abre en el primer
                        // juego, que ya está a la vista.
                        grid-rows := VerticalLayout {
                            // safe area: 96 h · 54 v (5 % de 1920×1080).
                            // En un televisor el borde de la imagen puede quedar
                            // fuera de la pantalla, y lo primero que se corta es
                            // la primera columna de tarjetas.
                            padding-left: 96px; padding-right: 96px;
                            padding-top: 16px; padding-bottom: 54px;
                            spacing: CardMetrics.gap; alignment: start;
                            for row in grid-container.rows:
                            HorizontalLayout {
                                spacing: CardMetrics.gap; alignment: start;
                                for col in root.columns: Rectangle {
                                    property <int> idx: row * root.columns + col;
                                    width: CardMetrics.width;
                                    height: CardMetrics.height;
                                    if idx < root.games.length: GameCard {
                                        game: root.games[idx];
                                        focused: idx == root.current-game;
                                        // el clic en el CONTENIDO devuelve
                                        // el foco al teclado. Sin esto se queda
                                        // donde estaba —típicamente el campo de
                                        // búsqueda, que es lo último que se
                                        // tocó— y a partir de ahí las flechas
                                        // escriben en la búsqueda en vez de
                                        // mover la selección, sin que nada lo
                                        // diga. Los chips NO roban el foco: ahí
                                        // el jugador puede querer seguir
                                        // escribiendo.
                                        clicked   => { root.current-game = idx; fs.focus(); }
                                        activated => { root.open-details(root.games[idx]); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.list-view: ListView {
                    for game[i] in root.games: GameRow {
                        game: game; selected: i == root.current-game;
                        clicked        => { root.current-game = i; fs.focus(); }
                        double-clicked => { root.open-details(game); }
                    }
                }
            }
        }

        // ---- Settings (play-ce.pen «05») ----------------------------------
        if active-tab == 2 && !root.details-open: settings-scope := FocusScope {
            key-pressed(event) => {
                // Re-Pág / Av-Pág son el LB/RB del teclado. Van en las
                // TRES secciones: la regla del recorrido no tiene excepciones.
                if event.text == Key.PageUp   { root.go-to-section(-1); return EventResult.accept; }
                if event.text == Key.PageDown { root.go-to-section(1);  return EventResult.accept; }
                // la vuelta es a la pestaña de AL LADO y no a una
                // fija. Escrito como destino literal, sacar secciones del medio
                // que es exactamente lo que CE hizo— deja el salto apuntando a
                // una que ya no existe. El router lo dice igual (`Ajustes` →
                // `IrATab(1)`, la anterior).
                if event.text == Key.LeftArrow { root.go-to-section(-1); return EventResult.accept; }
                // Y del teclado: la secundaria de la fila, si tiene.
                if event.text == "y" || event.text == "Y" {
                    root.setting-secondary(setting-row); return EventResult.accept;
                }
                // Atrás sube UN nivel, hasta la biblioteca; nunca cierra Play (§9).
                if event.text == Key.Escape || event.text == Key.Backspace {
                    active-tab = 1; return EventResult.accept;
                }
                if event.text == Key.UpArrow {
                    if setting-row > 0 { setting-row -= 1; }
                    return EventResult.accept;
                }
                if event.text == Key.DownArrow {
                    // dos filas más (canal y vuelta atrás). El tope está
                    // acá y la cuenta en `ajustes::FILAS`: son dos, y por eso
                    // `filas_de_ajustes_al_dia` las ata.
                    if setting-row < 9 { setting-row += 1; }
                    return EventResult.accept;
                }
                if event.text == Key.Return || event.text == " " {
                    root.setting-activate(setting-row); return EventResult.accept;
                }
                return EventResult.reject;
            }
            // al cerrarse el wizard que abren «Carpetas de ROMs» y
            // «Cores», el foco VUELVE acá: con el wizard abierto la superficie
            // es «onboarding» y al cerrarse vuelve a ser «ajustes», así que la
            // condición se vuelve verdadera sola. Sin esto el foco se quedaba en
            // un FocusScope que ya no existe y las flechas dejaban de responder.
            DeferredFocus {
                request-focus: root.pad-surface == "ajustes" && !settings-scope.has-focus;
                take-focus => { settings-scope.focus(); }
            }

            // EL TAMANO DE LA VENTANA SE CUIDA ACA — la cuarta vez que el mismo
            // mecanismo muerde (ver «modo local» y la ficha). Slint le pasa a la
            // ventana las restricciones del contenido, y esta seccion son once
            // filas de 88 px de alto FIJO: pedia ~1162 px de minimo contra los
            // 912 del area util, asi que entrar en Ajustes AGRANDABA la ventana
            // 1048 -> 1119 en una pantalla de 1032 de area de trabajo— y salir
            // NO la devolvia. Peor: ni creciendo entraba, porque el escritorio
            // no da mas, y la ultima fila, el pie de teclas y los ButtonHints
            // quedaban fuera de la pantalla.
            // El Flickable es lo que corta esa propagacion: su `viewport-height`
            // es del CONTENIDO y su alto propio lo pone el padre, asi que el
            // minimo deja de subir. Es lo mismo que hacen Inicio, la grilla y la
            // ficha; Ajustes era la unica seccion larga sin uno.
            // La fila enfocada, en coordenadas del contenido. El alto del
            // rotulo se LEE (`ajustes-titulo.height`) en vez de escribirse: es
            // el unico termino que depende de la fuente, y clavarlo a mano
            // desalinearia el seguimiento en cuanto cambie el cuerpo o el
            // idioma estire el texto a dos lineas.
            property <length> settings-row-top:
                54px + settings-title.height + 16px + root.setting-row * 88px;
            // otra vez, y por eso el disparador es `ajuste-fila` y no una
            // derivada: un `changed x` corre mientras Slint evalua `x`, asi que
            // leer adentro la propiedad que se esta calculando re-entra y la
            // ventana muere con «Recursion detected».
            // Solo corrige cuando la fila se salio: mover el foco dentro de lo
            // que ya se ve no mueve la vista. Desplazar en cada pulsacion —
            // dejando la fila siempre al tope, por ejemplo— hace que la lista
            // parezca moverse sola debajo del cursor.
            // `changed` solo dispara sobre propiedades del PROPIO elemento, y
            // `ajuste-fila` vive en root: sin este eco local, el compilador de
            // Slint corta con «Property 'ajuste-fila' does not exist».
            property <int> settings-row-echo: root.setting-row;
            changed settings-row-echo => {
                if (settings-row-top < -settings-scroll.viewport-y) {
                    settings-scroll.viewport-y = -settings-row-top;
                } else if (settings-row-top + 88px
                           > -settings-scroll.viewport-y + settings-scroll.height) {
                    settings-scroll.viewport-y =
                        settings-scroll.height - settings-row-top - 88px;
                }
            }
            settings-scroll := Flickable {
                viewport-height: settings-column.preferred-height;
                // otra vez: el desplazamiento se ASIGNA. Aca el disparador
                // es `ajuste-fila` y no una propiedad derivada — leer adentro de
                // un `changed` la misma propiedad que se esta evaluando re-entra
                // y mata la ventana con «Recursion detected».
                // Sin esto, cortar la propagacion habria sido un arreglo peor
                // que el defecto: la ventana dejaria de crecer y las filas de
                // abajo pasarian a ser invisibles E inalcanzables, con las
                // flechas moviendo un foco que no se ve.
                settings-column := VerticalLayout {
                    // la misma safe area que el resto del chasis.
                    padding-left: 96px; padding-right: 96px;
                    padding-top: 54px; padding-bottom: 54px;
                    spacing: 0px; alignment: start;
                    settings-title := Text {
                        text: @tr("SISTEMA");
                        color: Tokens.text-dim;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        font-weight: 600; letter-spacing: 1px;
                    }
                    Rectangle { height: 16px; }

                    // El click TAMBIÉN mueve el foco a la fila que se tocó: con el
                    // mouse en una fila y el resaltado en otra, el pie («A
                    // Cambiar») estaría hablando de una tercera cosa.
                    SettingRow {
                        label: @tr("Idioma");
                        detail: @tr("Predeterminado · Español · English");
                        value: root.setting-language;
                        origin: @tr("global");
                        focused: root.setting-row == 0;
                        clicked => { root.setting-row = 0; root.setting-activate(0); }
                    }
                    SettingRow {
                        label: @tr("Carpetas de ROMs");
                        detail: root.setting-folders;
                        action: @tr("Editar");
                        focused: root.setting-row == 1;
                        clicked => { root.setting-row = 1; root.setting-activate(1); }
                    }
                    SettingRow {
                        label: @tr("Cores");
                        detail: root.setting-cores;
                        action: @tr("Administrar");
                        focused: root.setting-row == 2;
                        clicked => { root.setting-row = 2; root.setting-activate(2); }
                    }
                    SettingRow {
                        label: @tr("Perfil de salida");
                        detail: @tr("Cómo se ve la imagen: CRT, LCD, píxel exacto…");
                        value: root.setting-output;
                        origin: root.setting-output-origin;
                        focused: root.setting-row == 3;
                        clicked => { root.setting-row = 3; root.setting-activate(3); }
                    }
                    SettingRow {
                        label: @tr("Controles del juego");
                        detail: root.setting-controls;
                        action: @tr("Configurar");
                        focused: root.setting-row == 4;
                        clicked => { root.setting-row = 4; root.setting-activate(4); }
                    }
                    // los packs van con el CONTENIDO, pegados a las
                    // carpetas de ROMs y a los cores: son la misma pregunta
                    // («¿de dónde salen mis cosas?»).
                    SettingRow {
                        label: @tr("Carpeta de packs");
                        detail: root.setting-packs;
                        action: @tr("Elegir");
                        focused: root.setting-row == 5;
                        clicked => { root.setting-row = 5; root.setting-activate(5); }
                    }
                    SettingRow {
                        label: @tr("Instalar un pack desde el disco");
                        detail: @tr("Un .ay que conseguiste por fuera: se audita entero y la versión anterior queda guardada");
                        action: @tr("Instalar");
                        focused: root.setting-row == 6;
                        clicked => { root.setting-row = 6; root.setting-activate(6); }
                    }
                    SettingRow {
                        label: @tr("Carpeta de datos");
                        detail: root.setting-data;
                        enabled: false;
                        focused: root.setting-row == 7;
                    }
                    SettingRow {
                        label: @tr("Exportar mis datos");
                        detail: @tr("Un ZIP con tus guardados y tus preferencias, para llevártelo");
                        action: @tr("Exportar");
                        focused: root.setting-row == 8;
                        clicked => { root.setting-row = 8; root.setting-activate(8); }
                    }
                    SettingRow {
                        label: @tr("Volver a ver la bienvenida");
                        detail: @tr("Onboarding y términos BYOR/BYOC");
                        action: @tr("Abrir");
                        focused: root.setting-row == 9;
                        clicked => { root.setting-row = 9; root.setting-activate(9); }
                    }

                    Rectangle { height: 24px; }
                    // El foco se ve: la fila enfocada se marca con el mismo anillo
                    // que las tarjetas. Sin esto, mover con el mando en una lista de
                    // filas planas no muestra nada.
                    Text {
                        text: @tr("↑↓ elegir   A cambiar   ←→ sección   B atrás");
                        color: Tokens.border;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                    }
                }
            }
        }

        // ---- la ficha de JUEGO (play-ce.pen «03») -----------------------
        // Va DENTRO del chasis, entre la TopBar y el pie, como cualquier otra
        // sección. Estaba afuera —encima de todo, a pantalla completa— y se
        // llevaba puestas las dos barras: sin TopBar no había cómo volver a la
        // biblioteca con el mouse, y sin pie no había quién dijera que «B»
        // vuelve. Una pantalla sin salida visible es una pantalla de la que se
        // sale cerrando la aplicación.
        if root.details-open: ficha-scope := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " {
                    if root.details-playable { root.details-play(); }
                    return EventResult.accept;
                }
                // B / Escape vuelven a la biblioteca. **Nunca cierran Play** (§9).
                if event.text == Key.Escape || event.text == Key.Backspace
                   || event.text == Key.LeftArrow {
                    root.details-open = false; return EventResult.accept;
                }
                if event.text == "x" || event.text == "X" {
                    root.details-toggle-hd(); return EventResult.accept;
                }
                if event.text == "c" || event.text == "C" {
                    root.details-configure(); return EventResult.accept;
                }
                return EventResult.reject;
            }
            DeferredFocus {
                request-focus: root.pad-surface == "ficha" && !ficha-scope.has-focus;
                take-focus => { ficha-scope.focus(); }
            }

            Rectangle {
                background: Tokens.bg-window;
                Flickable {
                    viewport-height: details-column.preferred-height;
                    // El espaciador de la derecha es lo que impide que la ficha
                    // le fije el ancho a la VENTANA. Sus filas son de medidas
                    // fijas —la carátula de 400, las tarjetas de 260, los
                    // botones— así que su ancho máximo era finito (1448), y
                    // Slint le pasa los máximos del contenido a la ventana:
                    // abrir la ficha ENCOGÍA la ventana maximizada de 1920 a
                    // 1448, igual que pasaba con «modo local». Con el
                    // espaciador el máximo vuelve a ser infinito y el contenido
                    // queda donde estaba, alineado a la izquierda.
                    HorizontalLayout {
                    details-column := VerticalLayout {
                        // Page del .pen: safe area 96 a los costados y 54 arriba
                        // y abajo, como el resto del chasis.
                        padding-left: 96px; padding-right: 96px;
                        padding-top: 54px; padding-bottom: 54px;
                        spacing: 32px; alignment: start;

                        // Hero: la carátula a la izquierda y TODO lo demás a la
                        // derecha, en una sola columna. Antes la compatibilidad
                        // y el pack colgaban abajo, cruzando por debajo de la
                        // carátula: media pantalla vacía a la derecha y el ojo
                        // yendo y viniendo entre dos anchos distintos.
                        HorizontalLayout {
                            spacing: 40px; alignment: start;

                            Cover {
                                width: 400px; height: 560px;
                                platform: root.details-game.platform;
                                art: root.details-game.cover;
                                dimmed: StatusLight.core-blocks(root.details-game.core-state);
                            }

                            VerticalLayout {
                                spacing: 32px; alignment: start;
                                horizontal-stretch: 1;

                                // -- El juego, lo que se hace con él y sus datos
                                VerticalLayout {
                                    spacing: 20px;

                                    Text {
                                        text: root.details-game.name;
                                        color: Tokens.text-bright;
                                        font-family: Tokens.font-display;
                                        font-size: Tokens.text-display-xl;
                                        font-weight: 600; letter-spacing: 1.9px;
                                        overflow: elide;
                                    }
                                    // La línea técnica va en la MONO: son datos
                                    // que se comparan carácter a carácter —el
                                    // CRC sobre todo— y una proporcional los
                                    // vuelve ilegibles justo cuando alguien los
                                    // está cotejando.
                                    Text {
                                        text: root.details-tech;
                                        color: Tokens.text-dim;
                                        font-family: Tokens.font-mono;
                                        font-size: Tokens.text-body;
                                    }

                                    // de cuándo es lo que «Continuar» va
                                    // a cargar. Sin la fecha, «Continuar» es una
                                    // promesa sin sujeto: nadie sabe a qué
                                    // partida vuelve.
                                    if root.details-save != "": HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        Icon {
                                            text: Icons.floppy-disk; color: Tokens.accent; size: 20px;
                                        }
                                        Text {
                                            text: root.details-save;
                                            color: Tokens.accent;
                                            font-family: Tokens.font-ui;
                                            font-size: Tokens.text-body-sm;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // actions del .pen: el primario con su
                                    // ícono, el conmutador de HD y los dos
                                    // secundarios.
                                    // LOS CUATRO CENTRADOS, CON `EnMedio`.
                                    // La fila mezcla alturas —el primario mide
                                    // 56, los otros dos botones 48 y el
                                    // conmutador 32— y un `HorizontalLayout` NO
                                    // centra lo que no se estira: cada uno
                                    // quedaba colgado del borde de arriba, así
                                    // que «Configuración» y «Guardados» se leían
                                    // unos píxeles por encima de «Jugar». No es
                                    // un desajuste que se mida: es cuatro cosas
                                    // en una fila que no comparten línea.
                                    // `EnMedio` centra en el alto de la fila, que
                                    // fija el botón más alto. El conmutador ya
                                    // venía envuelto —por esto mismo—; los demás
                                    // no, y por eso se notaba en ellos.
                                    HorizontalLayout {
                                        spacing: 16px; alignment: start;
                                        // Continuar y Partida nueva son
                                        // DOS acciones, no una etiqueta que
                                        // cambia. Con una sola, quien quería
                                        // empezar de nuevo tenía que borrar su
                                        // guardado para conseguirlo — y quien
                                        // quería seguir no sabía si iba a
                                        // seguir.
                                        Centered {
                                            ActionButton {
                                                label: root.details-save != ""
                                                    ? @tr("Continuar") : @tr("Jugar");
                                                icon: Icons.play;
                                                primary: true; big: true;
                                                enabled: root.details-playable;
                                                clicked => { root.details-play(); }
                                            }
                                        }
                                        if root.details-save != "": Centered {
                                            ActionButton {
                                                label: @tr("Partida nueva");
                                                icon: Icons.play;
                                                enabled: root.details-playable;
                                                clicked => { root.details-play-clean(); }
                                            }
                                        }
                                        // EL CONMUTADOR DE HD SE FUE.
                                        // Escribía el perfil de la próxima
                                        // sesión y había que deducir del color
                                        // del riel si el pack estaba puesto.
                                        // Pero lo que se elige no es «original o
                                        // mejorado» dentro de un pack: se elige
                                        // SI EL PACK ESTÁ PUESTO, y eso tiene
                                        // nombre. Ahora se hace desde la sección
                                        // PACK, con un verbo.
                                        // Y dice por qué, ahí mismo. En la ficha
                                        // vieja este motivo aparecía abajo y en
                                        // rojo como la razón de que no se
                                        // pudiera JUGAR; ahora que jugar no
                                        // depende del pack, el mismo texto tiene
                                        // que estar donde está el control que
                                        // desactiva.
                                        Centered {
                                            ActionButton {
                                                label: @tr("Configuración");
                                                icon: Icons.gear-six;
                                                ghost: true;
                                                clicked => { root.details-configure(); }
                                            }
                                        }
                                        // el historial de partidas. Va acá
                                        // y no en Ajustes porque es del JUEGO:
                                        // los guardados de Golden Axe no se
                                        // buscan en una lista de todos los
                                        // guardados de todos los juegos.
                                        Centered {
                                            ActionButton {
                                                label: @tr("Guardados");
                                                icon: Icons.floppy-disk;
                                                ghost: true;
                                                clicked => { root.saves-open = true; }
                                            }
                                        }
                                    }

                                    // la razón de que no se pueda jugar
                                    // ya no se repite acá: vive en la sección
                                    // ESTADO, al lado de su semáforo y a un
                                    // palmo de este botón. Tenerla en los dos
                                    // lugares era la misma frase dos veces en
                                    // una pantalla que justamente estamos
                                    // vaciando de texto.

                                    HorizontalLayout {
                                        spacing: 16px; alignment: start;
                                        StatTile {
                                            label: @tr("Tiempo jugado");
                                            value: root.details-time;
                                        }
                                        StatTile {
                                            label: @tr("Última vez");
                                            value: root.details-last-played;
                                        }
                                        StatTile {
                                            label: @tr("Consola");
                                            value: root.details-game.platform;
                                        }
                                    }
                                }

                                // -- side del .pen: compatibilidad y pack ------
                                VerticalLayout {
                                    spacing: 12px;

                                    // ESTADO: un semáforo, el del core.
                                    // Es la pregunta que decide si se juega, y
                                    // la única que la ficha contesta con un
                                    // badge propio. Las otras dos filas que
                                    // había acá —ROM y pack— no eran hermanas
                                    // suyas: las dos hablaban del pack, y el
                                    // pack tiene su sección abajo.
                                    Text {
                                        text: @tr("ESTADO");
                                        color: Tokens.text-dim;
                                        font-family: Tokens.font-ui;
                                        font-size: Tokens.text-body-sm;
                                        font-weight: 600; letter-spacing: 1px;
                                    }
                                    HorizontalLayout {
                                        alignment: start; spacing: 12px;
                                        Centered {
                                            SemaphoreBadge {
                                                state: root.details-status;
                                                core: root.details-core;
                                                reason: root.details-status-reason;
                                            }
                                        }
                                        Centered {
                                            Text {
                                                text: root.details-status-reason;
                                                color: root.details-playable ? Tokens.text-dim : Tokens.danger;
                                                font-family: Tokens.font-ui;
                                                font-size: Tokens.text-body-sm;
                                                wrap: word-wrap;
                                                max-width: 620px;
                                            }
                                        }
                                    }

                                    Text {
                                        text: @tr("PACK");
                                        color: Tokens.text-dim;
                                        font-family: Tokens.font-ui;
                                        font-size: Tokens.text-body-sm;
                                        font-weight: 600; letter-spacing: 1px;
                                    }
                                    // PackRow del .pen: el `package` del color
                                    // del acento, el nombre y su autor, la firma
                                    // con su `seal-check`, el semáforo y el chip
                                    // que dice que ESTE es el que está puesto.
                                    if root.details-game.has-pack: Rectangle {
                                        height: 72px;
                                        max-width: 900px;
                                        background: Tokens.bg-panel;
                                        border-radius: Tokens.radius-sm;
                                        HorizontalLayout {
                                            padding-left: 16px; padding-right: 16px; spacing: 20px;
                                            Icon {
                                                text: Icons.package; color: Tokens.accent; size: 28px;
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 2px;
                                                horizontal-stretch: 1;
                                                Text {
                                                    text: root.pack-name;
                                                    color: Tokens.text-bright;
                                                    font-family: Tokens.font-ui;
                                                    font-size: Tokens.text-body;
                                                    font-weight: 600; overflow: elide;
                                                }
                                                Text {
                                                    text: root.pack-author;
                                                    color: Tokens.text-dim;
                                                    font-family: Tokens.font-ui;
                                                    font-size: Tokens.text-body-sm;
                                                }
                                            }
                                            // El ícono era un `seal-check` —un
                                            // SELLO— y hablaba de la firma. Acá
                                            // lo que se comprobó es que el
                                            // archivo esté entero, que es otra
                                            // cosa: un sello sobre «no está
                                            // corrupto» le promete al jugador
                                            // una procedencia que nadie miró.
                                            Centered {
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Icon {
                                                        text: root.pack-audit-ok ? Icons.check-circle : Icons.warning;
                                                        color: root.pack-audit-ok ? Tokens.success : Tokens.warning;
                                                        size: 24px;
                                                    }
                                                    Text {
                                                        text: root.pack-audit;
                                                        color: Tokens.text-dim;
                                                        font-family: Tokens.font-ui;
                                                        font-size: Tokens.text-body-sm;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            Centered {
                                                SemaphoreBadge {
                                                    state: root.details-pack-status;
                                                    reason: root.details-pack-reason;
                                                }
                                            }
                                            // el estado, y al lado el
                                            // VERBO. El chip dice en qué está el
                                            // pack —activo, apagado, no se puede
                                            // usar— y el botón dice qué va a
                                            // pasar si se aprieta. Antes el chip
                                            // era las dos cosas a la vez, así
                                            // que el jugador tenía que adivinar
                                            // si «Activo» era un estado o una
                                            // orden.
                                            Centered {
                                                Chip {
                                                    label: root.details-pack-usage;
                                                    active: root.details-pack-usage-status == 1;
                                                }
                                            }
                                            if root.details-pack-action != "": Centered {
                                                ActionButton {
                                                    label: root.details-pack-action;
                                                    clicked => { root.details-pack-act(); }
                                                }
                                            }
                                        }
                                    }
                                    // y POR QUÉ, con todas las palabras,
                                    // acá abajo. Es donde aterrizó la frase que
                                    // antes decía el eje ROM: «el pack se horneó
                                    // para otra ROM» habla del pack, no de la
                                    // ROM del jugador, y sólo se entiende
                                    // pegada al pack del que habla.
                                    if root.details-pack-reason != "": Text {
                                        text: root.details-pack-reason;
                                        color: Tokens.text-dim;
                                        font-family: Tokens.font-ui;
                                        font-size: Tokens.text-body-sm;
                                        wrap: word-wrap;
                                        max-width: 900px;
                                    }
                                    // Sin pack NO se esconde la sección: que
                                    // exista y diga que no hay es lo que enseña
                                    // que puede haber.
                                    if !root.details-game.has-pack: HorizontalLayout {
                                        alignment: start; spacing: 16px;
                                        Centered {
                                            Text {
                                                text: @tr("No hay pack para este juego — se juega el original.");
                                                color: Tokens.text-dim;
                                                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                            }
                                        }
                                        // y la sección OFRECE conseguir
                                        // uno. Decir que no hay y no decir dónde
                                        // se consigue es enseñar que puede haber
                                        // y dejar al jugador buscándolo.
                                        Centered {
                                            ActionButton {
                                                label: root.details-pack-action;
                                                icon: Icons.package;
                                                clicked => { root.details-pack-act(); }
                                            }
                                        }
                                    }

                                    // Y SIN PACK, LA SECCIÓN TERMINA ACÁ.
                                    // En la edición propietaria este es el lugar
                                    // donde el catálogo remoto contesta qué hay
                                    // para esta ROM. CE no tiene a quién preguntarle
                                    // (ADR-005), y la
                                    // diferencia se dice en positivo: el juego
                                    // se juega igual. Un «no se pudo consultar»
                                    // sería mentira —no hubo consulta— y se
                                    // leería como una falla de red que manda a
                                    // reintentar algo que acá no existe.
                                    if root.details-no-pack: VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: @tr("Sin pack: se juega el original, completo.");
                                            color: Tokens.text-normal;
                                            font-family: Tokens.font-ui;
                                            font-size: Tokens.text-body;
                                        }
                                        Text {
                                            text: @tr("Un pack HD es un archivo .ay que conseguís por fuera. Instalalo desde acá, o dejalo en tu carpeta de packs y aparece solo.");
                                            color: Tokens.text-dim;
                                            font-family: Tokens.font-ui;
                                            font-size: Tokens.text-body-sm;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        // ---- ButtonHints h72 -------------------------------------------
        // Lo que hace cada botón del mando en ESTA pantalla. Medía 48 px con
        // textos de 12 y 13 — el chasis lo lleva a 72 con la talla base, porque
        // un pie que no se lee es un pie que no está: quien no sabe con qué
        // sale de una pantalla prueba teclas hasta que algo pasa.
        ButtonHints {
            // Los clicks van al router del mando: el pie es la botonera de los
            // diálogos (por eso su velo no lo tapa), y con el mouse tiene que
            // hacer EXACTAMENTE lo que anuncia.
            pressed(key) => { root.hint-pressed(key); }
            // Lo que pasa: el juego con foco, o cuántos packs hay. El pie del
            // diseño no lo trae —sus pantallas son maquetas y no tienen estado—
            // pero es la única línea que dice sobre QUÉ actúan los botones de
            // al lado.
            note: root.pad-surface == "jugando"
                ? @tr("El mando lo maneja el juego")
                // El atajo de comparación se DICE acá y no se descubre jugando:
                // es la operación que más explica el producto y la que nadie
                // encuentra sola. Vivía adentro del diálogo previo, que es
                // justo la pantalla que se está por dejar.
                : root.pad-surface == "config"
                ? @tr("En el juego: F2 compara con el original    F12 saca la captura")
                : (games.length > 0 ? games[root.current-game].name
                                    : @tr("Agregá ROMs a tu biblioteca"));
            hints: root.shell-hints;
        }
    }

    // ---- menú de juego (play-ce.pen «02d») y editar metadatos --------
    // Van al final del árbol para quedar ENCIMA de todo, y sobre un velo que
    // captura los clics: un menú que se ve pero deja tocar lo de atrás es la
    // clase de cosa que se descubre borrando el juego equivocado.
    // El velo cubre EL CUERPO: la TopBar sigue diciendo dónde estás y el pie
    // sigue siendo la botonera del diálogo — regla general de los diálogos.
    if root.menu-open || root.edit-open: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;
        TouchArea { clicked => { root.menu-open = false; } }
    }

    if root.menu-open && root.games.length > 0: Rectangle {
        width: 480px;
        height: menu-column.preferred-height;
        x: (parent.width - self.width) / 2;
        y: Shell.topbar + (parent.height - Shell.topbar - Shell.footer - self.height) / 2;
        background: Tokens.bg-elevated;
        border-radius: Tokens.radius-lg;
        border-width: 1px; border-color: Tokens.border;

        menu-column := VerticalLayout {
            padding: 16px; spacing: 6px;
            Text {
                text: root.games[root.current-game].name;
                color: Tokens.text-bright;
                font-family: Tokens.font-ui; font-size: Tokens.text-display-md;
                font-weight: 600; overflow: elide;
            }
            Text {
                text: root.games[root.current-game].platform
                    + (root.games[root.current-game].region == "" ? ""
                       : " · " + root.games[root.current-game].region);
                color: Tokens.text-dim;
                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
            }
            Rectangle { height: 1px; background: Tokens.border-soft; }

            MenuItem {
                label: @tr("Jugar");
                icon: Icons.play;
                enabled: !StatusLight.core-blocks(root.games[root.current-game].core-state);
                clicked => { root.menu-open = false; root.launch(root.current-game); }
            }
            MenuItem {
                label: root.games[root.current-game].favorite
                    ? @tr("Quitar de favoritos") : @tr("Favorito");
                icon: Icons.star;
                clicked => {
                    root.game-favorite(root.current-game);
                    root.menu-open = false;
                }
            }
            // Del diseño, todavía sin implementación: se muestran GRISES en
            // vez de faltar. Una fila que desaparece se lee como «esta
            // versión no lo tiene»; una gris dice «todavía no», que es la
            // verdad — llegan con la ficha de juego y los ajustes
            //.
            MenuItem { label: @tr("Elegir pack"); icon: Icons.package; enabled: false; }
            MenuItem { label: @tr("Elegir core"); icon: Icons.cpu;     enabled: false; }
            MenuItem {
                label: @tr("Editar metadatos");
                icon: Icons.pencil-simple;
                clicked => { root.menu-open = false; root.edit-open = true; }
            }
            if root.games[root.current-game].edited: MenuItem {
                label: @tr("Restaurar valores automáticos");
                icon: Icons.arrow-counter-clockwise;
                clicked => {
                    root.game-restore(root.current-game);
                    root.menu-open = false;
                }
            }
            MenuItem {
                label: root.games[root.current-game].hidden
                    ? @tr("Mostrar") : @tr("Ocultar");
                icon: Icons.eye-slash;
                clicked => {
                    root.game-hide(root.current-game);
                    root.menu-open = false;
                }
            }
        }
    }

    if root.edit-open && root.games.length > 0: Rectangle {
        width: 640px;
        height: edit-column.preferred-height;
        x: (parent.width - self.width) / 2;
        y: Shell.topbar + (parent.height - Shell.topbar - Shell.footer - self.height) / 2;
        background: Tokens.bg-elevated;
        border-radius: Tokens.radius-lg;
        border-width: 1px; border-color: Tokens.border;

        edit-column := VerticalLayout {
            padding: 24px; spacing: 16px;
            Text {
                text: @tr("Editar metadatos");
                color: Tokens.text-bright;
                font-family: Tokens.font-display; font-size: Tokens.text-display-md;
            }
            // Lo AUTOMÁTICO a la vista, siempre. Es lo que hace evidente que
            // editar no lo destruye — y lo que deja comparar antes de
            // decidir si vale la pena cambiarlo.
            Text {
                text: @tr("Detectado: {}", root.games[root.current-game].name);
                color: Tokens.text-dim;
                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                overflow: elide;
            }
            Rectangle {
                height: 56px;
                background: Tokens.bg-input;
                border-radius: Tokens.radius-md;
                border-width: 1px;
                border-color: title-input.has-focus ? Tokens.accent : Tokens.border;
                title-input := TextInput {
                    x: 16px; width: parent.width - 32px; height: parent.height;
                    color: Tokens.text-bright;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                    vertical-alignment: center; single-line: true;
                    text: root.games[root.current-game].name;
                    accepted => {
                        root.game-edit(root.current-game, self.text);
                        root.edit-open = false;
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px; alignment: end;
                cancel-edit-area := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("Cancelar");
                    accessible-action-default => { root.edit-open = false; }

                    width: 160px; height: Tokens.control-md;
                    clicked => { root.edit-open = false; }
                    Rectangle {
                        border-radius: Tokens.radius-md;
                        border-width: 1px; border-color: Tokens.border;
                        background: cancel-edit-area.has-hover ? Tokens.overlay-hi : transparent;
                        Text {
                            text: @tr("Cancelar"); color: Tokens.text-normal;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
                save-edit-area := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("Guardar");
                    accessible-action-default => { root.game-edit(root.current-game, title-input.text);
                        root.edit-open = false; }

                    width: 160px; height: Tokens.control-md;
                    clicked => {
                        root.game-edit(root.current-game, title-input.text);
                        root.edit-open = false;
                    }
                    Rectangle {
                        border-radius: Tokens.radius-md;
                        background: save-edit-area.has-hover ? Tokens.accent-hi : Tokens.accent;
                        Text {
                            text: @tr("Guardar"); color: Tokens.accent-fg;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }
    }

    // ---- confirmación destructiva ------------------------------------
    // Dice qué se CONSERVA, no qué se borra. Sin eso, «quitar carpeta» se lee
    // como «borrar mis ROMs» y quien tiene su biblioteca ahí no lo aprieta
    // nunca — o lo aprieta y pasa un mal rato.
    if confirm-open: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;
        TouchArea { clicked => { root.confirm-open = false; } }
    }
    if confirm-open: Rectangle {
        width: 640px; height: confirmation-column.preferred-height;
        x: (parent.width - self.width) / 2;
        y: Shell.topbar + (parent.height - Shell.topbar - Shell.footer - self.height) / 2;
        background: Tokens.bg-elevated;
        border-radius: Tokens.radius-lg;
        border-width: 1px; border-color: Tokens.border;
        confirmation-column := VerticalLayout {
            padding: 24px; spacing: 16px;
            Text {
                text: root.confirm-title;
                color: Tokens.text-bright;
                font-family: Tokens.font-display; font-size: Tokens.text-display-md;
            }
            Text {
                text: root.confirm-keeps;
                color: Tokens.text-normal;
                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                wrap: word-wrap; width: 592px;
            }
            HorizontalLayout {
                spacing: 12px; alignment: end;
                cancel-confirmation-area := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("Cancelar");
                    accessible-action-default => { root.confirm-open = false; }

                    width: 160px; height: Tokens.control-md;
                    clicked => { root.confirm-open = false; }
                    Rectangle {
                        border-radius: Tokens.radius-md;
                        border-width: 1px; border-color: Tokens.border;
                        background: cancel-confirmation-area.has-hover ? Tokens.overlay-hi : transparent;
                        Text {
                            text: @tr("Cancelar"); color: Tokens.text-normal;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
                confirm-area := TouchArea {
                    accessible-role: button;
                    accessible-label: root.confirm-action;
                    accessible-action-default => { root.confirm-accept(); root.confirm-open = false; }

                    width: 240px; height: Tokens.control-md;
                    clicked => { root.confirm-accept(); root.confirm-open = false; }
                    Rectangle {
                        border-radius: Tokens.radius-md;
                        background: confirm-area.has-hover ? Tokens.accent-hi : Tokens.accent;
                        Text {
                            text: root.confirm-action; color: Tokens.accent-fg;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }
    }

    // ---- «03d · Guardados» -------------------------------------------
    // La lista de versiones, con la promesa de qué pasa al restaurar. Restaurar
    // NO reemplaza: agrega una versión nueva con el contenido de la vieja, y la
    // que estaba en curso sigue en el historial. Decirlo acá es lo que
    // hace que alguien se anime a apretarlo — sin la promesa, «restaurar» se
    // lee como «perder lo que tengo ahora».
    if saves-open: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;
        TouchArea { clicked => { root.saves-open = false; } }
    }
    if saves-open: Rectangle {
        width: 900px; height: saves-column.preferred-height;
        x: (parent.width - self.width) / 2;
        y: Shell.topbar + (parent.height - Shell.topbar - Shell.footer - self.height) / 2;
        background: Tokens.bg-elevated;
        border-radius: Tokens.radius-lg;
        border-width: 1px; border-color: Tokens.border;
        saves-column := VerticalLayout {
            padding: 28px; spacing: 20px;
            Text {
                text: @tr("GUARDADOS");
                color: Tokens.text-bright;
                font-family: Tokens.font-display; font-size: Tokens.text-display-md;
                font-weight: 600; letter-spacing: 0.8px;
            }

            if root.saves-list.length == 0: Text {
                text: @tr("Todavía no hay ninguna partida guardada de este juego.");
                color: Tokens.text-dim;
                font-family: Tokens.font-ui; font-size: Tokens.text-body;
            }

            VerticalLayout {
                spacing: 4px;
                for g[i] in root.saves-list: Rectangle {
                    height: 56px;
                    border-radius: Tokens.radius-md;
                    background: i == root.saves-row ? Tokens.accent-tint : transparent;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 16px;
                        alignment: start;
                        Text {
                            // La actual se distingue por PALABRA además del
                            // color: a distancia de TV el color solo no basta,
                            // y esta es la fila que no hay que confundir.
                            text: i == 0 ? @tr("Actual") : @tr("Anterior");
                            color: i == 0 ? Tokens.accent : Tokens.text-dim;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            vertical-alignment: center;
                            width: 120px;
                        }
                        Text {
                            text: g.when;
                            color: Tokens.text-bright;
                            font-family: Tokens.font-mono; font-size: Tokens.text-body;
                            vertical-alignment: center;
                            width: 240px;
                        }
                        Text {
                            text: g.detail;
                            color: Tokens.text-dim;
                            font-family: Tokens.font-mono; font-size: Tokens.text-body-sm;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.saves-row = i; } }
                }
            }

            // La promesa, ARRIBA del botón y no en el pie: es lo que decide si
            // alguien lo aprieta.
            Rectangle {
                height: restore-alert-layout.preferred-height;
                background: Tokens.overlay-hi;
                border-radius: Tokens.radius-md;
                restore-alert-layout := HorizontalLayout {
                    padding: 20px; spacing: 16px;
                    Icon {
                        text: Icons.warning; color: Tokens.warning; size: 32px;
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("Restaurar no borra nada");
                            color: Tokens.text-bright;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("La versión que estás jugando se conserva en el historial, con su fecha. La ROM no se modifica.");
                            color: Tokens.text-dim;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            wrap: word-wrap; width: 700px;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px; alignment: end;
                close-saves-area := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("Cerrar");
                    accessible-action-default => { root.saves-open = false; }

                    width: 220px; height: Tokens.control-md;
                    clicked => { root.saves-open = false; }
                    Rectangle {
                        border-radius: Tokens.radius-md;
                        border-width: 1px; border-color: Tokens.border;
                        background: close-saves-area.has-hover ? Tokens.overlay-hi : transparent;
                        Text {
                            text: @tr("Cerrar"); color: Tokens.text-normal;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
                restore-save-area := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("Restaurar");
                    accessible-action-default => { root.saves-restore(root.saves-row); }

                    width: 300px; height: Tokens.control-md;
                    // Restaurar la que YA es la actual no hace nada: duplicaría
                    // la partida en curso y la lista diría dos veces lo mismo.
                    enabled: root.saves-row > 0;
                    clicked => { root.saves-restore(root.saves-row); }
                    Rectangle {
                        border-radius: Tokens.radius-md;
                        background: !restore-save-area.enabled ? Tokens.bg-panel
                                  : restore-save-area.has-hover ? Tokens.accent-hi : Tokens.accent;
                        Text {
                            text: @tr("Restaurar");
                            color: !restore-save-area.enabled ? Tokens.text-dim : Tokens.accent-fg;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }
    }

    // ---- Controles del juego -----------------------------------------------
    if controls-open: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;
    }
    if controls-open: ctl-scope := FocusScope {
        width: 720px;
        height: controls-column.preferred-height;
        x: (parent.width - self.width) / 2;
        y: Shell.topbar + (parent.height - Shell.topbar - Shell.footer - self.height) / 2;

        key-pressed(event) => {
            // CAPTURANDO UNA TECLA, la tecla es la respuesta: se nombra y se
            // manda, no se rutea. Escape es la única reservada — cancela.
            if (root.controls-capture == 1) {
                if (event.text == Key.Escape) { root.controls-close(); return EventResult.accept; } // capturando: Retroceso se asigna, no vuelve
                root.controls-key(
                    event.text == Key.UpArrow ? "Up"
                  : event.text == Key.DownArrow ? "Down"
                  : event.text == Key.LeftArrow ? "Left"
                  : event.text == Key.RightArrow ? "Right"
                  : event.text == Key.Return ? "Return"
                  : event.text == Key.Tab ? "Tab"
                  : event.text == Key.Backspace ? "Backspace"
                  : event.text == Key.Shift ? "Left Shift"
                  : event.text == Key.ShiftR ? "Right Shift"
                  : event.text == Key.Control ? "Left Ctrl"
                  : event.text == Key.Alt ? "Left Alt"
                  : event.text);
                return EventResult.accept;
            }
            // Capturando un botón, el teclado sólo puede arrepentirse.
            if (root.controls-capture == 2) {
                if (event.text == Key.Escape) { root.controls-close(); } // capturando: solo Esc cancela
                return EventResult.accept;
            }
            if (event.text == Key.UpArrow)   { root.controls-move(-1); return EventResult.accept; }
            if (event.text == Key.DownArrow) { root.controls-move(1);  return EventResult.accept; }
            if (event.text == Key.Return || event.text == " ") {
                root.controls-capture-key(); return EventResult.accept;
            }
            if (event.text == "x" || event.text == "X") {
                root.controls-capture-button(); return EventResult.accept;
            }
            if (event.text == "y" || event.text == "Y") {
                root.controls-restore(); return EventResult.accept;
            }
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.controls-close(); return EventResult.accept;
            }
            return EventResult.reject;
        }
        DeferredFocus {
            request-focus: root.pad-surface == "controles" && !ctl-scope.has-focus;
            take-focus => { ctl-scope.focus(); }
        }

        Rectangle {
            background: Tokens.bg-elevated;
            border-radius: Tokens.radius-lg;
            border-width: 1px; border-color: Tokens.border;

            controls-column := VerticalLayout {
                padding: 28px; spacing: 12px;
                Text {
                    text: @tr("CONTROLES DEL JUEGO");
                    color: Tokens.text-bright;
                    font-family: Tokens.font-display; font-size: Tokens.text-display-md;
                    font-weight: 600; letter-spacing: 0.8px;
                }
                Text {
                    // Qué configura ESTO, dicho antes de tocar nada: la
                    // partida, no los menús del launcher.
                    text: @tr("Qué hace cada tecla y cada botón dentro de la partida. La cruceta no se cambia: es dirección.");
                    color: Tokens.text-dim;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                    wrap: word-wrap;
                }

                // El encabezado de las columnas.
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: @tr("Acción"); width: 200px;
                        color: Tokens.text-dim;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        font-weight: 600;
                    }
                    Text {
                        text: @tr("Tecla"); width: 180px;
                        color: Tokens.text-dim;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        font-weight: 600;
                    }
                    Text {
                        text: @tr("Botón");
                        color: Tokens.text-dim;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        font-weight: 600;
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    for row[fi] in root.controls-rows: Rectangle {
                        height: 40px;
                        border-radius: Tokens.radius-md;
                        background: root.controls-row == fi ? Tokens.accent-tint : transparent;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 16px;
                            Text {
                                text: row.action; width: 200px;
                                color: root.controls-row == fi ? Tokens.accent : Tokens.text-normal;
                                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                                vertical-alignment: center;
                            }
                            Text {
                                // Capturando, la celda con foco lo dice ahí
                                // mismo: es donde el ojo ya está mirando.
                                text: root.controls-row == fi && root.controls-capture == 1
                                    ? @tr("apretá una tecla…") : row.key;
                                width: 180px;
                                color: root.controls-row == fi && root.controls-capture == 1
                                    ? Tokens.accent : Tokens.text-bright;
                                font-family: Tokens.font-mono; font-size: Tokens.text-body-sm;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.controls-row == fi && root.controls-capture == 2
                                    ? @tr("apretá un botón…") : row.button;
                                color: row.no-button ? Tokens.text-dim
                                    : root.controls-row == fi && root.controls-capture == 2
                                    ? Tokens.accent : Tokens.text-bright;
                                font-family: Tokens.font-mono; font-size: Tokens.text-body-sm;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        TouchArea {
                            clicked => {
                                root.controls-row = fi;
                                root.controls-move(0);
                                root.controls-capture-key();
                            }
                        }
                    }
                }

                // Cancelar una captura es Escape; que lo diga la pantalla y no
                // la memoria.
                if root.controls-capture != 0: Text {
                    text: root.controls-capture == 1
                        ? @tr("Esperando una tecla del teclado — Esc cancela")
                        : @tr("Esperando un botón del mando — Esc cancela");
                    color: Tokens.text-dim;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                }
            }
        }
    }

    // ---- un pack entra desde el disco --------------------------------
    // El velo come los clicks (lo trae `Velo`), pero NO cierra: debajo puede
    // estar la ficha o Ajustes, y un click perdido que descarta el resultado
    // de una instalación deja al jugador sin saber qué pasó.
    if install-open: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;
    }
    if install-open: inst-scope := FocusScope {
        width: 760px;
        height: install-column.preferred-height;
        x: (parent.width - self.width) / 2;
        y: Shell.topbar + (parent.height - Shell.topbar - Shell.footer - self.height) / 2;

        key-pressed(event) => {
            if event.text == Key.UpArrow   { root.install-move(-1); return EventResult.accept; }
            if event.text == Key.DownArrow { root.install-move(1);  return EventResult.accept; }
            if event.text == Key.Return || event.text == " " {
                root.install-activate(root.install-row); return EventResult.accept;
            }
            if event.text == "x" || event.text == "X" { root.install-action(); return EventResult.accept; }
            if event.text == "y" || event.text == "Y" { root.install-revert(); return EventResult.accept; }
            if event.text == Key.Escape || event.text == Key.Backspace {
                root.install-close(); return EventResult.accept;
            }
            return EventResult.reject;
        }
        DeferredFocus {
            request-focus: root.pad-surface == "instalar" && !inst-scope.has-focus;
            take-focus => { inst-scope.focus(); }
        }

        Rectangle {
            background: Tokens.bg-elevated;
            border-radius: Tokens.radius-lg;
            border-width: 1px; border-color: Tokens.border;

            install-column := VerticalLayout {
                padding: 28px; spacing: 16px;
                Text {
                    text: root.install-phase == 2 ? root.install-title
                        : root.install-folder-mode ? @tr("ELEGÍ TU CARPETA DE PACKS")
                                                     : @tr("INSTALAR UN PACK DESDE EL DISCO");
                    color: Tokens.text-bright;
                    font-family: Tokens.font-display; font-size: Tokens.text-display-md;
                    font-weight: 600; letter-spacing: 0.8px;
                    overflow: elide;
                }

                if root.install-phase == 0: Rectangle {
                    height: 480px;
                    ExplorerList {
                        location: root.install-path;
                        rows: root.install-rows;
                        focus-index: root.install-row;
                        choose(fi) => { root.install-activate(fi); }
                    }
                }
                // Vacío no es roto, y se dice: una lista sin filas (más allá de
                // «..») con un filtro puesto necesita explicar el filtro.
                if root.install-phase == 0 && !root.install-folder-mode
                   && root.install-rows.length <= 1: Text {
                    text: @tr("Acá no hay ningún pack: se buscan archivos .ay.");
                    color: Tokens.text-dim;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                }

                // Auditar un .ay de cientos de MB se SIENTE: sin esta fase el
                // diálogo se congela después de A y parece colgado.
                if root.install-phase == 1: Text {
                    text: @tr("Auditando e instalando… El archivo se comprueba entero antes de tocar nada.");
                    color: Tokens.text-normal;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                    wrap: word-wrap;
                }

                if root.install-phase == 2: Text {
                    text: root.install-detail;
                    color: Tokens.text-normal;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                    wrap: word-wrap;
                }
                // Lo que CE NO puede decir, dicho donde se decide instalar: la
                // auditoría contesta «¿está entero?», no «¿de quién es?». Un
                // candado acá entrenaría a confiar (ADR-005).
                if root.install-phase == 2: Text {
                    text: @tr("La auditoría dice que el archivo está completo, no de quién es: eso CE no puede saberlo.");
                    color: Tokens.text-dim;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ---- el juego se cerró inesperadamente ---------------------------
    // Un camino solo. Volver a apretar A relanzaría exactamente lo mismo, así
    // que volvería a fallar; la salida es el modo seguro, que es este manifest
    // sin lo que pudo causarlo. La promesa de qué se conserva va ARRIBA del
    // botón y no en el pie: es lo que decide si alguien lo aprieta.
    if crash-open: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;
        TouchArea { clicked => { root.crash-open = false; } }
    }
    if crash-open: TenFootDialog {
        x: (parent.width - self.width) / 2;
        y: Shell.topbar + (parent.height - Shell.topbar - Shell.footer - self.height) / 2;
        title: @tr("EL JUEGO SE CERRÓ INESPERADAMENTE");
        left-button-label: @tr("Cerrar");
        right-button-label: @tr("Modo seguro");
        left-clicked => { root.crash-open = false; }
        right-clicked => { root.crash-safe-mode(); root.crash-open = false; }
        TenFootAlert {
            title: @tr("Reiniciar en modo seguro");
            detail: @tr("Se lanza sin pack, sin shaders y sin overrides. La ROM y tus guardados quedan intactos.");
        }
        Text {
            text: root.crash-detail;
            color: Tokens.text-dim;
            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
            wrap: word-wrap; width: 704px;
        }
    }

    // ---- sesión sin cerrar -------------------------------------------
    // Si Play murió con el juego abierto, la carpeta quedó sin cerrar y su
    // savestate quedó sin dueño. Aparece al arrancar, una vez, y las dos
    // salidas dicen qué hacen: descartar borra ESA CARPETA y nada más.
    if orphan-open: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;
    }
    if orphan-open: TenFootDialog {
        x: (parent.width - self.width) / 2;
        y: Shell.topbar + (parent.height - Shell.topbar - Shell.footer - self.height) / 2;
        title: @tr("SESIÓN SIN CERRAR");
        left-button-label: @tr("Descartar");
        left-danger: true;
        right-button-label: @tr("Recuperar");
        left-clicked => { root.orphan-discard(); }
        right-clicked => { root.orphan-recover(); }
        Text {
            text: root.orphan-text;
            color: Tokens.text-normal;
            font-family: Tokens.font-ui; font-size: Tokens.text-body;
            wrap: word-wrap; width: 704px;
        }
        if root.orphan-save != "": Rectangle {
            height: 56px;
            background: Tokens.overlay-hi;
            border-radius: Tokens.radius-md;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 16px;
                alignment: start;
                Text {
                    text: root.orphan-save;
                    color: Tokens.text-bright;
                    font-family: Tokens.font-mono; font-size: Tokens.text-body-sm;
                    vertical-alignment: center;
                }
            }
        }
        // Qué se conserva, dicho antes de apretar. Sin esto «descartar» se lee
        // como «borrar mi partida», y es justo lo que NO hace.
        Text {
            text: @tr("Descartar borra sólo el registro de esa sesión. La ROM, la SRAM y tus guardados no se tocan.");
            color: Tokens.text-dim;
            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
            wrap: word-wrap; width: 704px;
        }
    }

    // ---- el banner del modo seguro -----------------------------------
    // Queda puesto MIENTRAS dure: sin él, el jugador ve su juego sin el pack y
    // cree que el pack se rompió. Y trae su propia salida, porque un modo del
    // que no se sabe cómo salir es un modo en el que uno se queda.
    if safe-mode: Rectangle {
        y: 0; width: parent.width; height: 64px;
        background: Tokens.bg-elevated;
        HorizontalLayout {
            padding-left: 24px; padding-right: 24px; spacing: 16px;
            alignment: start;
            Icon {
                text: Icons.shield-warning; color: Tokens.warning; size: 28px;
            }
            Text {
                text: @tr("Modo seguro: sin pack, shaders ni overrides. La ROM y los guardados no se tocan.");
                color: Tokens.text-normal;
                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                vertical-alignment: center;
            }
            Rectangle { width: 24px; }
            exit-safe-mode-area := TouchArea {
                accessible-role: button;
                accessible-label: @tr("Salir del modo seguro");
                accessible-action-default => { root.exit-safe-mode(); }

                width: 260px; height: 40px;
                clicked => { root.exit-safe-mode(); }
                Rectangle {
                    border-radius: Tokens.radius-lg;
                    border-width: 1px; border-color: Tokens.border;
                    background: exit-safe-mode-area.has-hover ? Tokens.overlay-hi : transparent;
                    Text {
                        text: @tr("Salir del modo seguro");
                        color: Tokens.text-normal;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                }
            }
        }
    }

    // ---- el aviso de doble lanzamiento -------------------------------
    // Un Toast y no un diálogo: no hay ninguna decisión que tomar, y un modal
    // para «ya lo estás jugando» obligaría a descartarlo antes de seguir.
    // El aviso se va SOLO. Un toast que se queda puesto obliga a buscarle el
    // botón de cerrar, y para entonces ya no habla de nada que esté pasando.
    Timer {
        interval: 5s;
        running: root.toast-text != "";
        triggered => { root.toast-text = ""; }
    }
    if toast-text != "": Rectangle {
        width: toast-row.preferred-width + 48px;
        height: 72px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 160px;
        background: Tokens.bg-elevated;
        border-radius: Tokens.radius-lg;
        border-width: 1px; border-color: Tokens.border;
        toast-row := HorizontalLayout {
            padding-left: 24px; padding-right: 24px; spacing: 16px;
            alignment: center;
            Icon {
                text: Icons.warning; color: Tokens.warning; size: 28px;
            }
            Text {
                text: root.toast-text; color: Tokens.text-bright;
                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                vertical-alignment: center;
            }
        }
    }

    // ---- SessionOverlay -----------------------------------------------
    // «04 · Lanzamiento y sesión» de play-ce.pen. Entre apretar A y ver el juego
    // pasan segundos: se escribe el manifest, nace el proceso, el core carga la
    // ROM. Sin nada en pantalla eso se lee como que no pasó nada, y el jugador
    // aprieta A de nuevo — que es como se lanzan dos sesiones del mismo juego.
    // Los pasos son los REALES, no una animación: cada uno se enciende con el
    // hecho que lo cumple, y el último se apaga con el evento `ready`. Un
    // temporizador acertaría en una máquina y mentiría en las otras dos.
    if session-preparing: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;
        VerticalLayout {
            width: parent.width; height: parent.height;
            alignment: center; spacing: 28px;

            HorizontalLayout {
                alignment: center;
                Text {
                    text: root.session-game == ""
                        ? @tr("PREPARANDO…")
                        : @tr("PREPARANDO {}…", root.session-game);
                    color: Tokens.text-bright;
                    font-family: Tokens.font-display; font-size: 44px;
                    font-weight: 600; letter-spacing: 1.3px;
                }
            }

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 640px; height: 8px; clip: true;
                    background: Tokens.bg-well;
                    border-radius: Shape.pill(self.width, self.height);
                    Rectangle {
                        x: 0; y: 0; height: parent.height;
                        // El avance sale del paso alcanzado y no de un reloj:
                        // una barra que corre sola miente cuando el paso se
                        // traba, que es justo cuando hay que mirarla.
                        width: parent.width * (root.session-step + 1) / 3;
                        background: Tokens.accent;
                        border-radius: Shape.pill(self.width, self.height);
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    spacing: 10px;
                    for step[i] in [
                        root.session-manifest, root.session-process, root.session-wait
                    ]: HorizontalLayout {
                        spacing: 12px;
                        Icon {
                            // «04 · Lanzamiento y sesión» del .pen: los pasos
                            // hechos con `check-circle`, el que está corriendo
                            // con `circle-notch`. El pendiente es el `circle`
                            // vacío — el diseño no lo dibuja porque su pantalla
                            // no tiene ninguno. El estado se dice con el ICONO y
                            // con el color, nunca sólo con el color.
                            text: i < root.session-step ? Icons.check-circle
                                : i == root.session-step ? Icons.circle-notch
                                                        : Icons.circle;
                            color: i < root.session-step ? Tokens.success
                                 : i == root.session-step ? Tokens.accent : Tokens.text-dim;
                        }
                        Text {
                            // En la fuente de la UI y no en la mono: la mono era
                            // para las rutas y los nombres de evento que estos
                            // renglones ya no dicen.
                            text: step;
                            color: i == root.session-step ? Tokens.text-normal : Tokens.text-dim;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // el aviso del runtime. Un warning NO corta la sesión, pero
            // tiene que verse: es la única oportunidad de decir «esto arranca
            // sin música» antes de que el jugador lo note oyendo.
            if root.session-warning != "": HorizontalLayout {
                alignment: center;
                Icon {
                    text: Icons.warning; color: Tokens.warning; size: 20px;
                }
                Text {
                    text: root.session-warning;
                    color: Tokens.warning;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                    wrap: word-wrap; width: 880px;
                    horizontal-alignment: left;
                }
            }

            HorizontalLayout {
                alignment: center;
                Text {
                    text: @tr("Mientras jugás, Play se queda esperando acá. Cuando cierres el juego, volvés a esta pantalla.");
                    color: Tokens.text-dim;
                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                    wrap: word-wrap; width: 900px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // ---- configuracion previa al lanzamiento --------------------------
    // Cuatro direcciones y un button: arriba/abajo mueve, izquierda/derecha
    // cambia el valor de la fila, Enter juega, Escape vuelve. Eso es lo que
    // hace que «funciona completamente con gamepad» sea comprobable — es un
    // conjunto cerrado de acciones, no una superficie de controles.
    if config-open: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;
        config-scope := FocusScope {
            key-pressed(event) => {
                if credits-open && (event.text == Key.UpArrow
                                 || event.text == Key.DownArrow
                                 || event.text == Key.LeftArrow
                                 || event.text == Key.RightArrow
                                 || event.text == " ") {
                    return EventResult.accept;   // la lista tapa: no se ajusta a ciegas
                }
                if event.text == Key.UpArrow {
                    if config-row > 0 { config-row -= 1; }
                    return EventResult.accept;
                }
                if event.text == Key.DownArrow {
                    if config-row + 1 < config-rows.length { config-row += 1; }
                    return EventResult.accept;
                }
                if event.text == Key.LeftArrow  { config-adjust(config-row, -1); return EventResult.accept; }
                if event.text == Key.RightArrow { config-adjust(config-row,  1); return EventResult.accept; }
                // El button de accion tambien alterna: en un mando, A sobre una
                // fila de dos estados es lo que la mano espera, y obligar a
                // usar la cruceta para eso seria una regla que hay que saber.
                if event.text == " " { config-adjust(config-row, 1); return EventResult.accept; }
                // los creditos, sobre la misma pantalla. Se DICEN en el
                // pie —como el atajo de comparacion— porque nadie los busca
                // solo, y son la mitad del ciclo que mira al autor.
                if event.text == "c" || event.text == "C" {
                    credits-open = !credits-open; return EventResult.accept;
                }
                if event.text == "d" || event.text == "D" {
                    detail-open = !detail-open; return EventResult.accept;
                }
                if event.text == Key.Return {
                    // Con los creditos abiertos, el button de accion los cierra:
                    // arrancar el juego desde una pantalla que tapa la lista
                    // seria una accion que el jugador no ve venir.
                    if credits-open { credits-open = false; }
                    else { config-accept(); }
                    return EventResult.accept;
                }
                if event.text == Key.Escape || event.text == Key.Backspace {
                    if detail-open { detail-open = false; }
                    else if credits-open { credits-open = false; }
                    else { config-cancel(); }
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            // El foco NO se toma en `init`: pedirlo mientras Slint construye
            // el subárbol reentra en el adaptador de accesibilidad y la
            // aplicación MUERE con «RefCell already borrowed»
            // (`winitwindowadapter.rs:1584`, el mismo defecto que ya había
            // matado al wizard). Un tick después el árbol ya existe y tomar el
            // foco es seguro. El Timer se apaga solo cuando el foco está puesto,
            // así que también lo recupera si algo se lo lleva —adentro de un
            // modal, el foco es del modal—.
            Timer {
                interval: 16ms;
                running: config-open && !config-scope.has-focus;
                triggered => { config-scope.focus(); }
            }

            // Dialog/10ft del .pen: 720 de ancho, Head de 80 con el título y su
            // cruz, Body con las filas y Foot con las salidas. El alto sale del
            // CONTENIDO —era fijo en 480 y el contenido se desbordaba por abajo,
            // que en una pantalla de decisión significa un ajuste que nadie ve—.
            Rectangle {
                width: 720px;
                // El alto sale del contenido, PERO acotado a lo que hay: con
                // once ajustes el diálogo medía más que la pantalla y se comía
                // su propio título y sus botones. Lo que no entra se desplaza
                // (la lista de abajo), que es lo que deja que un juego con pack
                // tenga más filas sin romper la pantalla.
                height: min(config-column.preferred-height, parent.height - 48px);
                x: (parent.width  - self.width)  / 2;
                y: (parent.height - self.height) / 2;
                background: Tokens.bg-window;
                border-radius: Tokens.radius-lg;
                border-width: 1px; border-color: Tokens.border;

                config-column := VerticalLayout {
                    // ---- Head ---------------------------------------------
                    Rectangle {
                        height: 80px;
                        HorizontalLayout {
                            padding-left: 32px; padding-right: 32px; spacing: 16px;
                            Text {
                                text: @tr("CONFIGURACIÓN PREVIA");
                                color: Tokens.text-bright;
                                font-family: Tokens.font-display;
                                font-size: Tokens.text-display-md;
                                font-weight: 600; letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            close-config-area := TouchArea {
                                accessible-role: button;
                                accessible-label: @tr("Cerrar");
                                accessible-action-default => { config-cancel(); }

                                width: 32px;
                                clicked => { config-cancel(); }
                                Icon {
                                    text: Icons.x;
                                    color: close-config-area.has-hover ? Tokens.text-bright : Tokens.text-dim;
                                    size: 28px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px; height: 1px;
                            width: parent.width; background: Tokens.border;
                        }
                    }

                    // ---- Body ---------------------------------------------
                    VerticalLayout {
                        padding: 32px; spacing: 20px;

                        // Sobre qué se está decidiendo. El .pen no lo trae
                        // sus maquetas no tienen estado— y sin esto el
                        // diálogo no dice de qué juego habla.
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: config-game;
                                color: Tokens.text-bright;
                                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                font-weight: 600; overflow: elide;
                            }
                            Text {
                                // Sin pack no hay nada que configurar más allá
                                // del sonido: decirlo evita que el jugador
                                // busque opciones que no existen.
                                text: config-pack == ""
                                    ? @tr("Sin pack — se juega el original")
                                    : @tr("Pack: {}", config-pack);
                                color: Tokens.text-dim;
                                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                            }
                        }

                        // SettingRow del .pen: la etiqueta a la izquierda y el
                        // valor en su caja a la derecha.
                        // En una LISTA que se desplaza y sigue al foco, con el
                        // mismo movimiento mínimo que el explorador de carpetas:
                        // los ajustes de un juego con pack no entran en ninguna
                        // pantalla, y una fila seleccionada que no se ve es un
                        // ajuste que se cambia a ciegas.
                        config-list := ListView {
                            property <length> step: 72px;
                            property <int>    focus-index: config-row;
                            // Lo que la lista QUERRÍA medir: todas sus filas. Es
                            // lo que hace que la tarjeta crezca hasta el tope y
                            // recién ahí se desplace; sin esto, una lista pide
                            // lo mínimo y el diálogo mostraba una fila sola.
                            preferred-height: config-rows.length * self.step;
                            min-height: 3 * self.step;
                            vertical-stretch: 1;
                            changed focus-index => {
                                if (self.viewport-y + self.focus-index * self.step) < 0 {
                                    self.viewport-y = -self.focus-index * self.step;
                                }
                                if (self.viewport-y + (self.focus-index + 1) * self.step) > self.visible-height {
                                    self.viewport-y = self.visible-height - (self.focus-index + 1) * self.step;
                                }
                            }
                        for row[i] in config-rows: Rectangle {
                            height: config-list.step;
                            background: i == config-row ? Tokens.accent-tint : transparent;
                            border-radius: Tokens.radius-md;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 24px;
                                Text {
                                    text: row.label;
                                    color: !row.available ? Tokens.text-dim
                                         : (i == config-row ? Tokens.accent : Tokens.text-bright);
                                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                    font-weight: 500; vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Centered {
                                    Rectangle {
                                        width: 320px; height: Tokens.control-md;
                                        background: Tokens.bg-input;
                                        border-radius: Tokens.radius-md;
                                        border-width: 1px;
                                        border-color: i == config-row ? Tokens.accent : Tokens.border;
                                        HorizontalLayout {
                                            padding-left: 16px; padding-right: 16px; spacing: 12px;
                                            Text {
                                                text: row.value;
                                                color: !row.available ? Tokens.text-dim : Tokens.text-normal;
                                                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                                vertical-alignment: center; overflow: elide;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            // El caret dice que el valor se
                                            // CAMBIA, y sólo aparece donde se
                                            // puede: en las demás filas sería
                                            // una invitación a mover algo que no
                                            // se mueve.
                                            Icon {
                                                text: row.available && row.value != "" ? Icons.caret-down : "";
                                                color: i == config-row ? Tokens.accent : Tokens.text-dim;
                                                size: 24px;
                                            }
                                        }
                                    }
                                }
                            }
                            TouchArea {
                                clicked => { config-row = i; config-adjust(i, 1); }
                            }
                        }
                        }
                    }

                    // ---- Foot ---------------------------------------------
                    // Los dos botones del diseño, para el mouse. Lo que se fue
                    // de acá son las DOS LÍNEAS DE AYUDA que el diálogo tenía
                    // («↑↓ elegir  ←→/A cambiar  Enter jugar…»): eso lo dice el
                    // pie del chasis, como en todas las demás pantallas.
                    Rectangle {
                        height: 88px;
                        Rectangle {
                            y: 0; height: 1px; width: parent.width; background: Tokens.border;
                        }
                        HorizontalLayout {
                            padding-left: 32px; padding-right: 32px;
                            padding-top: 20px; padding-bottom: 20px;
                            spacing: 16px;
                            // Salir, a la IZQUIERDA. Lo que hace algo con la
                            // sesión que está por empezar va junto, a la
                            // derecha: el ojo no tiene que elegir entre tres
                            // botones en fila, sino entre irse y seguir.
                            Centered {
                                ActionButton {
                                    label: @tr("Volver");
                                    icon: Icons.arrow-bend-up-left;
                                    ghost: true;
                                    clicked => { config-cancel(); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Centered {
                                ActionButton {
                                    label: @tr("Restaurar");
                                    icon: Icons.arrow-counter-clockwise;
                                    clicked => { config-restore(); }
                                }
                            }
                            Centered {
                                ActionButton {
                                    label: @tr("Jugar");
                                    icon: Icons.play;
                                    primary: true;
                                    clicked => { config-accept(); }
                                }
                            }
                        }
                    }
                }
            }

            // ---- la FICHA del pack -------------------------------------
            // Lo DECLARADO (lo que el manifest dice) y lo COMPROBADO (firma,
            // integridad, compatibilidad con TU ROM) se ven distinto a propósito:
            // mostrar como verificado algo que no lo está sería engañoso, y un
            // color uniforme lo haría por omisión.
            if detail-open: Rectangle {
                width: parent.width; height: parent.height;
                background: Tokens.modal-dim;

                Rectangle {
                    width: 620px; height: 520px;
                    x: (parent.width  - self.width)  / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px; background: Tokens.bg-elevated;

                    VerticalLayout {
                        padding: 24px; spacing: 10px;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: detail-pack;
                                color: Tokens.text-normal; font-size: 18px; font-weight: 700;
                            }
                            // El veredicto arriba de todo y con color propio: es
                            // lo único que el jugador NECESITA leer antes de
                            // decidir, y enterrarlo entre los datos sería
                            // esconderlo.
                            Text {
                                text: detail-compat;
                                color: detail-playable ? Tokens.success : Tokens.danger;
                                font-size: 14px; font-weight: 600;
                            }
                        }

                        Rectangle { height: 1px; background: Tokens.border-soft; }

                        ListView {
                            for row in detail-rows: Rectangle {
                                height: row.value == "" ? 26px : 34px;
                                HorizontalLayout {
                                    padding-left: 4px; padding-right: 4px; spacing: 10px;
                                    Text {
                                        // Una fila sin valor es un TÍTULO de
                                        // sección: separa lo declarado de lo
                                        // comprobado sin necesitar dos listas.
                                        text: row.label;
                                        color: row.value == "" ? Tokens.accent
                                             : (row.level == "error" ? Tokens.danger
                                             : (row.level == "advertencia" ? Tokens.warning
                                             : (row.level == "ok" ? Tokens.success : Tokens.text-dim)));
                                        font-size: row.value == "" ? 13px : 14px;
                                        font-weight: row.value == "" ? 700 : 400;
                                        width: 190px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.value;
                                        color: row.level == "error" ? Tokens.danger
                                             : (row.level == "advertencia" ? Tokens.warning
                                             : (row.level == "ok" ? Tokens.success : Tokens.text-normal));
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        Text {
                            text: @tr("D / Esc / B volver");
                            color: Tokens.text-dim; font-size: 12px; horizontal-alignment: center;
                        }
                    }
                }
            }

            // CRÉDITOS — quién hizo el pack, sobre la misma pantalla.
            // Sale del `credits.toml` del pack y por eso funciona igual
            // sin conexión: un pack instalado a mano muestra los mismos
            // créditos que uno obtenido de un catálogo remoto. Un pack que no los declara
            // lo DICE — una lista vacía se leería como un error de la pantalla.
            if credits-open: Rectangle {
                width: parent.width; height: parent.height;
                background: Tokens.modal-dim;

                Rectangle {
                    width: 560px; height: 480px;
                    x: (parent.width  - self.width)  / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px; background: Tokens.bg-elevated;

                    VerticalLayout {
                        padding: 24px; spacing: 12px;

                        VerticalLayout {
                            spacing: 2px;
                            Text { text: @tr("Créditos"); color: Tokens.text-normal; font-size: 18px; font-weight: 700; }
                            Text {
                                text: config-pack == "" ? "Sin pack" : config-pack;
                                color: Tokens.text-dim; font-size: 13px;
                            }
                        }

                        Rectangle { height: 1px; background: Tokens.border-soft; }

                        if credit-lines.length == 0: Text {
                            text: @tr("Este pack no declara créditos.");
                            color: Tokens.text-dim; font-size: 14px;
                            vertical-alignment: center; horizontal-alignment: center;
                        }

                        ListView {
                            for line in credit-lines: Rectangle {
                                height: 46px;
                                VerticalLayout {
                                    padding-left: 4px; padding-right: 4px; spacing: 1px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: line.author;
                                            color: Tokens.text-normal; font-size: 15px; font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: line.contribution;
                                            color: Tokens.text-dim; font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: space-between;
                                        // El rol puede faltar: el pack lo
                                        // declara o no, y una etiqueta
                                        // inventada seria peor que ninguna.
                                        Text {
                                            text: line.role;
                                            color: Tokens.accent; font-size: 12px;
                                        }
                                        Text {
                                            text: line.licenses;
                                            color: Tokens.text-dim; font-size: 12px;
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: @tr("C / Esc / B volver");
                            color: Tokens.text-dim; font-size: 12px; horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ---- la opinión del jugador, después de la sesión ----------------
    // Aparece al volver del juego y sólo si la sesión fue lo bastante larga
    // (feedback.rs decide). Se maneja igual que la pantalla previa —arriba/abajo
    // elige, izquierda/derecha puntúa— porque es la misma mano en el mismo
    // mando, y aprender dos gramáticas para dos pantallas del mismo launcher
    // sería una regla que hay que saber.
    if feedback-open: Scrim {
        y: Shell.topbar;
        width: parent.width;
        height: parent.height - Shell.topbar - Shell.footer;

        feedback-scope := FocusScope {
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    if feedback-row > 0 { feedback-row -= 1; }
                    return EventResult.accept;
                }
                if event.text == Key.DownArrow {
                    if feedback-row + 1 < feedback-rows.length { feedback-row += 1; }
                    return EventResult.accept;
                }
                if event.text == Key.LeftArrow  { feedback-rate(feedback-row, -1); return EventResult.accept; }
                if event.text == Key.RightArrow { feedback-rate(feedback-row,  1); return EventResult.accept; }
                if event.text == Key.Return { feedback-send();  return EventResult.accept; }
                // Escape es «ahora no», no «no preguntar más»: la salida fácil
                // nunca puede ser la decisión permanente.
                if event.text == Key.Escape || event.text == Key.Backspace {
                    feedback-later(); return EventResult.accept;
                }
                if event.text == "n" || event.text == "N" {
                    feedback-never(); return EventResult.accept;
                }
                return EventResult.reject;
            }
            DeferredFocus {
                request-focus: root.pad-surface == "encuesta" && !feedback-scope.has-focus;
                take-focus => { feedback-scope.focus(); }
            }

            // «04b · Sesión terminada» de play-ce.pen. Creció de 560×480 a
            // 900 de ancho y sus textos pasaron a las tallas de 10 pies: los de
            // 12 y 13 px eran ilegibles desde un sillón, que es el único lugar
            // desde donde alguien iba a ver este diálogo.
            Rectangle {
                width: 900px; height: feedback-column.preferred-height;
                x: (parent.width  - self.width)  / 2;
                y: (parent.height - self.height) / 2;
                border-radius: Tokens.radius-lg; background: Tokens.bg-elevated;
                border-width: 1px; border-color: Tokens.border;

                feedback-column := VerticalLayout {
                    padding: 32px; spacing: 20px;

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("SESIÓN TERMINADA");
                            color: Tokens.text-bright;
                            font-family: Tokens.font-display;
                            font-size: Tokens.text-display-md; font-weight: 600;
                            letter-spacing: 0.8px;
                        }
                        Text {
                            text: feedback-pack + "   ·   " + feedback-played;
                            color: Tokens.text-dim;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        }
                    }

                    // lo que la sesión dejó. Sólo si hubo algo: tres
                    // ceros son ruido, y se juega sin guardar todo el tiempo.
                    if root.summary-has-activity: HorizontalLayout {
                        spacing: 16px; alignment: start;
                        StatTile { label: @tr("Esta sesión"); value: root.summary-time; }
                        StatTile { label: @tr("Guardados");   value: root.summary-saves; }
                        StatTile { label: @tr("Capturas");    value: root.summary-captures; }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("¿Cómo quedó este pack?");
                            color: Tokens.text-normal;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body;
                            font-weight: 600;
                        }
                        // Se dice ANTES de contestar, no en una política que
                        // nadie abre: es la diferencia entre pedir una opinión
                        // y tomar un dato.
                        Text {
                            text: @tr("Se guarda en tu equipo. No se envía nada sin que vos lo pidas.");
                            color: Tokens.text-dim;
                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        }
                    }

                    Rectangle { height: 1px; background: Tokens.border-soft; }

                    VerticalLayout {
                        spacing: 2px;
                        for row[i] in feedback-rows: Rectangle {
                            height: Tokens.control-md; border-radius: Tokens.radius-md;
                            background: i == feedback-row ? Tokens.accent-tint : transparent;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                alignment: space-between;
                                Text {
                                    text: row.label;
                                    color: i == feedback-row ? Tokens.accent : Tokens.text-normal;
                                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                    vertical-alignment: center;
                                }
                                // Las cinco ESTRELLAS del .pen («Body > stars»,
                                // `star` en el acento y en text-dim). Eran
                                // bolitas de la fuente mono porque no había
                                // fuente de iconos. Sin contestar se ve como
                                // sin contestar: las cinco apagadas, que no es
                                // lo mismo que un 3 por defecto — eso sería una
                                // opinión que el jugador no dio.
                                HorizontalLayout {
                                    spacing: 6px;
                                    for e in [1, 2, 3, 4, 5]: Icon {
                                        text: Icons.star;
                                        size: 22px;
                                        color: row.value >= e ? Tokens.accent : Tokens.border;
                                    }
                                }
                            }
                            TouchArea { clicked => { feedback-row = i; feedback-rate(i, 1); } }
                        }
                    }

                    Text {
                        text: @tr("↑↓ elegir    ←→ puntuar    Enter guardar    Esc ahora no    N no preguntar más");
                        color: Tokens.text-dim;
                        font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // -----------------------------------------------------------------------
    // el wizard de primer arranque.
    // Todo lo que DECIDE está en `onboarding.rs` (qué paso sigue, qué traba el
    // paso, qué se guarda). Acá sólo se dibuja el estado y se manda la acción,
    // igual que con `pad_router`: es lo que permite probar las reglas sin abrir
    // una ventana.
    // El wizard se dibuja al final del archivo, así que queda ENCIMA de todo lo
    // demás — que es lo mismo que dice `pad_router::superficie()`: mientras el
    // primer arranque no termina, no hay biblioteca detrás que usar.
    // -----------------------------------------------------------------------
    // =====================================================================
    // EL ONBOARDING, a pantalla completa (play-ce.pen «00 · Onboarding ·
    // Bienvenida» y las cinco «Onboarding · …» que el diseño agregó al
    // rediseñar este flujo).
    // ANTES ERA UN DIÁLOGO: una tarjeta de 720 con Head, Foot y sus botones,
    // centrada sobre un fondo opaco. El diseño nuevo lo abre a PANTALLA
    // COMPLETA y en dos columnas —la marca a la izquierda, el paso a la
    // derecha—, con el mismo pie de botones que el resto del chasis.
    // Los botones del Foot se van con la tarjeta: el pie ya dice qué hace cada
    // botón del mando, y en una TV un botón que repite lo que dice el pie es
    // una segunda cosa que mirar. Lo que los reemplaza es que los HINTS SON
    // CLICKEABLES — el wizard se sigue pudiendo terminar con el mouse, que era
    // lo único que esos botones aportaban.
    // =====================================================================
    if onboarding-open: Rectangle {
        // La bandera vive ACÁ ADENTRO y no en el root a propósito: este subárbol
        // se destruye al cerrarse el wizard y vuelve a nacer en `false`, así que
        // el foco se toma también la segunda vez que se abre, algo necesario
        // porque Ajustes lo abre en su paso. Con la bandera en el
        // root quedaba en `true` para siempre y el segundo wizard nacía sin
        // foco: las flechas movían la pantalla de atrás.
        property <bool> onboarding-focused: false;

        width: parent.width; height: parent.height;
        background: Tokens.bg-window;

        onboarding-scope := FocusScope {
            key-pressed(event) => {
                if event.text == Key.UpArrow   { onboarding-move(-1); return EventResult.accept; }
                if event.text == Key.DownArrow { onboarding-move(1);  return EventResult.accept; }
                if event.text == Key.LeftArrow  { onboarding-secondary(-1); return EventResult.accept; }
                if event.text == Key.RightArrow { onboarding-secondary(1);  return EventResult.accept; }
                // Una tecla por botón del mando, y las mismas que el pie
                // anuncia: A es la barra o Enter, B es Escape o Atrás, y X e Y
                // son sus letras. Sin esto, el teclado enseñaría una gramática
                // distinta de la que está escrita en la pantalla.
                if event.text == " " || event.text == Key.Return {
                    onboarding-activate(); return EventResult.accept;
                }
                if event.text == "x" || event.text == "X" {
                    onboarding-step-action(); return EventResult.accept;
                }
                if event.text == "y" || event.text == "Y" {
                    onboarding-activate-secondary(); return EventResult.accept;
                }
                if event.text == Key.Escape || event.text == Key.Backspace {
                    onboarding-back(); return EventResult.accept;
                }
                return EventResult.reject;
            }

            // El foco NO se toma en `init`: el wizard esta abierto desde el
            // primer frame, y pedir foco mientras Slint construye el subarbol
            // reentra en la ventana — la aplicacion moria con «RefCell already
            // borrowed» antes de dibujar nada. Un tick despues, el arbol ya
            // existe y tomar el foco es seguro.
            Timer {
                interval: 16ms;
                running: onboarding-open && !onboarding-focused;
                triggered => { onboarding-scope.focus(); onboarding-focused = true; }
            }

            VerticalLayout {
                // El escenario: el paso, y encima el explorador cuando está
                // abierto. El pie queda AFUERA para que el velo del explorador
                // no lo tape — es donde están sus salidas.
                stage := Rectangle {
                    vertical-stretch: 1;

                    // ---------------------------------------------------------
                    // PASO 1 — la PORTADA (play-ce.pen «00»).
                    // No lleva puntos ni «Paso 1 de 6»: es la portada —marca,
                    // promesa e idioma— y por eso el diseño la dibuja como
                    // pantalla y no como paso. Los puntos aparecen en el paso 2,
                    // que es cuando hay un recorrido del que informar el avance.
                    // ---------------------------------------------------------
                    if onboarding-step == 0: VerticalLayout {
                        width: parent.width; height: parent.height;
                        alignment: center; spacing: 64px;
                        padding-left: 96px; padding-right: 96px;   // safe area

                        VerticalLayout {
                            spacing: 16px;
                            HorizontalLayout {
                                alignment: center;
                                // La marca DIBUJADA, no el ícono de la app: el
                                // .png de resources trae su propia baldosa
                                // oscura (es lo que Windows necesita para el
                                // .exe) y sobre el fondo de página se ve el
                                // recuadro. Este es el mismo trazado que el
                                // `Logo/lg` del .pen, con su viewBox de 1024.
                                Logo { size: 160px; }
                            }
                            Text {
                                text: "AYTHER PLAY";
                                color: Tokens.text-bright;
                                font-family: Tokens.font-display; font-size: Tokens.text-display-xl;
                                font-weight: 600; letter-spacing: 1.9px;
                                horizontal-alignment: center;
                            }
                            Text {
                                // La promesa sale de `onboarding.rs` (es el
                                // «encabezado» del paso): el texto que se
                                // traduce y el que se dibuja son el mismo.
                                text: onboarding-heading;
                                color: Tokens.text-dim;
                                font-family: Tokens.font-ui; font-size: Tokens.text-body-lg;
                                horizontal-alignment: center; wrap: word-wrap;
                            }
                        }

                        // Idioma como CHIPS y no como fila: son tres valores
                        // excluyentes y se ven todos a la vez, que es lo que
                        // evita tener que ciclar a ciegas para saber qué más
                        // hay. ←→ rota; el clic va directo.
                        VerticalLayout {
                            spacing: 24px;
                            Text {
                                text: @tr("Idioma");
                                color: Tokens.text-dim;
                                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: center; spacing: 16px;
                                for language-label[li] in onboarding-languages: Chip {
                                    label: language-label;
                                    active: li == onboarding-language;
                                    clicked => { onboarding-secondary(li - onboarding-language); }
                                }
                            }
                        }
                    }

                    // ---------------------------------------------------------
                    // PASOS 2 a 6 — dos columnas (play-ce.pen «Onboarding · …»).
                    // La marca se queda en pantalla todo el wizard: es el primer
                    // arranque, y lo que hay que aprender es de qué producto es
                    // esta pantalla. A la derecha, sólo el paso.
                    // ---------------------------------------------------------
                    if onboarding-step > 0: HorizontalLayout {
                        width: parent.width; height: parent.height;
                        padding-left: 96px; padding-right: 96px; spacing: 28px;

                        VerticalLayout {
                            alignment: center; spacing: 16px;
                            HorizontalLayout {
                                alignment: center;
                                Logo { size: 160px; }
                            }
                            Text {
                                text: "AYTHER PLAY";
                                color: Tokens.text-bright;
                                font-family: Tokens.font-display; font-size: Tokens.text-display-xl;
                                font-weight: 600; letter-spacing: 1.9px;
                                horizontal-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center; spacing: 20px; padding: 32px;

                            // WizardHeader: los puntos, el paso y el título del
                            // paso. Los puntos son CÍRCULOS del mismo tamaño y
                            // no barras que crecen: lo que informan es cuántos
                            // pasos hay y en cuál se está, no cuánto ocupa cada
                            // uno.
                            VerticalLayout {
                                spacing: 16px;
                                if !root.onboarding-single-step: HorizontalLayout {
                                    spacing: 10px; alignment: start;
                                    for i in [0, 1, 2, 3, 4, 5]: Rectangle {
                                        width: 12px; height: 12px;
                                        border-radius: Shape.pill(self.width, self.height);
                                        background: i <= onboarding-step ? Tokens.accent : Tokens.border;
                                    }
                                    Text {
                                        text: @tr("Paso {} de {}", onboarding-step + 1, 6);
                                        color: Tokens.text-dim;
                                        font-family: Tokens.font-mono;
                                        font-size: Tokens.text-body-sm;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: onboarding-heading;
                                    color: Tokens.text-bright;
                                    font-family: Tokens.font-display;
                                    font-size: Tokens.text-display-lg;
                                    font-weight: 600; letter-spacing: 1.3px;
                                    wrap: word-wrap;
                                }
                            }

                            // -- Paso 2: el mando ---------------------------
                            // No es un probador de botones. A, B y X ya
                            // significan algo acá, y capturarlos para «probar»
                            // dejaría al jugador sin poder salir del paso. Lo
                            // que el paso sí puede afirmar —qué mando está
                            // enchufado y qué gramática usa— es lo que hace
                            // falta para seguir; la prueba de verdad es que
                            // moverse por el wizard ya funciona.
                            if onboarding-step == 1: VerticalLayout {
                                spacing: 20px;
                                HorizontalLayout {
                                    spacing: 16px; alignment: start;
                                    PadGlyph { key: "A"; }
                                    PadGlyph { key: "B"; }
                                    PadGlyph { key: "X"; }
                                    PadGlyph { key: "Y"; }
                                }
                                Text {
                                    text: @tr("Movete con el stick o la cruceta y confirmá con A. Si no se detecta ningún mando, podés seguir con teclado.");
                                    color: Tokens.text-dim;
                                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    Icon {
                                        text: Icons.game-controller;
                                        color: onboarding-gamepad == "" ? Tokens.text-dim : Tokens.success;
                                        size: 28px;
                                    }
                                    Text {
                                        text: onboarding-gamepad == ""
                                            ? @tr("Ningún mando detectado — podés seguir con teclado")
                                            : onboarding-gamepad + " · " + @tr("conectado");
                                        color: onboarding-gamepad == "" ? Tokens.text-dim : Tokens.text-normal;
                                        font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                        vertical-alignment: center; wrap: word-wrap;
                                    }
                                }
                            }

                            // -- Paso 3: carpetas de ROM --------------------
                            if onboarding-step == 2: VerticalLayout {
                                spacing: 16px;
                                Text {
                                    text: @tr("Play sólo lee. No copia, no mueve y no sube nada.");
                                    color: Tokens.text-dim;
                                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                    wrap: word-wrap;
                                }
                                for row[fi] in onboarding-rows: Rectangle {
                                    height: 56px;
                                    border-radius: Tokens.radius-md;
                                    background: onboarding-row == fi ? Tokens.accent-tint : transparent;
                                    TouchArea { clicked => { onboarding-row = fi; } }
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                                        Icon { text: Icons.folder; color: Tokens.accent; size: 28px; }
                                        Text {
                                            text: row.title;
                                            color: Tokens.text-bright;
                                            font-family: Tokens.font-mono; font-size: Tokens.text-mono;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: row.detail;
                                            color: Tokens.text-dim;
                                            font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                                            vertical-alignment: center;
                                        }
                                        // Quitar, para el mouse. Con el mando es
                                        // «Y», que el pie anuncia; sin este
                                        // botón, sacar una carpeta sería la
                                        // única acción del wizard que exige
                                        // teclado.
                                        remove-folder-area := TouchArea {
                                            accessible-role: button;
                                            accessible-label: @tr("Quitar la carpeta");
                                            accessible-action-default => { onboarding-row = fi; onboarding-activate-secondary(); }

                                            width: 32px;
                                            clicked => { onboarding-row = fi; onboarding-activate-secondary(); }
                                            Icon {
                                                text: Icons.trash;
                                                color: remove-folder-area.has-hover ? Tokens.danger : Tokens.text-dim;
                                                size: 24px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                    }
                                }
                                // Button/Default del .pen: borde claro, el
                                // `plus` y la etiqueta. Hace lo mismo que «X».
                                HorizontalLayout {
                                    alignment: start;
                                    add-folder-area := TouchArea {
                                        accessible-role: button;
                                        accessible-label: @tr("Agregar carpeta");
                                        accessible-action-default => { onboarding-step-action(); }

                                        width: 260px; height: Tokens.control-md;
                                        clicked => { onboarding-step-action(); }
                                        Rectangle {
                                            border-radius: Tokens.radius-lg;
                                            border-width: 1px;
                                            border-color: add-folder-area.has-hover ? Tokens.accent : Tokens.text-bright;
                                            background: add-folder-area.has-hover ? Tokens.overlay-hi : transparent;
                                            HorizontalLayout {
                                                spacing: 10px; alignment: center;
                                                Icon { text: Icons.plus; color: Tokens.text-normal; }
                                                Text {
                                                    text: @tr("Agregar carpeta");
                                                    color: Tokens.text-normal;
                                                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                                    font-weight: 500; vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // -- Paso 4: el core, con su semáforo -----------
                            if onboarding-step == 3: VerticalLayout {
                                spacing: 16px;
                                // CoreRow del diseño: el `cpu` del color del
                                // veredicto, el nombre en mono (es un archivo),
                                // el detalle abajo y el semáforo a la derecha.
                                Rectangle {
                                    height: 72px;
                                    border-radius: Tokens.radius-sm;
                                    background: Tokens.bg-panel;
                                    HorizontalLayout {
                                        padding-left: 16px; padding-right: 16px; spacing: 20px;
                                        Icon {
                                            text: Icons.cpu;
                                            color: onboarding-core-state == "ok"  ? Tokens.success
                                                 : onboarding-core-state == "bad" ? Tokens.danger
                                                                           : Tokens.text-dim;
                                            size: 28px;
                                        }
                                        VerticalLayout {
                                            spacing: 2px; alignment: center;
                                            Text {
                                                text: onboarding-core == ""
                                                    ? @tr("Elegí el archivo del core que vas a usar.")
                                                    : onboarding-core;
                                                color: Tokens.text-bright;
                                                font-family: onboarding-core == "" ? Tokens.font-ui : Tokens.font-mono;
                                                font-size: Tokens.text-mono;
                                                font-weight: 500; overflow: elide;
                                            }
                                            if onboarding-core-detail != "": Text {
                                                text: onboarding-core-detail;
                                                color: Tokens.text-dim;
                                                font-family: Tokens.font-ui;
                                                font-size: Tokens.text-body-sm;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        // El semáforo compartido: el mismo
                                        // ícono, la misma palabra y el mismo
                                        // tono que en la grilla y en la ficha.
                                        // Nunca sólo color.
                                        if onboarding-core-state != "": SemaphoreBadge {
                                            // 1 = compatible · 4 = incompatible ·
                                            // 3 = NO VERIFICADO, que es lo que
                                            // corresponde cuando el sondeo no se
                                            // pudo hacer: el core no falló, no se
                                            // lo pudo probar.
                                            state: onboarding-core-state == "ok" ? 1
                                                  : onboarding-core-state == "bad" ? 4 : 3;
                                        }
                                    }
                                }
                                // Qué pasó y qué hacer, una vez. El título sale
                                // del veredicto en vez de estar escrito acá:
                                // «Ese core no sirve acá» era falso justo en el
                                // caso en que el core no tiene la culpa.
                                if onboarding-core-remedy != "": TenFootAlert {
                                    panel-width: 656px;
                                    title: onboarding-core-title;
                                    detail: onboarding-core-remedy;
                                    icon: onboarding-core-state == "ok"  ? Icons.check-circle
                                         : onboarding-core-state == "bad" ? Icons.x-circle
                                                                   : Icons.warning;
                                    tone:  onboarding-core-state == "ok"  ? Tokens.success
                                         : onboarding-core-state == "bad" ? Tokens.danger
                                                                   : Tokens.warning;
                                }
                            }

                            // -- Paso 5: BYOR/BYOC -------------------
                            if onboarding-step == 4: VerticalLayout {
                                spacing: 16px;
                                for paragraph in onboarding-terms: Text {
                                    text: paragraph;
                                    color: Tokens.text-normal;
                                    font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    accept-terms-area := TouchArea {
                                        accessible-role: checkbox;
                                        accessible-label: @tr("Acepto los términos");
                                        accessible-checkable: true;
                                        accessible-checked: root.onboarding-accept;
                                        accessible-action-default => { onboarding-activate(); }

                                        width: 28px; height: 28px;
                                        clicked => { onboarding-activate(); }
                                        Rectangle {
                                            border-radius: Tokens.radius-md;
                                            background: onboarding-accept ? Tokens.accent : transparent;
                                            border-width: 2px; border-color: Tokens.accent;
                                            Icon {
                                                // El .pen pide el `check` en
                                                // peso Bold, que en Phosphor es
                                                // OTRA familia: acá pesa el
                                                // tamaño.
                                                text: onboarding-accept ? Icons.check : "";
                                                color: Tokens.accent-fg;
                                                size: 20px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                    }
                                    Text {
                                        text: @tr("Entiendo y acepto") + " (v" + onboarding-terms-version + ")";
                                        color: Tokens.text-normal;
                                        font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                        vertical-alignment: center;
                                    }
                                }
                                // Cuándo se aceptó, si ya estaba aceptado. Es el
                                // registro, mostrado: quien vuelve a pasar por
                                // acá ve que su aceptación sigue vigente en vez
                                // de preguntarse si tiene que volver a marcarla.
                                if onboarding-accept-date != "": Text {
                                    text: @tr("Aceptado el {}", onboarding-accept-date);
                                    color: Tokens.text-dim;
                                    font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                                }
                            }

                            // -- Paso 6: resumen ----------------------------
                            if onboarding-step == 5: VerticalLayout {
                                spacing: 12px;
                                for row in onboarding-rows: HorizontalLayout {
                                    spacing: 16px; alignment: start;
                                    Text {
                                        text: row.title; width: 240px;
                                        color: Tokens.text-dim;
                                        font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                    }
                                    Text {
                                        text: row.detail;
                                        color: Tokens.text-normal;
                                        font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                    }
                                }
                            }

                            // ---- El motivo por el que no se puede seguir ---
                            // Visible SIEMPRE que traba, en vez de un botón
                            // apagado sin explicación: un «Continuar» gris del
                            // que no se sabe qué le falta es la forma más común
                            // de dejar a alguien trabado.
                            // …y no cuando la alerta del paso ya lo dice con
                            // las mismas palabras: en el paso del core la traba
                            // ES el remedio, y se leía dos veces seguidas.
                            if onboarding-blocker != "" && onboarding-blocker != onboarding-core-remedy: Text {
                                text: onboarding-blocker; color: Tokens.warning;
                                font-family: Tokens.font-ui; font-size: Tokens.text-body;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ---- El explorador, encima del paso -------------------
                    // Propio y no el diálogo del sistema: `GetOpenFileName` es
                    // una ventana de escritorio —mouse, sin foco visible a tres
                    // metros, y sobre una aplicación a pantalla completa aparece
                    // detrás—. El onboarding tiene que poder completarse sólo
                    // con el mando (§6).
                    if onboarding-browsing: Rectangle {
                        width: parent.width; height: parent.height;
                        background: Tokens.modal-dim;
                        TouchArea { }   // traga los clicks del paso de abajo
                        Rectangle {
                            width: 760px; height: 560px;
                            x: (parent.width  - self.width)  / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: Tokens.radius-lg;
                            background: Tokens.bg-elevated;
                            border-width: 1px; border-color: Tokens.border;

                            VerticalLayout {
                                padding: 24px;
                                ExplorerList {
                                    location: onboarding-browse-path;
                                    rows: onboarding-browse-rows;
                                    focus-index: onboarding-row;
                                    choose(fi) => { onboarding-row = fi; onboarding-activate(); }
                                }
                            }
                        }
                    }
                }

                // ---- El pie ---------------------------------------------
                // El mismo del chasis, con los pares que arma `onboarding.rs`.
                // Clickeable: es lo único que reemplaza a los botones del Foot
                // que el diseño sacó.
                ButtonHints {
                    hints: root.onboarding-hints;
                    pressed(key) => {
                        if key == "A" { onboarding-activate(); }
                        if key == "B" { onboarding-back(); }
                        if key == "X" { onboarding-step-action(); }
                        if key == "Y" { onboarding-activate-secondary(); }
                    }
                }
            }
        }
    }


    // ---- La capa de tooltips -------------------------------------------
    // ÚLTIMO HIJO DE LA VENTANA A PROPÓSITO: es lo que la pone encima de todo
    // en un motor sin z-order. El texto y el ancla los publica el badge que
    // está bajo el puntero (ver `Tip`).
    if Tip.reason != "": Rectangle {
        // Debajo del ancla si entra, y arriba si no: en la última fila de la
        // ficha —«Pack»— abajo ya no queda pantalla.
        property <bool> below:
            Tip.anchor-y + Tip.anchor-height + 4px + self.height <= root.height;

        width: 420px;
        height: tooltip-container.preferred-height;
        // Pegado al badge, pero sin salirse por el margen derecho: el semáforo
        // de la lista vive contra el borde.
        x: max(16px, min(Tip.anchor-x, root.width - self.width - 16px));
        y: below ? Tip.anchor-y + Tip.anchor-height + 4px
                 : Tip.anchor-y - self.height - 4px;
        background: Tokens.bg-elevated;
        border-radius: Tokens.radius-md;
        border-width: 1px; border-color: Tokens.border;
        tooltip-container := VerticalLayout {
            padding: 12px;
            Text {
                text: Tip.reason;
                color: Tokens.text-normal;
                font-family: Tokens.font-ui; font-size: Tokens.text-body-sm;
                wrap: word-wrap;
                width: 396px;
            }
        }
    }
}
