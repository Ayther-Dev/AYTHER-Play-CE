root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,jsonc,yaml,yml}]
indent_size = 2

[*.{rs,slint,py,ps1,rc}]
indent_size = 4

[*.md]
max_line_length = 100

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab

