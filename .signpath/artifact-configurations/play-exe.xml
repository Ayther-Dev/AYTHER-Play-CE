<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference copy of the SignPath artifact configuration "play-exe" of the
  AYTHER-Play-CE project. SignPath reads the copy stored in the project; keep
  both identical.

  Input: the GitHub artifact "unsigned-play" (a ZIP holding the staged
  ayther_play_ce.exe), signed before it goes into the installer.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ayther_play_ce.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
